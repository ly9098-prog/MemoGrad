@import '../../styles/brand-shell.wxss';

/* Native glass approximation: water light stays inside one quiet focal disc. */

page {
  min-height: 100vh;
  background: #FAFCFB;
  color: #23483C;
}

/* ── Entry pending (auto redirect while a valid session exists) ── */
.entry-pending {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAFCFB;
}
.entry-pending-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx;
}
.entry-pending-brand {
  color: #23483C;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}
.entry-pending-title {
  margin-top: 28rpx;
  color: #23483C;
  font-size: 30rpx;
}
.entry-pending-desc {
  margin-top: 12rpx;
  color: #76968B;
  font-size: 24rpx;
}
.entry-pending-indicator {
  width: 36rpx;
  height: 36rpx;
  margin-top: 32rpx;
  border: 3rpx solid #D8EEE6;
  border-top-color: #3A6F5B;
  border-radius: 50%;
  animation: entry-pending-spin 900ms linear infinite;
}
@keyframes entry-pending-spin {
  to { transform: rotate(360deg); }
}

.login-root {
  min-height: 100vh;
  background: #FAFCFB;
}
.memo-nav {
  background: rgba(250, 252, 251, .94);
  border-bottom: 0;
}
.memo-brand-mark {
  background: #23483C;
  box-shadow: none;
}
.memo-brand-name { color: #23483C; }
.memo-brand-caption { color: #507568; }

/* ── Page backdrop ── */
.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: #FAFCFB;
}
.ambient-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.glow-top {
  width: 860rpx;
  height: 860rpx;
  left: -360rpx;
  top: 100rpx;
  background: radial-gradient(circle, rgba(186, 221, 204, 0) 25%, rgba(186, 221, 204, .28) 42%, rgba(186, 221, 204, .08) 56%, rgba(186, 221, 204, 0) 70%);
}
.glow-bottom {
  width: 740rpx;
  height: 740rpx;
  right: -300rpx;
  top: 440rpx;
  background: radial-gradient(circle, rgba(181, 218, 198, .17), rgba(181, 218, 198, .07) 38%, rgba(181, 218, 198, 0) 68%);
}

.login-shell {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  padding: 0 40rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

/* Page light passes behind a clear lens with slowly expanding water highlights. */
.brand-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0 56rpx;
}
.disc-scene {
  position: relative;
  width: 376rpx;
  height: 376rpx;
  flex-shrink: 0;
  margin-bottom: 80rpx;
  pointer-events: none;
}
.glass-disc {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border: 1rpx solid rgba(111, 150, 129, .25);
  border-radius: 50%;
  background: linear-gradient(138deg, rgba(255, 255, 255, .50), rgba(255, 255, 255, .04) 46%, rgba(239, 250, 244, .18) 72%, rgba(255, 255, 255, .42));
  -webkit-backdrop-filter: blur(1.5px);
  backdrop-filter: blur(1.5px);
  box-shadow:
    inset 2rpx 3rpx 2rpx rgba(255, 255, 255, .94),
    inset -2rpx -3rpx 3rpx rgba(95, 137, 115, .12),
    0 22rpx 32rpx -26rpx rgba(38, 65, 49, .22);
  display: flex;
  align-items: center;
  justify-content: center;
}
.glass-disc::before {
  content: '';
  position: absolute;
  inset: 5rpx;
  border: 1rpx solid rgba(255,255,255,.80);
  border-radius: 50%;
  pointer-events: none;
}
.glass-disc::after {
  content: '';
  position: absolute;
  inset: 12rpx;
  border-radius: 50%;
  background: linear-gradient(132deg, rgba(255,255,255,.56), rgba(255,255,255,0) 30%, rgba(255,255,255,0) 70%, rgba(255,255,255,.28));
  pointer-events: none;
}
.disc-water { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; }
.water-wave {
  position: absolute;
  left: 44%;
  top: 52%;
  width: 74%;
  height: 68%;
  border: 2rpx solid rgba(255,255,255,.80);
  border-radius: 46% 54% 51% 49%;
  box-shadow: inset 0 2rpx 3rpx rgba(107, 160, 132, .14), 0 2rpx 3rpx rgba(107, 160, 132, .10);
  opacity: 0;
  transform: translate(-50%, -50%) rotate(-18deg) scale(.60);
  animation: disc-water-ripple 9s cubic-bezier(.25, .55, .35, 1) infinite;
  animation-play-state: paused;
}
.wave-two { animation-delay: -3s; }
.wave-three { animation-delay: -6s; }
.disc-motion-active .water-wave { animation-play-state: running; }
@keyframes disc-water-ripple {
  0% { opacity: 0; transform: translate(-50%, -50%) rotate(-18deg) scale(.48); }
  20% { opacity: .72; }
  72% { opacity: .46; }
  100% { opacity: 0; transform: translate(-46%, -54%) rotate(8deg) scale(1.78); }
}
.hero-mark {
  position: relative;
  z-index: 1;
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 20rpx -12rpx rgba(34, 52, 43, .24);
}
.hero-brand-name {
  padding-left: 10rpx; /* optically recentre the trailing letter-spacing */
  color: #23483C;
  font-size: 50rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
  line-height: 1.2;
}
.hero-slogan {
  margin-top: 24rpx;
  padding-left: 4rpx;
  color: #23483C;
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 1.4;
}
.hero-subline {
  margin-top: 20rpx;
  color: #617268;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.login-panel { flex-shrink: 0; }
.wechat-login-btn {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 108rpx;
  padding: 20rpx 32rpx;
  border: none;
  border-radius: 999rpx;
  background: #253D32;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  line-height: 1.25;
  transition: transform .16s ease, opacity .16s ease;
}
.wechat-login-btn::after { border: none; }
.wechat-login-btn-pressed { transform: scale(.985); opacity: .92; }
.wechat-login-btn[disabled] { background: #253D32; opacity: .68; }
.wechat-login-title {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.25;
}
.wechat-login-subtitle {
  color: #DBE8E0;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
}

/* Consent and documents have separate, comfortably sized tap rows. */
.agreement-box {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.agreement-group { display: inline-flex; align-items: center; }
.agreement-check { position: relative; display: inline-flex; min-height: 88rpx; align-items: center; }
.agreement-native {
  position: absolute;
  left: 0;
  width: 88rpx;
  height: 88rpx;
  opacity: 0;
}
.agreement-indicator {
  box-sizing: border-box;
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border: 2rpx solid #748B7D;
  border-radius: 8rpx;
  background: #FFFFFF;
}
.agreement-indicator.is-checked { background: #305F48; border-color: #305F48; }
.agreement-indicator.is-checked::after {
  content: '';
  display: block;
  width: 12rpx;
  height: 6rpx;
  margin: 6rpx 0 0 5rpx;
  border-left: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(-45deg);
}
.agreement-text {
  color: #617268;
  font-size: 24rpx;
  line-height: 1.4;
}
.agreement-links { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; }
.agreement-link {
  display: inline-flex;
  min-height: 88rpx;
  align-items: center;
  color: #415D4D;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}
.agreement-link-pressed { opacity: .58; }

.guest-browse {
  margin-top: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #4F6156;
  font-size: 26rpx;
  transition: opacity .16s ease;
}
.guest-browse-pressed { opacity: .6; }

.dev-entry {
  margin-top: 12rpx;
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #617268;
  font-size: 20rpx;
}
.dev-entry-pressed { opacity: .6; }
.dev-arrow { color: #3A6F5B; }

.error-msg {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(254, 242, 242, .90);
  color: #B42318;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
  word-break: break-all;
}

.footer {
  margin-top: 24rpx;
  text-align: center;
}
.footer-text {
  display: block;
  color: #617268;
  font-size: 22rpx;
  line-height: 1.6;
}

@media (max-height: 720px) {
  .brand-stage { padding: 36rpx 0 40rpx; }
  .disc-scene { width: 300rpx; height: 300rpx; margin-bottom: 44rpx; }
  .hero-brand-name { font-size: 46rpx; letter-spacing: 8rpx; }
  .hero-slogan { font-size: 29rpx; }
  .hero-subline { margin-top: 12rpx; }
}
@media (prefers-reduced-motion: reduce) {
  .entry-pending-indicator { animation: none; }
  .water-wave { animation: none; opacity: .32; }
  .wave-two { transform: translate(-50%, -50%) rotate(-8deg) scale(1.05); }
  .wave-three { display: none; }
  .wechat-login-btn {
    animation: none !important;
    transition: none !important;
  }
}
@media (prefers-reduced-transparency: reduce) {
  .ambient-glow, .disc-water, .glass-disc::after { display: none; }
  .glass-disc { background: #F1F7F3; -webkit-backdrop-filter: none; backdrop-filter: none; }
}
