@import '../../styles/brand-shell.wxss';

/* User-supplied glass texture with one restrained moving light, independent of the logo. */

page {
  min-height: 100vh;
  background: #FAFCFB;
  color: #23483C;
}

/* ── Entry pending (auto redirect while a valid session exists) ── */
.entry-pending {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAFCFB;
}
.entry-pending-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx;
}
.entry-pending-brand {
  color: #23483C;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}
.entry-pending-title {
  margin-top: 28rpx;
  color: #23483C;
  font-size: 30rpx;
}
.entry-pending-desc {
  margin-top: 12rpx;
  color: #76968B;
  font-size: 24rpx;
}
.entry-pending-indicator {
  width: 36rpx;
  height: 36rpx;
  margin-top: 32rpx;
  border: 3rpx solid #D8EEE6;
  border-top-color: #3A6F5B;
  border-radius: 50%;
  animation: entry-pending-spin 900ms linear infinite;
}
@keyframes entry-pending-spin {
  to { transform: rotate(360deg); }
}

.login-root {
  min-height: 100vh;
  background: #FAFCFB;
}
.memo-nav {
  background: rgba(250, 252, 251, .94);
  border-bottom: 0;
}
.memo-brand-mark {
  background: #23483C;
  box-shadow: none;
}
.memo-brand-name { color: #23483C; }
.memo-brand-caption { color: #507568; }

/* ── Page backdrop ── */
.login-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  overflow-y: auto;
  box-sizing: border-box;
  background: #FAFCFB;
}
.ambient-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.glow-top {
  width: 860rpx;
  height: 860rpx;
  left: -360rpx;
  top: 100rpx;
  background: radial-gradient(circle, rgba(186, 221, 204, 0) 25%, rgba(186, 221, 204, .28) 42%, rgba(186, 221, 204, .08) 56%, rgba(186, 221, 204, 0) 70%);
}
.glow-bottom {
  width: 740rpx;
  height: 740rpx;
  right: -300rpx;
  top: 440rpx;
  background: radial-gradient(circle, rgba(181, 218, 198, .17), rgba(181, 218, 198, .07) 38%, rgba(181, 218, 198, 0) 68%);
}

.login-shell {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  padding: 0 40rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

/* The image carries the glass edge and refraction; page glows stay outside this scene. */
.brand-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0 56rpx;
}
.disc-scene {
  position: relative;
  width: 376rpx;
  height: 376rpx;
  flex-shrink: 0;
  margin-bottom: 80rpx;
  pointer-events: none;
}
.glass-disc {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.disc-texture {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: .72;
}
.disc-water { position: absolute; inset: 8rpx; overflow: hidden; border-radius: inherit; }
.water-wave {
  position: absolute;
  left: -35%;
  top: -20%;
  width: 80%;
  height: 140%;
  background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.72) 48%, rgba(255,255,255,0));
  opacity: .12;
  transform: translateX(0) rotate(-25deg);
  animation: disc-water-light 12s ease-in-out infinite alternate;
  animation-play-state: paused;
}
.disc-motion-active .water-wave { animation-play-state: running; }
@keyframes disc-water-light {
  0% { opacity: .12; transform: translateX(0) rotate(-25deg); }
  50% { opacity: .24; }
  100% { opacity: .12; transform: translateX(140%) rotate(-17deg); }
}
.hero-mark {
  position: relative;
  z-index: 1;
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 20rpx -12rpx rgba(34, 52, 43, .24);
}
.hero-brand-name {
  padding-left: 10rpx; /* optically recentre the trailing letter-spacing */
  color: #23483C;
  font-size: 50rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
  line-height: 1.2;
}
.hero-slogan {
  margin-top: 24rpx;
  padding-left: 4rpx;
  color: #23483C;
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 1.4;
}
.hero-subline {
  margin-top: 20rpx;
  color: #617268;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.login-panel {
  flex-shrink: 0;
  box-sizing: border-box;
}
.login-method-panel { margin-top: 0; }
.login-primary-btn {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 32rpx;
  border: none;
  border-radius: 24rpx;
  background: #305B49;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  line-height: 1.25;
  transition: transform .16s ease, opacity .16s ease;
}
.login-primary-btn::after { border: none; }
.login-primary-btn-pressed { transform: scale(.985); opacity: .92; }
.login-primary-btn[disabled] { background: #305B49; opacity: .68; }
.login-primary-title {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.25;
}
.login-method-hint {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  color: #617268;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
}

/* Keep consent on one central axis, with document links outside the check label. */
.agreement-box {
  width: 100%;
  margin: 12rpx auto 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 12px;
  line-height: 1.6;
}
.agreement-group { display: flex; }
.agreement-check {
  position: relative;
  display: flex;
  min-height: 44px;
  padding: 0 20rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.agreement-native {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  opacity: 0;
}
.agreement-indicator {
  box-sizing: border-box;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #748B7D;
  border-radius: 8rpx;
  background: #FFFFFF;
}
.agreement-indicator.is-checked { background: #305F48; border-color: #305F48; }
.agreement-indicator.is-checked::after {
  content: '';
  display: block;
  width: 12rpx;
  height: 6rpx;
  margin: 6rpx 0 0 5rpx;
  border-left: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(-45deg);
}
.agreement-text { color: #617268; }
.agreement-links {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  max-width: 100%;
  column-gap: 16rpx;
}
.agreement-link {
  display: inline-flex;
  min-height: 32px;
  align-items: center;
  color: #415D4D;
  text-decoration: underline;
  text-underline-offset: 5rpx;
  text-decoration-color: rgba(65, 93, 77, .32);
  white-space: nowrap;
}
.agreement-separator { color: #748B7D; }
.agreement-link-pressed { opacity: .58; }

.guest-browse {
  margin-top: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #4F6156;
  font-size: 26rpx;
  transition: opacity .16s ease;
}
.guest-browse-pressed { opacity: .6; }
.login-panel > .guest-browse { margin-top: 24rpx; }
.guest-hint { color: #617268; }
.guest-action { color: #305F48; font-weight: 500; }

.dev-entry {
  margin-top: 12rpx;
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #617268;
  font-size: 20rpx;
}
.dev-entry-pressed { opacity: .6; }
.dev-arrow { color: #3A6F5B; }

.error-msg {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(254, 242, 242, .90);
  color: #B42318;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
  word-break: break-all;
}

.footer {
  margin-top: 40rpx;
  text-align: center;
}
.footer-text {
  display: block;
  color: #617268;
  font-size: 22rpx;
  line-height: 1.6;
}

@media (max-height: 720px) {
  .brand-stage { padding: 28rpx 0 32rpx; }
  .disc-scene { width: 260rpx; height: 260rpx; margin-bottom: 32rpx; }
  .hero-brand-name { font-size: 46rpx; letter-spacing: 8rpx; }
  .hero-slogan { font-size: 29rpx; }
  .hero-subline { margin-top: 12rpx; }
}
@media (prefers-reduced-motion: reduce) {
  .entry-pending-indicator { animation: none; }
  .water-wave { animation: none; display: none; }
  .login-primary-btn {
    animation: none !important;
    transition: none !important;
  }
}
@media (prefers-reduced-transparency: reduce) {
  .ambient-glow, .disc-water, .disc-texture { display: none; }
  .glass-disc { background: #F1F7F3; }
}
