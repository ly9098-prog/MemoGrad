@import '../../styles/brand-shell.wxss';

/* MemoGrad login — mint glass edition.
   Palette follows the practice setup page (subpackages/study/practice):
   pine #23483C / mint #7ED8B5 / surface #F8FDFB. */

page {
  min-height: 100vh;
  background: #F8FDFB;
  color: #23483C;
}

/* ── Entry pending (auto redirect while a valid session exists) ── */
.entry-pending {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F8FDFB;
}
.entry-pending-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx;
}
.entry-pending-brand {
  color: #23483C;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}
.entry-pending-title {
  margin-top: 28rpx;
  color: #23483C;
  font-size: 30rpx;
}
.entry-pending-desc {
  margin-top: 12rpx;
  color: #76968B;
  font-size: 24rpx;
}
.entry-pending-indicator {
  width: 36rpx;
  height: 36rpx;
  margin-top: 32rpx;
  border: 3rpx solid #D8EEE6;
  border-top-color: #3A6F5B;
  border-radius: 50%;
  animation: entry-pending-spin 900ms linear infinite;
}
@keyframes entry-pending-spin {
  to { transform: rotate(360deg); }
}

/* ── Brand shell overrides: cream -> mint, lime -> mint accent ── */
.login-root {
  min-height: 100vh;
  background: #F8FDFB;
}
.memo-nav {
  background: rgba(248, 253, 251, .90);
  border-bottom-color: rgba(216, 238, 230, .80);
}
.memo-brand-mark {
  background: #23483C;
  box-shadow: 0 8rpx 20rpx rgba(35, 72, 60, .16);
}
.memo-brand-line.line-two { background: #7ED8B5; }
.memo-brand-dot {
  background: #7ED8B5;
  box-shadow: 0 0 0 6rpx rgba(126, 216, 181, .14);
}
.memo-brand-name { color: #23483C; }
.memo-brand-caption { color: #76968B; }

/* ── Page backdrop ── */
.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FBFEFD 0%, #F1FAF6 100%);
}
.ambient-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.glow-top {
  width: 720rpx;
  height: 720rpx;
  left: -260rpx;
  top: -120rpx;
  background: radial-gradient(circle, rgba(126, 216, 181, .18), rgba(126, 216, 181, 0) 68%);
}
.glow-bottom {
  width: 820rpx;
  height: 820rpx;
  right: -300rpx;
  bottom: 180rpx;
  background: radial-gradient(circle, rgba(126, 216, 181, .14), rgba(126, 216, 181, 0) 66%);
}

.login-shell {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  min-height: calc(100vh - env(safe-area-inset-bottom));
  padding: 0 48rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

/* ── Centred emblem on a frosted glass disc ── */
.brand-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 0 72rpx;
}
.glass-disc {
  position: relative;
  width: 380rpx;
  height: 380rpx;
  margin-bottom: 88rpx;
  border: 1rpx solid rgba(126, 216, 181, .42);
  border-radius: 50%;
  background:
    radial-gradient(circle at 30% 24%, rgba(255, 255, 255, .92) 0%, rgba(255, 255, 255, 0) 46%),
    radial-gradient(circle at 72% 84%, rgba(126, 216, 181, .22) 0%, rgba(126, 216, 181, 0) 58%),
    linear-gradient(155deg, rgba(255, 255, 255, .72) 0%, rgba(255, 255, 255, .30) 100%);
  box-shadow:
    0 26rpx 60rpx rgba(43, 117, 91, .10),
    inset 0 2rpx 8rpx rgba(255, 255, 255, .80),
    inset 0 -14rpx 30rpx rgba(126, 216, 181, .10);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* The mark keeps the brand-shell geometry, scaled 50rpx -> 124rpx. */
.hero-mark {
  width: 124rpx;
  height: 124rpx;
  border-radius: 32rpx;
  box-shadow: 0 14rpx 30rpx rgba(35, 72, 60, .20);
}
.hero-mark .memo-brand-line { height: 10rpx; }
.hero-mark .line-one { left: 27rpx; top: 74rpx; width: 60rpx; }
.hero-mark .line-two { left: 67rpx; top: 42rpx; width: 45rpx; }
.hero-mark .memo-brand-dot {
  width: 22rpx;
  height: 22rpx;
  right: 17rpx;
  top: 22rpx;
}
.hero-brand-name {
  padding-left: 10rpx; /* optically recentre the trailing letter-spacing */
  color: #23483C;
  font-family: Arial, sans-serif;
  font-size: 54rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
  line-height: 1.2;
}
.hero-slogan {
  margin-top: 24rpx;
  padding-left: 4rpx;
  color: #23483C;
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 1.4;
}
.hero-subline {
  margin-top: 20rpx;
  color: #76968B;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

/* ── Dual-line primary action ── */
.login-panel { flex-shrink: 0; }
.wechat-login-btn {
  width: 100%;
  height: 132rpx;
  padding: 0 24rpx;
  border: none;
  border-radius: 28rpx;
  background: #23483C;
  box-shadow: 0 12rpx 28rpx rgba(35, 72, 60, .16);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  line-height: 1.25;
  transition: transform .16s ease, opacity .16s ease;
}
.wechat-login-btn::after { border: none; }
.wechat-login-btn-pressed { transform: scale(.985); opacity: .92; }
.wechat-login-btn[disabled] { opacity: .62; }
.wechat-login-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.25;
}
.wechat-login-sub {
  color: rgba(255, 255, 255, .60);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.25;
}

/* ── Consent row: one quiet centred line, links stay independent taps ── */
.agreement-box {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  row-gap: 8rpx;
}
.agreement-group { display: inline-flex; align-items: center; }
.agreement-check { display: inline-flex; align-items: center; }
.agreement-check checkbox {
  transform: scale(.72);
  transform-origin: center;
}
.agreement-text {
  color: #76968B;
  font-size: 22rpx;
  line-height: 1.4;
}
.agreement-link {
  color: #23483C;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
  text-decoration: underline;
  text-decoration-color: rgba(35, 72, 60, .30);
  text-underline-offset: 4rpx;
}
.agreement-link-pressed { opacity: .58; }

.guest-browse {
  margin-top: 24rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #507568;
  font-size: 26rpx;
  transition: opacity .16s ease;
}
.guest-browse-pressed { opacity: .6; }

.dev-entry {
  margin-top: 12rpx;
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #8AA399;
  font-size: 20rpx;
}
.dev-entry-pressed { opacity: .6; }
.dev-arrow { color: #3A6F5B; }

.error-msg {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(254, 242, 242, .90);
  color: #B42318;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
  word-break: break-all;
}

.footer {
  margin-top: 28rpx;
  text-align: center;
}
.footer-text {
  display: block;
  color: #9AB3A8;
  font-size: 20rpx;
  line-height: 1.6;
}

@media (prefers-reduced-motion: reduce) {
  .entry-pending-indicator { animation: none; }
}
