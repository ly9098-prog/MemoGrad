<view wx:if="{{entryPending}}" class="entry-pending">
  <view class="entry-pending-content route-enter" role="status" aria-live="polite">
    <text class="entry-pending-brand">MemoGrad</text>
    <text class="entry-pending-title">正在打开学习空间</text>
    <text class="entry-pending-desc">同步你的学习进度</text>
    <view class="entry-pending-indicator" aria-hidden="true"></view>
    <view class="guest-browse" bindtap="onGuestBrowse" aria-role="button">暂不登录，先浏览体验</view>
  </view>
</view>
<view wx:else class="login-root {{discMotionActive && !loading ? 'disc-motion-active' : ''}}">
  <view class="memo-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="memo-nav-inner" style="height: {{navContentHeight}}px; padding-right: {{navRightPadding}}px;">
      <view class="memo-brand-lockup">
        <image class="memo-brand-mark" src="/assets/icons/memograd-mark.svg" mode="aspectFit" aria-hidden="true" />
        <view class="memo-brand-copy">
          <text class="memo-brand-name">MEMOGRAD</text>
          <text class="memo-brand-caption">STUDY DESK</text>
        </view>
      </view>
    </view>
  </view>
  <view class="login-page" style="padding-top: {{navHeight}}px;">
    <view class="ambient-glow glow-top" aria-hidden="true"></view>
    <view class="ambient-glow glow-bottom" aria-hidden="true"></view>
    <view class="login-shell" style="min-height: calc(100vh - {{navHeight}}px);">
      <view class="brand-stage route-enter-page">
        <view class="disc-scene" aria-hidden="true">
          <view class="glass-disc">
            <image class="disc-texture" src="/assets/images/login/disc-glass-clean.png" mode="aspectFit" aria-hidden="true" />
            <view class="disc-water">
              <view class="water-wave wave-one"></view>
            </view>
            <image class="memo-brand-mark hero-mark" src="/assets/icons/memograd-mark.svg" mode="aspectFit" />
          </view>
        </view>
        <text class="hero-brand-name">MEMOGRAD</text>
        <text class="hero-slogan">今天，从一道题开始</text>
        <text class="hero-subline">408 刷题 · 错题复盘</text>
      </view>
      <view class="login-panel route-enter-page delay-one">
        <button class="wechat-login-btn" hover-class="{{loading ? 'none' : 'wechat-login-btn-pressed'}}" hover-start-time="20" hover-stay-time="80" bindtap="onWechatLogin" loading="{{loading}}" disabled="{{loading}}" aria-busy="{{loading}}">
          <text class="wechat-login-title">{{loading ? '正在登录…' : '微信一键登录'}}</text>
        </button>
        <text class="wechat-login-subtitle">同步错题、复习计划与打卡</text>
        <view wx:if="{{error}}" class="error-msg" aria-role="alert">{{error}}</view>
        <view class="agreement-box">
          <checkbox-group class="agreement-group" bindchange="onAgreementChange">
            <label class="agreement-check">
              <checkbox id="login-agreement" class="agreement-native" value="agreed" checked="{{agreed}}" disabled="{{loading}}" color="#3A6F5B" aria-label="我已阅读并同意用户协议、隐私政策与AI免责声明" />
              <view class="agreement-indicator {{agreed ? 'is-checked' : ''}}" aria-hidden="true"></view>
              <text class="agreement-text">我已阅读并同意</text>
            </label>
          </checkbox-group>
          <view class="agreement-links">
            <text class="agreement-link" data-type="user" hover-class="agreement-link-pressed" hover-start-time="20" hover-stay-time="80" bindtap="openAgreement" aria-role="link">用户协议</text>
            <text class="agreement-separator" aria-hidden="true">·</text>
            <text class="agreement-link" data-type="privacy" hover-class="agreement-link-pressed" hover-start-time="20" hover-stay-time="80" bindtap="openAgreement" aria-role="link">隐私政策</text>
            <text class="agreement-separator" aria-hidden="true">·</text>
            <text class="agreement-link" data-type="ai" hover-class="agreement-link-pressed" hover-start-time="20" hover-stay-time="80" bindtap="openAgreement" aria-role="link">AI 免责声明</text>
          </view>
        </view>
        <view class="guest-browse" bindtap="onGuestBrowse" hover-class="guest-browse-pressed" aria-role="button" aria-label="暂不登录，先浏览体验">
          <text class="guest-hint">暂不登录，</text>
          <text class="guest-action">先浏览体验</text>
        </view>
        <view wx:if="{{showDevLogin}}" class="dev-entry" hover-class="dev-entry-pressed" hover-start-time="20" hover-stay-time="80" bindtap="onDevLogin">
          <text class="dev-text">开发者模式</text>
          <text class="dev-arrow">→</text>
        </view>
      </view>
      <view class="footer route-enter-page delay-two">
        <text class="footer-text">桂ICP备2026003057号-2X</text>
      </view>
    </view>
  </view>
</view>
