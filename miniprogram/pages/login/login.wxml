<view wx:if="{{entryPending}}" class="entry-pending">
  <view class="entry-pending-content route-enter" role="status" aria-live="polite">
    <text class="entry-pending-brand">MemoGrad</text>
    <text class="entry-pending-title">正在打开学习空间</text>
    <text class="entry-pending-desc">同步你的学习进度</text>
    <view class="entry-pending-indicator" aria-hidden="true"></view>
    <view class="guest-browse" bindtap="onGuestBrowse" aria-role="button">暂不登录，先浏览体验</view>
  </view>
</view>
<view wx:else class="login-root {{discMotionActive && !loading ? 'disc-motion-active' : ''}}">
  <view class="memo-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="memo-nav-inner" style="height: {{navContentHeight}}px; padding-right: {{navRightPadding}}px;">
      <view class="memo-brand-lockup">
        <image class="memo-brand-mark" src="/assets/icons/memograd-mark.svg" mode="aspectFit" aria-hidden="true" />
        <view class="memo-brand-copy">
          <text class="memo-brand-name">MEMOGRAD</text>
          <text class="memo-brand-caption">STUDY DESK</text>
        </view>
      </view>
    </view>
  </view>
  <view class="login-page" style="padding-top: {{navHeight}}px;">
    <view class="ambient-glow glow-top" aria-hidden="true"></view>
    <view class="ambient-glow glow-bottom" aria-hidden="true"></view>
    <view class="login-shell" style="min-height: calc(100vh - {{navHeight}}px);">
      <view class="brand-stage route-enter-page">
        <view class="disc-scene" aria-hidden="true">
          <view class="glass-disc">
            <image class="disc-texture" src="/assets/images/login/disc-glass-clean.png" mode="aspectFit" aria-hidden="true" />
            <view class="disc-water">
              <view class="water-wave wave-one"></view>
            </view>
            <image class="memo-brand-mark hero-mark" src="/assets/icons/memograd-mark.svg" mode="aspectFit" />
          </view>
        </view>
        <text class="hero-brand-name">MEMOGRAD</text>
        <text class="hero-slogan">{{accountMode ? '账号与登录' : '今天，从一道题开始'}}</text>
        <text class="hero-subline">{{accountMode ? '绑定到当前账号，保留所有学习记录' : '408 刷题 · 错题复盘'}}</text>
      </view>
      <view class="login-panel route-enter-page delay-one">
        <view class="login-method-tabs" aria-role="tablist" aria-label="选择登录方式">
          <button class="login-method-tab {{loginMethod === 'wechat' ? 'is-active' : ''}}" data-method="wechat" bindtap="onLoginMethodChange" disabled="{{loading || emailCaptchaVisible}}" aria-role="tab" aria-selected="{{loginMethod === 'wechat'}}">微信</button>
          <button class="login-method-tab {{loginMethod === 'email' ? 'is-active' : ''}}" data-method="email" bindtap="onLoginMethodChange" disabled="{{loading || emailCaptchaVisible}}" aria-role="tab" aria-selected="{{loginMethod === 'email'}}">邮箱</button>
        </view>

        <view wx:if="{{loginMethod === 'wechat'}}" class="login-method-panel">
          <button class="login-primary-btn" hover-class="{{loading ? 'none' : 'login-primary-btn-pressed'}}" hover-start-time="20" hover-stay-time="80" bindtap="onWechatLogin" loading="{{loading}}" disabled="{{loading || (accountMode && accountHasWechat)}}" aria-busy="{{loading}}">
            <text class="login-primary-title">{{loading ? '正在处理…' : (accountMode ? (accountHasWechat ? '微信已绑定' : '授权并绑定微信') : '微信一键登录')}}</text>
          </button>
          <text class="login-method-hint">{{accountMode ? '微信已属于其他账号时会拒绝绑定，不合并账号' : '登录后同步错题、复习计划与打卡'}}</text>
        </view>

        <view wx:else class="login-method-panel email-login-form">
          <view class="email-form-heading">
            <text class="email-form-title">{{accountMode ? (accountEmail ? '邮箱已绑定' : '绑定邮箱') : '邮箱验证码登录'}}</text>
            <text class="email-form-desc">{{accountMode ? (accountEmail || '验证邮箱后，可用同一账号登录网页') : '已有账号直接登录，首次验证会自动创建账号'}}</text>
          </view>
          <view wx:if="{{!accountMode || !accountEmail}}" class="login-field-row">
            <text class="login-field-label">邮箱</text>
            <view class="login-field {{focusedField === 'email' ? 'is-focused' : ''}}">
              <input class="login-field-input" type="text" value="{{email}}" placeholder="name@example.com" placeholder-class="login-input-placeholder" maxlength="254" disabled="{{loading || emailCaptchaVisible}}" bindinput="onEmailInput" bindfocus="onLoginFieldFocus" bindblur="onLoginFieldBlur" data-field="email" confirm-type="next" cursor-spacing="24" aria-label="邮箱地址" />
            </view>
          </view>
          <view wx:if="{{emailChallengeId}}" class="login-field-row email-code-row">
            <view class="email-code-heading">
              <text class="login-field-label">验证码</text>
              <text class="email-code-sent">已发送至 {{emailCodeSentTo}}</text>
            </view>
            <view class="login-field {{focusedField === 'code' ? 'is-focused' : ''}}">
              <input class="login-field-input login-code-input" type="number" value="{{emailCode}}" placeholder="6 位数字" placeholder-class="login-input-placeholder" maxlength="6" disabled="{{loading}}" bindinput="onEmailCodeInput" bindfocus="onLoginFieldFocus" bindblur="onLoginFieldBlur" data-field="code" confirm-type="done" cursor-spacing="24" aria-label="邮箱验证码" />
            </view>
          </view>
          <slider-captcha wx:if="{{emailCaptchaVisible && !accountMode}}" bindverified="onEmailCaptchaVerified" bindcancel="onEmailCaptchaCancel" />
          <button wx:if="{{(!accountMode || !accountEmail) && !emailCaptchaVisible}}" class="login-primary-btn email-login-btn" hover-class="{{loading ? 'none' : 'login-primary-btn-pressed'}}" hover-start-time="20" hover-stay-time="80" bindtap="onEmailSubmit" loading="{{loading}}" disabled="{{loading}}" aria-busy="{{loading}}">
            <text class="login-primary-title">{{loading ? '正在处理…' : (emailChallengeId ? (accountMode ? '验证并绑定' : '验证并登录') : '获取验证码')}}</text>
          </button>
          <view wx:if="{{emailChallengeId}}" class="email-resend-row">
            <text class="email-resend-copy">没有收到邮件？</text>
            <text class="email-resend-action {{emailResendRemaining > 0 ? 'is-disabled' : ''}}" bindtap="onEmailResend" aria-role="button" aria-label="{{emailResendLabel}}">{{emailResendLabel}}</text>
          </view>
        </view>
        <view wx:if="{{error}}" class="error-msg" aria-role="alert">{{error}}</view>
        <view wx:if="{{!accountMode}}" class="agreement-box">
          <checkbox-group class="agreement-group" bindchange="onAgreementChange">
            <label class="agreement-check">
              <checkbox id="login-agreement" class="agreement-native" value="agreed" checked="{{agreed}}" disabled="{{loading || emailCaptchaVisible}}" color="#3A6F5B" aria-label="我已阅读并同意用户协议、隐私政策与AI免责声明" />
              <view class="agreement-indicator {{agreed ? 'is-checked' : ''}}" aria-hidden="true"></view>
              <text class="agreement-text">我已阅读并同意</text>
            </label>
          </checkbox-group>
          <view class="agreement-links">
            <text class="agreement-link" data-type="user" hover-class="agreement-link-pressed" hover-start-time="20" hover-stay-time="80" bindtap="openAgreement" aria-role="link">用户协议</text>
            <text class="agreement-separator" aria-hidden="true">·</text>
            <text class="agreement-link" data-type="privacy" hover-class="agreement-link-pressed" hover-start-time="20" hover-stay-time="80" bindtap="openAgreement" aria-role="link">隐私政策</text>
            <text class="agreement-separator" aria-hidden="true">·</text>
            <text class="agreement-link" data-type="ai" hover-class="agreement-link-pressed" hover-start-time="20" hover-stay-time="80" bindtap="openAgreement" aria-role="link">AI 免责声明</text>
          </view>
        </view>
        <view class="guest-browse" bindtap="onGuestBrowse" hover-class="guest-browse-pressed" aria-role="button" aria-label="{{accountMode ? '返回首页' : '暂不登录，先浏览体验'}}">
          <text wx:if="{{!accountMode}}" class="guest-hint">暂不登录，</text>
          <text class="guest-action">{{accountMode ? '返回首页' : '先浏览体验'}}</text>
        </view>
        <view wx:if="{{showDevLogin}}" class="dev-entry" hover-class="dev-entry-pressed" hover-start-time="20" hover-stay-time="80" bindtap="onDevLogin">
          <text class="dev-text">开发者模式</text>
          <text class="dev-arrow">→</text>
        </view>
      </view>
      <view class="footer route-enter-page delay-two">
        <text class="footer-text">桂ICP备2026003057号-2X</text>
      </view>
    </view>
  </view>
</view>
