.route-index, .route-wrong .route-index, .route-exam .route-index, .hub-task-index { border: 0; border-radius: 50%; background: #E7F1EA; box-shadow: none; }
.route-arrow { border-color: #8DAE9B; background: transparent; color: #3A6F5B; }
.route-title, .wrongbook-tool-card .route-title { color: #23483C; font-size: 28rpx; font-weight: 600; }
.route-desc, .wrongbook-tool-card .route-desc { color: #507568; font-size: 24rpx; line-height: 1.6; }
.card-pressed { background: #EAF9F4; }
.mastery-card-tech { min-height: 0; padding: 24rpx; border: 1rpx solid #DFE8E2; border-radius: 24rpx; background: #FFFFFF; box-shadow: none; }
.mastery-basis { display: block; margin-top: 8rpx; color: #637B6B; font-size: 22rpx; font-weight: 400; line-height: 1.5; }
.mastery-card-tech::before, .mastery-card-tech::after, .mastery-icon::before { display: none; }
.mastery-card-tech .mastery-card-head { align-items: center; justify-content: flex-start; gap: 12rpx; min-height: 64rpx; }
.mastery-card-tech .mastery-icon { width: 44rpx; height: 44rpx; flex: 0 0 44rpx; border: 0; border-radius: 50%; background: #E7F1EA; box-shadow: none; }
.mastery-card-tech .mastery-icon-image { width: 40rpx; height: 40rpx; }
.mastery-card-tech .mastery-title-row { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; gap: 8rpx; margin-top: 16rpx; }
.mastery-card-tech .mastery-subject { flex: 1; color: #23483C; font-size: 25rpx; font-weight: 600; letter-spacing: 0; line-height: 1.4; white-space: normal; }
.mastery-card-tech .mastery-score { display: flex; align-items: center; min-height: 52rpx; color: #23483C; font-size: 44rpx; line-height: 1.2; font-weight: 600; font-variant-numeric: tabular-nums; }
.mastery-title-row .mastery-status { color: #4F6C5C; font-size: 22rpx; font-weight: 400; white-space: nowrap; }
.mastery-card-tech.no-data .mastery-score, .mastery-card-tech .mastery-score.is-empty { color: #637F72; font-size: 36rpx; }
.mastery-card-tech .mastery-track-tech { height: auto; margin-top: 12rpx; padding: 0; background: transparent; transform: none; }
.mastery-mint-rail { height: 8rpx; overflow: hidden; border-radius: 999rpx; background: #E3EDE7; }
.mastery-mint-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #96D9B2, #55BB95); }
.mastery-foot-tech { flex-direction: row; align-items: center; gap: 8rpx; margin-top: 0; padding-top: 16rpx; }
.mastery-foot-tech { color: #4F6C5C; font-size: 24rpx; font-weight: 400; line-height: 1.4; }
.mastery-sample-copy { color: #617268; font-size: 24rpx; font-weight: 400; line-height: 1.4; }
.mastery-card-pressed { background: #F0FAF6; }
.tool-panel { border: 1rpx solid #E4ECE7; border-radius: 30rpx; background: #FFFFFF; box-shadow: none; }
.tool-divider { background: #DFEAE3; }
.tool-pressed { background: #EAF9F4; }
.tool-icon { border: 0; background: #E7F1EA; color: #315D49; }
.tool-title { font-size: 26rpx; font-weight: 600; }
.tool-desc { margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; }
.chart-icon .bar, .chart-icon .bar-b, .chart-icon .bar-c, .clock-hand { background: #3A8061; }
.clock-icon::before { border-color: #315D49; }
.growth-note { margin: 32rpx 24rpx 0; padding: 28rpx 30rpx 32rpx; border: 1rpx solid #DFE8E2; border-radius: 24rpx; background: #F3F8F5; }
.growth-note-copy { display: block; min-width: 0; }
.growth-note-heading { display: flex; align-items: center; gap: 12rpx; }
.growth-note-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.growth-note-label { padding: 0; background: transparent; color: #507568; font-size: 24rpx; font-weight: 500; letter-spacing: 0; }
.growth-note-text { min-width: 0; margin-top: 16rpx; color: #23483C; font-size: 28rpx; line-height: 1.8; }
@media (max-width: 350px) {
  .focus-content, .focus-content-guest { padding: 26rpx 24rpx; }
  .focus-body { gap: 16rpx; margin-top: 20rpx; }
  .focus-title { font-size: 32rpx; }
  .focus-ring-wrap { flex-basis: 180rpx; width: 180rpx; height: 180rpx; }
  .focus-ring-value { font-size: 36rpx; }
  .focus-ring-goal { font-size: 24rpx; }
  .focus-ring-label { font-size: 22rpx; }
}

/* Digits wait for data commit, page readiness and viewport visibility. */
.reveal-digit { animation-play-state: paused; }
.number-reveal-playing .reveal-digit { animation-play-state: running; }

/* Daily target remains a visible, in-place control beside the home heading. */
.focus-goal-entry { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; min-height: 44px; color: #315D49; font-size: 24rpx; }
.focus-goal-entry .home-chevron { transform: rotate(135deg); }
.focus-goal-options { display: flex; gap: 12rpx; margin: 8rpx 0 24rpx; }
.focus-goal-option { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 44px; border: 1rpx solid #D8E7DE; border-radius: 16rpx; background: #FFFFFF; color: #315D49; font-size: 24rpx; }
.focus-goal-option.is-selected { border-color: #315D49; background: #E1F1E8; font-weight: 600; }

.account-security-entry { display: flex; align-items: center; justify-content: center; min-height: 44px; margin: 24rpx; border: 1rpx solid #D8E7DE; border-radius: 16rpx; background: #FFFFFF; color: #315D49; font-size: 26rpx; font-weight: 500; }
.account-security-entry::after { border: 0; }
