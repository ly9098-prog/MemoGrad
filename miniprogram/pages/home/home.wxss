@import '../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #F4F4EE;
  background-color: #F4F4EE;
  color: #15231A;
}

.home-page {
  min-height: 100vh;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 100% 0%, rgba(183, 232, 42, .08), transparent 360rpx),
    linear-gradient(180deg, #F6F6F0 0%, #F1F2EC 100%);
}

/* Navigation */
.home-nav {
  width: 100%;
  box-sizing: border-box;
}

.home-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding-left: 28rpx;
}

.brand-lockup {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-mark {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 17rpx;
  background: #153323;
  box-shadow: 0 10rpx 24rpx rgba(21, 51, 35, .16);
}

.brand-copy {
  min-width: 0;
  margin-left: 15rpx;
}

.brand-name,
.brand-caption {
  display: block;
  white-space: nowrap;
}

.brand-name {
  font-size: 25rpx;
  line-height: 1.05;
  font-weight: 950;
  letter-spacing: 1.4rpx;
  color: #142219;
}

.brand-caption {
  margin-top: 5rpx;
  font-size: 14rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #849087;
}

.profile-entry {
  position: relative;
  display: inline-flex;
  align-items: center;
  flex-grow: 0;
  flex-shrink: 0;
}

.profile-entry-guide .profile-chip::before {
  animation: loginGuideEntryPulse 5000ms linear 2;
}

.login-guide {
  position: absolute;
  top: calc(100% + 8px);
  z-index: 5;
  box-sizing: border-box;
  width: 216px;
  max-width: calc(100vw - 32px);
  padding: 10px 14px 6px;
  border: 1px solid #CFE5D1;
  border-radius: 12px;
  background: #F1FAF3;
  background-color: #F1FAF3;
  color: #244C31;
  opacity: 1;
  box-shadow: 0 6px 18px rgba(44, 91, 54, .10);
  animation: loginGuideReveal 180ms cubic-bezier(.16, 1, .3, 1);
}

.login-guide-pending {
  visibility: hidden;
  pointer-events: none;
  animation: none;
}

.login-guide-pending .login-guide-content {
  animation: none;
}

.login-guide-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
  animation: loginGuideContentReveal 180ms ease-out;
}

.login-guide-arrow {
  position: absolute;
  top: -5px;
  width: 8px;
  height: 8px;
  border-top: 1px solid #CFE5D1;
  border-left: 1px solid #CFE5D1;
  background: #F1FAF3;
  transform: translateX(-50%) rotate(45deg);
}

.login-guide:not(.login-guide-pending) .login-guide-arrow {
  animation: loginGuideArrowNudge 2800ms 300ms linear 2 both;
}

.login-guide-title {
  padding-right: 24px;
  font-size: 13px;
  font-weight: 600;
  line-height: 20px;
  overflow-wrap: anywhere;
}

.login-guide-close {
  position: absolute;
  top: 8px;
  right: 4px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0 2px 0 0 !important;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #6A8772;
}

.login-guide-close .line-icon {
  width: 20px;
  height: 20px;
}

.login-guide-close .line-icon::before,
.login-guide-close .line-icon::after {
  left: 3px;
  top: 9px;
  width: 14px;
  height: 2px;
}

.login-guide-action {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 6px;
  width: auto;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 8px;
  background: transparent;
  box-shadow: none;
  color: #28763B;
  font-size: 12px;
  line-height: 20px;
  font-weight: 600;
}

.login-guide-action-label {
  display: block;
}

.login-guide-action-arrow {
  width: 5px;
  height: 5px;
  border-top: 1px solid currentColor;
  border-right: 1px solid currentColor;
  transform: rotate(45deg);
}

.login-guide-control-pressed {
  opacity: .72;
}

.login-guide-close:focus-visible,
.login-guide-action:focus-visible {
  outline: 2px solid #28763B;
  outline-offset: 2px;
}

@keyframes loginGuideReveal {
  from { transform: translateY(4px); }
  to { transform: translateY(0); }
}

@keyframes loginGuideContentReveal {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes loginGuideArrowNudge {
  0%, 65%, 100% { transform: translateX(-50%) translateY(0) rotate(45deg); }
  30%, 45% { transform: translateX(-50%) translateY(4px) rotate(45deg); }
}

@keyframes loginGuideEntryPulse {
  0%, 100% {
    border-color: #D8EEE6;
    background-color: #FFFFFF;
  }
  30%, 55% {
    border-color: #79B285;
    background-color: #EAF7EF;
  }
}

.profile-chip {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 6rpx 12rpx 6rpx 7rpx;
  border: 1rpx solid #DDE2DA;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .58);
}

.profile-avatar {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #E2EDC7;
  color: #173426;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 950;
}

.profile-avatar-image {
  display: block;
  overflow: hidden;
}

.profile-chip-pressed {
  opacity: .76;
  transform: scale(.97);
}

.profile-level {
  max-width: 116rpx;
  margin-left: 9rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #455249;
  font-size: 19rpx;
  font-weight: 850;
}

/* Header */
.editorial-head {
  padding: 28rpx 28rpx 26rpx;
}

.editorial-date,
.route-eyebrow,
.growth-note-label {
  display: block;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 2.6rpx;
}

.editorial-date {
  color: #7A867D;
}

.editorial-title-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
}

.editorial-title {
  flex-shrink: 0;
  max-width: 590rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #132118;
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 950;
  letter-spacing: -1.2rpx;
}

.editorial-rule {
  flex: 1;
  height: 2rpx;
  min-width: 20rpx;
  background: #D5DAD2;
}

.editorial-subtitle {
  display: block;
  margin-top: 13rpx;
  color: #68756C;
  font-size: 26rpx;
  line-height: 1.5;
}

/* Main task */
.focus-card {
  position: relative;
  overflow: hidden;
  margin: 0 24rpx;
  border-radius: 36rpx;
  color: #FFFFFF;
  background: linear-gradient(145deg, #183528 0%, #10251A 56%, #09170F 100%);
  box-shadow: 0 28rpx 68rpx rgba(16, 37, 26, .23);
}

.focus-content {
  position: relative;
  z-index: 2;
  padding: 30rpx 28rpx 0;
}

.focus-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.focus-status {
  display: flex;
  align-items: center;
  min-width: 0;
  color: #B7E82A;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.focus-status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 13rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #B7E82A;
  box-shadow: 0 0 0 8rpx rgba(183, 232, 42, .12);
}

.soft-pressed { opacity: .72; }

.focus-title,
.focus-desc {
  display: block;
  position: relative;
  max-width: 520rpx;
}

.focus-title {
  margin-top: 36rpx;
  color: #FFFFFF;
  font-size: 47rpx;
  line-height: 1.18;
  font-weight: 950;
  letter-spacing: -1rpx;
}

.focus-desc {
  margin-top: 16rpx;
  color: rgba(239, 245, 240, .68);
  font-size: 24rpx;
  line-height: 1.65;
}

.focus-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
}

.primary-action {
  flex: 1;
  min-height: 88rpx;
  padding: 0 16rpx 0 24rpx;
  border-radius: 24rpx;
  background: #B7E82A;
  color: #10251A;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  font-weight: 950;
  box-shadow: 0 14rpx 30rpx rgba(104, 140, 0, .18);
  transition: transform .16s ease, opacity .16s ease;
}

.primary-action-arrow {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #10251A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
  font-size: 29rpx;
  font-weight: 700;
}

.secondary-action {
  flex-shrink: 0;
  min-height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, .13);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .055);
  color: rgba(255, 255, 255, .78);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 850;
  transition: transform .16s ease, opacity .16s ease;
}

.primary-action-pressed,
.secondary-action-pressed {
  transform: scale(.98);
  opacity: .82;
}

.focus-metrics {
  display: flex;
  align-items: stretch;
  margin: 30rpx -28rpx 0;
  padding: 22rpx 28rpx 25rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .08);
  background: rgba(255, 255, 255, .035);
}

.metric-item {
  flex: 1;
  min-width: 0;
}

.metric-item.metric-level { flex: 1.35; }

.metric-value,
.metric-label {
  display: block;
}

.metric-value {
  color: #FFFFFF;
  font-size: 35rpx;
  line-height: 1.1;
  font-weight: 950;
  font-variant-numeric: tabular-nums;
}

.reveal-metric {
  display: inline-flex;
  align-items: baseline;
  overflow: hidden;
  line-height: 1.1;
}

.reveal-digit {
  display: inline-block;
  line-height: 1;
  will-change: transform, opacity;
}

.reveal-digit-top {
  animation: numberRevealTop 380ms cubic-bezier(.22, 1, .36, 1) both;
}

.reveal-digit-bottom {
  animation: numberRevealBottom 380ms cubic-bezier(.22, 1, .36, 1) both;
}

@keyframes numberRevealTop {
  0% { opacity: 0; transform: translate3d(0, -.38em, 0) scale(.97); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

@keyframes numberRevealBottom {
  0% { opacity: 0; transform: translate3d(0, .38em, 0) scale(.97); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

.metric-value.level-value {
  max-width: 190rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  line-height: 1.35;
}

.metric-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, .43);
  font-size: 18rpx;
  font-weight: 750;
}

.metric-divider {
  width: 1rpx;
  margin: 0 22rpx;
  background: rgba(255, 255, 255, .09);
}

/* Sections */
.content-section {
  margin-top: 50rpx;
  padding: 0 24rpx;
}

.tool-section { margin-top: 46rpx; }

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 0 4rpx 18rpx;
}

.compact-heading { margin-bottom: 16rpx; }

.section-title {
  display: block;
  margin-top: 6rpx;
  color: #132118;
  font-size: 35rpx;
  line-height: 1.25;
  font-weight: 950;
  letter-spacing: -.5rpx;
}

.section-note {
  padding-bottom: 4rpx;
  color: #858F88;
  font-size: 21rpx;
}

.section-quick-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 48rpx;
  padding: 0 4rpx 0 12rpx;
  border-radius: 999rpx;
  color: #46604E;
  font-size: 20rpx;
  font-weight: 800;
  transition: opacity .16s ease, transform .16s ease, background-color .16s ease;
}

.section-quick-action-pressed {
  opacity: .7;
  transform: scale(.98);
  background: rgba(224, 232, 221, .62);
}

.section-quick-icon {
  width: 26rpx;
  height: 26rpx;
}

.section-quick-arrow {
  margin-left: -2rpx;
  color: #7C8A80;
  font-size: 28rpx;
  line-height: 1;
}

.route-stack {
  overflow: hidden;
  border: 1rpx solid #DFE3DC;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, .68);
  box-shadow: 0 14rpx 38rpx rgba(23, 52, 38, .055);
}

.route-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 154rpx;
  padding: 22rpx 22rpx;
  transition: opacity .16s ease, transform .16s ease, background-color .16s ease;
}

.route-card + .route-card {
  border-top: 1rpx solid #E4E7E1;
}

.route-review { background: linear-gradient(90deg, rgba(231, 235, 221, .68), rgba(255, 255, 255, 0) 66%); }
.route-wrong { background: linear-gradient(90deg, rgba(246, 239, 227, .54), rgba(255, 255, 255, 0) 66%); }
.route-exam { background: linear-gradient(90deg, rgba(227, 236, 238, .58), rgba(255, 255, 255, 0) 66%); }

.card-pressed {
  opacity: .72;
  transform: scale(.994);
  background-color: #ECEFE8;
}

.route-index {
  width: 66rpx;
  height: 66rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: #173426;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-icon-image {
  width: 34rpx;
  height: 34rpx;
}

.route-wrong .route-index {
  background: #F0E1D5;
  color: #A45D34;
}

.route-exam .route-index {
  background: #DCEAEC;
  color: #2C6370;
}

.route-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.route-eyebrow {
  color: #7A867D;
  font-size: 16rpx;
  letter-spacing: 2.2rpx;
}

.route-title,
.route-desc {
  display: block;
}

.route-title {
  margin-top: 6rpx;
  color: #17251B;
  font-size: 29rpx;
  line-height: 1.3;
  font-weight: 950;
}

.route-desc {
  margin-top: 6rpx;
  max-width: 500rpx;
  color: #7A857D;
  font-size: 21rpx;
  line-height: 1.45;
}

.route-arrow {
  align-self: center;
  width: 54rpx;
  height: 54rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid #D6DBD3;
  color: #39483E;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
  font-size: 29rpx;
}

/* Tool dock */
.tool-panel {
  display: flex;
  align-items: stretch;
  padding: 10rpx;
  border: 1rpx solid #DFE3DC;
  border-radius: 30rpx;
  background: #FBFBF7;
  box-shadow: 0 14rpx 38rpx rgba(23, 52, 38, .05);
}

.tool-item {
  flex: 1;
  min-width: 0;
  padding: 20rpx 8rpx 18rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: background-color .16s ease, transform .16s ease;
}

.tool-pressed {
  background: #EDF0EA;
  transform: scale(.98);
}

.tool-divider {
  width: 1rpx;
  margin: 20rpx 0;
  background: #E3E6E0;
}

.tool-icon {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background: #E8ECDf;
  color: #173426;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chart-icon { align-items: flex-end; gap: 5rpx; padding-bottom: 14rpx; }
.chart-icon .bar { width: 7rpx; border-radius: 99rpx; background: #173426; }
.chart-icon .bar-a { height: 15rpx; }
.chart-icon .bar-b { height: 27rpx; background: #7FA300; }
.chart-icon .bar-c { height: 38rpx; background: #B7E82A; }

.clock-icon::before {
  content: '';
  width: 31rpx;
  height: 31rpx;
  border: 4rpx solid #173426;
  border-radius: 50%;
}

.clock-hand {
  position: absolute;
  left: 30rpx;
  top: 18rpx;
  width: 4rpx;
  height: 15rpx;
  border-radius: 99rpx;
  background: #7FA300;
  transform-origin: bottom center;
  transform: rotate(-35deg);
}

.formula-icon {
  font-family: Georgia, serif;
  font-size: 37rpx;
  font-weight: 700;
}

.tool-title,
.tool-desc {
  display: block;
}

.tool-title {
  margin-top: 14rpx;
  color: #1C2A20;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.3;
}

.tool-desc {
  margin-top: 5rpx;
  color: #8A938C;
  font-size: 17rpx;
  line-height: 1.35;
}

/* Closing note */
.growth-note {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin: 34rpx 28rpx 0;
  padding: 24rpx 0;
  border-top: 1rpx solid #DDE1DA;
}

.growth-note-copy { min-width: 0; }
.growth-note-label { color: #7B867E; font-size: 16rpx; }
.growth-note-text {
  display: block;
  margin-top: 8rpx;
  color: #4E5C52;
  font-size: 22rpx;
  line-height: 1.55;
}

.safe-bottom {
  height: calc(38rpx + env(safe-area-inset-bottom));
}

.delay-one { animation-delay: .05s; }
.delay-two { animation-delay: .10s; }
.delay-three { animation-delay: .15s; }

@media (prefers-reduced-motion: reduce) {
  .login-guide,
  .login-guide-content,
  .route-card,
  .tool-item,
  .primary-action,
  .secondary-action,
  .reveal-digit {
    animation: none !important;
    transition: none;
    opacity: 1 !important;
    transform: none !important;
  }

  .login-guide-arrow,
  .profile-entry-guide .profile-chip::before {
    animation: none !important;
  }
}

/* Profile editor v11: minimal two-column UI using direct native WeChat controls.
   Keep the native chooseAvatar button and nickname input stable while the host UI is open. */
.profile-sheet-mask {
  position: fixed;
  z-index: 999;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  padding: 0;
  background: rgba(8, 18, 12, .42);
  animation: profile-v11-mask-in .18s ease-out;
}

.profile-native-sheet,
.profile-minimal-sheet.profile-native-sheet {
  position: relative;
  bottom: auto !important;
  width: 100%;
  max-height: calc(100vh - 84rpx);
  overflow-y: auto;
  box-sizing: border-box;
  padding: 14rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fbfcf8;
  box-shadow: 0 -24rpx 64rpx rgba(13, 31, 21, .16);
  transform: translate3d(0, 0, 0);
  transition: none !important;
  animation: profile-v11-sheet-up .24s cubic-bezier(.22, .8, .3, 1);
}

.profile-native-sheet .profile-sheet-handle {
  width: 64rpx;
  height: 6rpx;
  margin: 0 auto 17rpx;
  border-radius: 999rpx;
  background: #d5dbd4;
}

.profile-native-sheet .profile-minimal-head {
  min-height: 98rpx;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.profile-native-sheet .profile-minimal-heading {
  min-width: 0;
  flex: 1;
}

.profile-native-sheet .profile-sheet-kicker {
  display: block;
  margin: 0;
  color: #7f8c84;
  font-size: 16rpx;
  line-height: 22rpx;
  font-weight: 900;
  letter-spacing: 2.3rpx;
}

.profile-native-sheet .profile-sheet-title {
  display: block;
  margin-top: 5rpx;
  color: #14251b;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.profile-native-sheet .profile-sheet-desc {
  display: block;
  margin-top: 4rpx;
  color: #88928c;
  font-size: 19rpx;
  line-height: 28rpx;
}

.profile-native-sheet .profile-sheet-close {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  margin: 0;
  border-radius: 50%;
  background: #f0f2ed;
  color: #647269;
  font-size: 34rpx;
  line-height: 54rpx;
  text-align: center;
}

.profile-sheet-close-pressed {
