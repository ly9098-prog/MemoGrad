<view class="page">
  <view class="card">
    <view class="mark">MG</view>
    <text class="eyebrow">WECHAT BIND</text>
    <text class="title">确认绑定微信</text>
    <text class="description">
      此操作只会把当前微信身份连接到你在网页上已登录的账号，不会新建或合并另一个学习账号。
    </text>

    <view wx:if="{{!challenge}}" class="manual">
      <text class="manual-label">网页没有自动传入绑定码时，可手动输入</text>
      <input
        class="manual-input"
        value="{{manualChallenge}}"
        maxlength="64"
        placeholder="绑定码"
        bindinput="onManualChallengeInput"
      />
      <button class="secondary-button" bindtap="applyManualChallenge">使用此绑定码</button>
    </view>

    <view wx:else class="challenge-state">
      <text class="challenge-label">待确认绑定码</text>
      <text class="challenge-value">{{challenge}}</text>
    </view>

    <view wx:if="{{error}}" class="feedback is-error" role="alert">{{error}}</view>
    <view wx:if="{{result}}" class="feedback is-success" role="status">{{result}}</view>

    <button
      class="primary-button"
      loading="{{confirming}}"
      disabled="{{confirming || !challenge || result}}"
      bindtap="confirmBind"
    >
      {{confirming ? '正在确认…' : '确认绑定到网页账号'}}
    </button>
    <button class="text-button" bindtap="returnHome">返回小程序首页</button>
  </view>
</view>
