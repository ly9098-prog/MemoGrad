.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx;
  background:
    radial-gradient(circle at 50% -10%, rgba(144, 205, 238, 0.32), transparent 46%),
    linear-gradient(180deg, #0d1b27 0%, #07111a 100%);
  color: #eef8ff;
}

.card {
  max-width: 680rpx;
  margin: 0 auto;
  padding: 44rpx 36rpx;
  border: 1rpx solid rgba(198, 231, 252, 0.18);
  border-radius: 28rpx;
  background: rgba(10, 27, 40, 0.88);
  box-shadow: 0 30rpx 90rpx rgba(0, 0, 0, 0.34);
}

.mark {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(198, 231, 252, 0.22);
  border-radius: 20rpx;
  background: rgba(224, 246, 255, 0.08);
  color: #cdeeff;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: -0.04em;
}

.eyebrow {
  display: block;
  margin-top: 30rpx;
  color: #8db6cc;
  font-size: 20rpx;
  letter-spacing: 0.18em;
}

.title {
  display: block;
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 650;
  letter-spacing: -0.04em;
}

.description {
  display: block;
  margin-top: 18rpx;
  color: #a9bdcc;
  font-size: 26rpx;
  line-height: 1.75;
}

.manual {
  margin-top: 34rpx;
}

.manual-label,
.challenge-label {
  display: block;
  color: #8db6cc;
  font-size: 23rpx;
}

.manual-input {
  margin-top: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(198, 231, 252, 0.2);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  color: #eef8ff;
  font-size: 28rpx;
  height: 88rpx;
}

.challenge-state {
  margin-top: 32rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(198, 231, 252, 0.16);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.035);
}

.challenge-value {
  display: block;
  margin-top: 10rpx;
  color: #cdeeff;
  font-family: monospace;
  font-size: 28rpx;
  overflow-wrap: anywhere;
}

.feedback {
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.feedback.is-error {
  background: rgba(163, 62, 57, 0.24);
  color: #ffc4c9;
}

.feedback.is-success {
  background: rgba(45, 122, 99, 0.22);
  color: #c7f3df;
}

.primary-button,
.secondary-button {
  margin-top: 30rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.primary-button {
  background: #e7f6ff;
  color: #0b1722;
}

.primary-button[disabled] {
  background: rgba(231, 246, 255, 0.34);
  color: rgba(11, 23, 34, 0.68);
}

.secondary-button {
  margin-top: 16rpx;
  border: 1rpx solid rgba(198, 231, 252, 0.2);
  background: transparent;
  color: #cdeeff;
}

.text-button {
  margin-top: 18rpx;
  background: transparent;
  color: #8db6cc;
  font-size: 24rpx;
}
