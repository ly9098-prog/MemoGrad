@import '../../styles/brand-shell.wxss';

page {
  min-height: 100vh;
  background: #FAFCFB;
  color: #23483C;
}

.agreement-root {
  min-height: 100vh;
  background: #FAFCFB;
}

.agreement-nav-inner {
  padding-left: 10rpx;
}

.memo-nav {
  border-bottom: 1rpx solid rgba(212, 228, 219, .72);
  background: rgba(250, 252, 251, .95);
}

.memo-back-button {
  width: 88rpx;
  height: 88rpx;
  min-width: 44px;
  min-height: 44px;
  border: 0;
  background: transparent;
}

.memo-back-icon {
  width: max(34rpx, 16px);
  height: max(34rpx, 16px);
}

.memo-nav-title {
  color: #23483C;
  font-size: max(30rpx, 15px);
  font-weight: 600;
}

.agreement-page {
  min-height: 100vh;
  background: #FAFCFB;
}

.agreement-content {
  width: 100%;
  box-sizing: border-box;
  padding: 44rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
}

.agreement-header {
  padding: 2rpx 0 0;
}

.agreement-title {
  display: block;
  color: #23483C;
  font-size: max(52rpx, 26px);
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.agreement-intro {
  display: block;
  max-width: 660rpx;
  margin-top: 22rpx;
  color: #52675D;
  font-size: max(30rpx, 16px);
  font-weight: 400;
  line-height: 1.75;
}

.agreement-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
  color: #617268;
  font-size: max(23rpx, 12px);
  line-height: 1.5;
}

.agreement-meta-separator {
  color: #8AA096;
}

.agreement-summary {
  margin-top: 38rpx;
  padding: 28rpx 30rpx 30rpx;
  border-radius: 24rpx;
  background: #F0F7F3;
}

.agreement-summary-title {
  display: block;
  color: #2D5D4C;
  font-size: max(25rpx, 13px);
  font-weight: 600;
  line-height: 1.4;
}

.agreement-summary-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 18rpx;
}

.agreement-summary-mark {
  width: 22rpx;
  flex: 0 0 22rpx;
  color: #3A8067;
  font-size: 22rpx;
  line-height: 1.85;
}

.agreement-summary-text {
  min-width: 0;
  flex: 1;
  color: #42584D;
  font-size: max(28rpx, 15px);
  line-height: 1.75;
}

.agreement-sections {
  margin-top: 34rpx;
  border-top: 1rpx solid #DDE9E3;
}

.agreement-section {
  padding: 34rpx 0 38rpx;
  border-bottom: 1rpx solid #DDE9E3;
}

.agreement-section-title {
  display: block;
  color: #23483C;
  font-size: max(32rpx, 16px);
  font-weight: 600;
  line-height: 1.45;
}

.agreement-copy {
  display: block;
  margin-top: 16rpx;
  color: #42584D;
  font-size: max(30rpx, 16px);
  line-height: 1.82;
  overflow-wrap: anywhere;
}

.agreement-copy + .agreement-copy {
  margin-top: 14rpx;
}

.agreement-bullets {
  margin-top: 18rpx;
}

.agreement-bullet {
  display: flex;
  align-items: flex-start;
  gap: 13rpx;
}

.agreement-bullet + .agreement-bullet {
  margin-top: 13rpx;
}

.agreement-bullet-mark {
  width: 24rpx;
  flex: 0 0 24rpx;
  color: #4D8D75;
  font-size: max(25rpx, 13px);
  line-height: 1.95;
}

.agreement-bullet-text {
  min-width: 0;
  flex: 1;
  color: #42584D;
  font-size: max(30rpx, 16px);
  line-height: 1.82;
  overflow-wrap: anywhere;
}

.agreement-footer {
  padding: 42rpx 0 12rpx;
  text-align: center;
}

.agreement-footer-brand {
  display: block;
  color: #23483C;
  font-size: max(25rpx, 13px);
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.agreement-footer-meta {
  display: block;
  margin-top: 10rpx;
  color: #617268;
  font-size: max(22rpx, 12px);
  line-height: 1.5;
}

@media (max-width: 350px) {
  .agreement-content {
    padding-left: 32rpx;
    padding-right: 32rpx;
  }

  .agreement-title {
    font-size: 25px;
  }

  .agreement-summary {
    padding-left: 26rpx;
    padding-right: 26rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .agreement-header {
    animation: none !important;
    transform: none !important;
  }
}
