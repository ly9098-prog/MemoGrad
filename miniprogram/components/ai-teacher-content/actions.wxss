.ai-deep-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.ai-deep-copy{flex:1;min-width:0}
.ai-deep-title{display:block;font-size:29rpx;line-height:1.3;font-weight:600;color:#234234}
.ai-deep-desc{display:block;margin-top:8rpx;font-size:24rpx;line-height:1.5;color:#667168}
.ai-deep-more{flex:0 0 120rpx;width:120rpx;min-width:120rpx;max-width:120rpx;min-height:88rpx;margin:0;padding:0 16rpx;display:flex;align-items:center;gap:8rpx;border:1rpx solid #D7E0D9;border-radius:16rpx;background:#FFFEFA;font-size:24rpx;color:#435047}
.ai-deep-more::after,.ai-deep-action::after{border:0}
.ai-deep-more-arrow-icon{width:24rpx;height:24rpx;transition:transform .16s ease}
.ai-deep-more-arrow-icon.is-up{transform:rotate(180deg)}
.ai-deep-actions{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16rpx;margin-top:24rpx}
.ai-deep-action{display:flex;align-items:center;min-width:0;min-height:104rpx;width:100%;margin:0;padding:16rpx;border:1rpx solid #DCE4DE;border-radius:16rpx;background:#FBFCF8;gap:12rpx;box-sizing:border-box;line-height:1.4}
.ai-deep-action-icon{width:36rpx;height:36rpx;flex:0 0 36rpx}
.ai-deep-action-label{flex:1;min-width:0;font-size:24rpx;color:#234234;text-align:left}
.ai-deep-action-arrow-icon{width:20rpx;height:20rpx;flex:0 0 20rpx}
.ai-deep-action-pressed,.ai-more-pressed{background:#EEF4EE;opacity:.8}
.ai-deep-action[disabled]{opacity:.5}
.ai-deep-extra.is-collapsed{display:none}
.ai-deep-extra.is-expanded{margin-top:24rpx;padding-top:24rpx;border-top:1rpx solid #DCE4DE}
.ai-deep-extra-label{font-size:24rpx;color:#667168}
@media(prefers-reduced-motion:reduce){.ai-deep-more-arrow-icon{transition:none}}
