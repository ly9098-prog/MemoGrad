.captcha {
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(48, 91, 73, .16);
  border-radius: 20rpx;
  background: #F4F8F5;
}
.captcha-heading {
  min-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.captcha-title {
  color: #23483C;
  font-size: 24rpx;
  font-weight: 600;
}
.captcha-refresh {
  min-height: 44rpx;
  padding: 0 4rpx;
  display: inline-flex;
  align-items: center;
  color: #4D6B5C;
  font-size: 22rpx;
  text-decoration: underline;
  text-underline-offset: 5rpx;
}
.captcha-loading {
  min-height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: #617268;
  font-size: 22rpx;
}
.captcha-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #D8EEE6;
  border-top-color: #305B49;
  border-radius: 50%;
  animation: captcha-spin 900ms linear infinite;
}
.captcha-image {
  position: relative;
  width: 100%;
  padding-top: 50%;
  overflow: hidden;
  border: 1rpx solid #C8D7CE;
  border-radius: 14rpx;
  background: #DCE7E1;
}
.captcha-background,
.captcha-piece {
  position: absolute;
  display: block;
}
.captcha-background {
  inset: 0;
  width: 100%;
  height: 100%;
}
.captcha-piece {
  filter: drop-shadow(0 4rpx 8rpx rgba(20, 47, 36, .26));
  pointer-events: none;
}
.captcha-slider {
  margin: 10rpx 0 0;
  padding: 0 2rpx;
}
.captcha-hint {
  display: block;
  margin-top: 2rpx;
  color: #617268;
  font-size: 21rpx;
  line-height: 1.4;
  text-align: center;
}
.captcha-error {
  margin-top: 12rpx;
  color: #B42318;
  font-size: 22rpx;
  line-height: 1.5;
}
.captcha-actions {
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.captcha-cancel {
  min-height: 44rpx;
  padding: 0 6rpx;
  display: inline-flex;
  align-items: center;
  color: #617268;
  font-size: 22rpx;
}

@keyframes captcha-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .captcha-spinner { animation: none; } }
