/* The slotted root supplies layout only. The shared motion-sheet-surface owns
   the drawer's background, outline and elevation, including the grip area.
   Import this file locally in isolated components that host a motion-sheet.
   Important prevents legacy page/theme rules from painting a second surface. */
.motion-sheet-panel.motion-sheet-panel {
  position: relative;
  inset: auto;
  width: 100%;
  box-sizing: border-box;
  transform: none;
  animation: none;
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}
