.route-enter {
  animation: route-content-enter 180ms cubic-bezier(.16, 1, .3, 1) backwards;
}

.route-enter-page {
  animation: route-content-enter-page 250ms cubic-bezier(.16, 1, .3, 1) backwards;
}

.route-enter-detail {
  animation: route-content-enter-detail 240ms cubic-bezier(.16, 1, .3, 1) backwards;
}

.route-enter-task {
  animation: route-content-enter-task 180ms cubic-bezier(.16, 1, .3, 1) backwards;
}

.route-enter-opacity {
  animation: route-content-enter 160ms cubic-bezier(.16, 1, .3, 1) backwards;
}

@keyframes route-content-enter {
  from { opacity: .92; }
  to { opacity: 1; }
}

@keyframes route-content-enter-page {
  from {
    opacity: 0;
    transform: translate3d(0, 12rpx, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes route-content-enter-detail {
  from {
    opacity: 0;
    transform: translate3d(16rpx, 0, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes route-content-enter-task {
  from {
    opacity: 0;
    transform: translate3d(0, 6rpx, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .route-enter,
  .route-enter-page,
  .route-enter-detail,
  .route-enter-task,
  .route-enter-opacity {
    animation: none;
  }
}
