@import '../../../components/ai-teacher-content/content.wxss';
@import '../../../components/ai-teacher-content/actions.wxss';
page{height:100%;background:#F5F8F6;color:#23483C;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
.page{height:100%;background:#F5F8F6;--result-surface:#FFF;--result-ink:#23483C;--result-muted:#5F7368;--result-line:#DFE8E2;--result-accent:#3A6F5B}
button{font-family:inherit;font-weight:500}
button::after{border:0}
.page-scroll{position:absolute;left:0;right:0;bottom:0}
.content{max-width:900rpx;margin:0 auto;padding:24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.score-card,.result-card{padding:32rpx;border-radius:24rpx;background:var(--result-surface);box-sizing:border-box}
.result-card{margin-top:32rpx}
.score-card{padding-top:40rpx;padding-bottom:32rpx}
.score-heading,.section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}
.section-title{font-size:32rpx;line-height:1.5;font-weight:600;color:var(--result-ink)}
.score-time,.section-meta{flex:none;font-size:24rpx;line-height:1.5;color:var(--result-muted)}
.score-line{display:flex;align-items:baseline;gap:16rpx;margin-top:24rpx;font-variant-numeric:tabular-nums}
.score-value{font-size:96rpx;line-height:1.1;font-weight:600;color:var(--result-ink)}
.score-total{font-size:28rpx;color:var(--result-muted)}
.score-progress-heading{display:flex;align-items:baseline;justify-content:space-between;margin-top:24rpx;font-size:24rpx;line-height:1.5;color:var(--result-muted);font-variant-numeric:tabular-nums}
.score-progress-value{font-size:26rpx;font-weight:600;color:var(--result-accent)}
.meter-track{position:relative;height:20rpx;margin-top:12rpx;border-radius:10rpx;overflow:hidden;background:repeating-linear-gradient(90deg,#DCE7E0 0,#DCE7E0 2rpx,transparent 2rpx,transparent 14rpx)}
.meter-fill{position:relative;height:100%;border-radius:10rpx;overflow:hidden;background:linear-gradient(90deg,rgba(58,111,91,.24),rgba(58,111,91,.68)),#FFF;box-shadow:6rpx 0 0 #FFF;box-sizing:border-box}
.meter-fill::after{content:"";position:absolute;left:4rpx;right:4rpx;top:2rpx;height:6rpx;border-radius:6rpx;background:rgba(255,255,255,.5)}
.stats-panel{display:flex;margin-top:32rpx;padding-top:24rpx;border-top:1rpx solid var(--result-line)}
.stat-item{flex:1;display:flex;align-items:baseline;justify-content:center;gap:12rpx}
.stat-item+.stat-item{border-left:1rpx solid #EDF2EE}
.stat-value{font-size:36rpx;line-height:1.2;font-weight:600;font-variant-numeric:tabular-nums}
.stat-correct{color:var(--result-accent)}
.stat-wrong{color:#90603F}
.stat-empty{color:#79877F;font-weight:400}
.stat-label{font-size:24rpx;color:var(--result-muted)}
.section-description{display:block;margin-top:8rpx;font-size:24rpx;line-height:1.6;color:var(--result-muted)}
.radar-stage{position:relative;width:100%;max-width:640rpx;height:520rpx;margin:24rpx auto 0}
.radar-plot{position:absolute;left:50%;top:50%;width:400rpx;height:400rpx;transform:translate(-50%,-50%)}
.radar-grid-image{position:absolute;inset:0;width:100%;height:100%}
.radar-data-fill{position:absolute;inset:0;background:linear-gradient(180deg,rgba(70,139,101,.2),rgba(70,139,101,.07))}
.radar-edge{position:absolute;height:3rpx;margin-top:-1.5rpx;border-radius:3rpx;transform-origin:0 50%;background:#47735D}
.radar-point{position:absolute;width:16rpx;height:16rpx;margin:-8rpx 0 0 -8rpx;border:2.5rpx solid #47735D;border-radius:50%;background:#F5FAF7;box-sizing:border-box}
.radar-scale{position:absolute;right:calc(50% + 16rpx);transform:translateY(-50%);font-size:20rpx;line-height:1;color:#647C6E;font-variant-numeric:tabular-nums}
.radar-scale-100{top:7.5%}.radar-scale-80{top:16%}.radar-scale-60{top:24.5%}.radar-scale-zero{top:50%}
.radar-label{position:absolute;z-index:2;display:flex;flex-direction:column;align-items:center;width:168rpx;text-align:center;gap:4rpx}
.radar-label-0{left:50%;top:0;transform:translateX(-50%);width:280rpx}
.radar-label-1{right:-8rpx;top:144rpx;align-items:flex-end;text-align:right}
.radar-label-2{right:24rpx;bottom:12rpx;align-items:flex-end;text-align:right}
.radar-label-3{left:24rpx;bottom:12rpx;align-items:flex-start;text-align:left}
.radar-label-4{left:-8rpx;top:144rpx;align-items:flex-start;text-align:left}
.radar-label-name{font-size:22rpx;line-height:1.4;color:var(--result-muted)}
.radar-label-score{font-size:28rpx;line-height:1.4;color:var(--result-accent);font-weight:600;font-variant-numeric:tabular-nums}
.radar-note{display:block;margin-top:8rpx;padding:16rpx 0;font-size:24rpx;line-height:1.6;color:var(--result-muted)}
.knowledge-list{margin-top:16rpx;padding-top:24rpx;border-top:1rpx solid var(--result-line)}
.knowledge-list-title{display:block;margin-bottom:8rpx;font-size:24rpx;line-height:1.5;font-weight:500;color:var(--result-muted)}
.knowledge-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:20rpx 0}
.knowledge-row+.knowledge-row{border-top:1rpx solid #EDF2EE}
.knowledge-row:last-child{padding-bottom:0}
.knowledge-copy{flex:1;min-width:0}
.knowledge-name{display:block;font-size:26rpx;line-height:1.5;font-weight:500;overflow-wrap:anywhere}
.knowledge-meta{display:block;margin-top:4rpx;font-size:24rpx;line-height:1.5;color:var(--result-muted)}
.knowledge-status{flex:none;font-size:24rpx;color:var(--result-muted)}
.knowledge-status.excellent,.knowledge-status.good{padding:4rpx 12rpx;border-radius:8rpx;background:#EDF5EF;color:var(--result-accent)}
.knowledge-status.weak{color:#90603F}
.top-card{margin-top:40rpx;padding-top:32rpx;padding-bottom:8rpx;border-top:1rpx solid var(--result-line);border-radius:0;background:transparent}
.top-card .section-title{font-size:28rpx}
.top-row{padding-top:32rpx}
.top-name{display:block;font-size:26rpx;line-height:1.5;overflow-wrap:anywhere}
.top-progress{position:relative;height:64rpx;margin-top:8rpx}
.top-progress-rail{position:absolute;left:0;right:0;bottom:0;height:20rpx;border-radius:10rpx;overflow:hidden;background:repeating-linear-gradient(120deg,#EEF3F0 0,#EEF3F0 10rpx,#FFF 10rpx,#FFF 16rpx)}
.top-progress-fill{position:relative;height:100%;border-radius:10rpx;background:linear-gradient(90deg,rgba(58,111,91,.2),rgba(58,111,91,.62)),#FFF;transform-origin:left center;animation:knowledge-fill-in .5s cubic-bezier(.16,1,.3,1)}
.top-progress-fill::before{content:"";position:absolute;left:4rpx;right:4rpx;top:2rpx;height:6rpx;border-radius:6rpx;background:rgba(255,255,255,.5)}
.top-progress-fill::after{content:"";position:absolute;right:0;top:0;width:20rpx;height:20rpx;border:4rpx solid #548B70;border-radius:50%;background:#FFF;box-sizing:border-box}
.top-percent{position:absolute;top:0;width:88rpx;font-size:26rpx;line-height:1.4;font-weight:600;text-align:center;color:var(--result-accent);font-variant-numeric:tabular-nums}
@keyframes knowledge-fill-in{from{transform:scaleX(0);opacity:.5}to{transform:scaleX(1);opacity:1}}
.top-detail{display:block;margin-top:12rpx;font-size:24rpx;line-height:1.5;color:var(--result-muted);font-variant-numeric:tabular-nums}
.top-detail-count{font-weight:600;color:var(--result-ink)}
.result-actions{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:32rpx}
.result-actions .primary-action,.result-actions .secondary-action{flex:1;min-width:0;width:auto;margin:0;align-self:stretch;border-radius:48rpx}
.result-actions .review-action{flex:0 0 100%}
.primary-action,.secondary-action{display:flex;align-items:center;justify-content:center;width:100%;min-height:96rpx;margin:0;padding:20rpx 24rpx;border-radius:16rpx;font-size:28rpx;line-height:1.5;box-sizing:border-box}
.primary-action{background:var(--result-accent,#3A6F5B);color:#FFF}
.secondary-action{background:#FFF;color:var(--result-accent,#3A6F5B);border:1rpx solid var(--result-line,#DFE8E2)}
.action-pressed{opacity:.75}
.state-card{padding:64rpx 32rpx;background:#FFF;border-radius:24rpx;display:flex;flex-direction:column;align-items:center;gap:24rpx;text-align:center}
.state-title{font-size:30rpx;font-weight:600}
.state-desc{font-size:26rpx;line-height:1.6;color:var(--result-muted)}
.state-spinner{width:40rpx;height:40rpx;border:4rpx solid #DFE8E2;border-top-color:#3A6F5B;border-radius:50%;animation:result-spin .8s linear infinite}
@keyframes result-spin{to{transform:rotate(360deg)}}
.teacher-sheet{display:flex;flex-direction:column;max-height:84vh;min-height:0;padding:32rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#FBFAF6}
.teacher-sheet-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex:none}
.teacher-sheet-title{flex:1;min-width:0;font-size:32rpx;font-weight:600;line-height:1.5;color:#234234}
.teacher-sheet .teacher-sheet-close{display:flex;align-items:center;justify-content:center;flex:0 0 88rpx;width:88rpx;min-width:88rpx;max-width:88rpx;height:88rpx;margin:0;padding:24rpx;border-radius:50%;background:#EEF2EC;box-sizing:border-box}
.teacher-sheet-close image{width:32rpx;height:32rpx}
.teacher-question-picker{flex:none;margin:16rpx 0 24rpx;border:1rpx solid #DCE4DE;border-radius:16rpx;background:#FFF}
.teacher-question-picker view{min-height:88rpx;display:flex;align-items:center;justify-content:space-between;padding:16rpx 24rpx;font-size:26rpx;box-sizing:border-box}
.teacher-question-picker image{width:28rpx;height:28rpx}
.teacher-sheet-scroll{flex:0 1 auto;min-height:0}
.teacher-sheet-loading,.teacher-sheet-error{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;min-height:200rpx;padding:24rpx;font-size:26rpx;line-height:1.6;text-align:center;color:#435047}
.teacher-retry{margin-top:24rpx}
.teacher-action-panel{padding:24rpx 0}
@media(max-width:360px){.content{padding-left:16rpx;padding-right:16rpx}.score-card,.result-card{padding:24rpx}.stat-item{flex-direction:column;align-items:center;gap:8rpx}.radar-plot{width:360rpx;height:360rpx}.radar-stage{height:488rpx}.radar-label{width:144rpx}.radar-label-2{right:8rpx}.radar-label-3{left:8rpx}}
@media(min-width:600px){.content{max-width:560px}.radar-stage{max-width:380px}.radar-plot{width:260px;height:260px}.radar-stage{height:340px}}
@media(prefers-reduced-motion:reduce){.state-spinner,.top-progress-fill{animation:none}}
