<import src="../../../components/ai-teacher-content/content.wxml" />
<import src="../../../components/ai-teacher-content/actions.wxml" />
<view class="page">
  <premium-nav title="考试结果" variant="mint" bind:back="handleBack" />
  <scroll-view class="page-scroll" style="top:{{navTotalHeightPx}}px;height:calc(100vh - {{navTotalHeightPx}}px);" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
    <view class="content {{!loading ? 'route-enter-opacity' : ''}}">
      <view wx:if="{{loading}}" class="state-card">
        <view class="state-spinner" aria-hidden="true"></view>
        <text class="state-title">正在加载考试结果</text>
        <text class="state-desc">正在整理得分与本卷作答情况</text>
      </view>
      <view wx:elif="{{errorText}}" class="state-card">
        <text class="state-title">结果加载失败</text>
        <text class="state-desc">{{errorText}}</text>
        <button class="secondary-action" bindtap="loadResult">重新加载</button>
      </view>
      <block wx:elif="{{result}}">
        <view class="score-card">
          <view class="score-heading"><text class="section-title">本次成绩</text><text class="score-time">用时 {{result.durationText}}</text></view>
          <view class="score-line"><text class="score-value">{{result.scoreValue}}</text><text class="score-total">/ {{result.totalScoreValue}} 分</text></view>
          <view class="score-progress-heading"><text>得分率</text><text class="score-progress-value">{{result.scoreRatePct}}%</text></view>
          <view class="meter-track score-progress" aria-role="img" aria-label="得分率 {{result.scoreRatePct}}%"><view wx:if="{{result.scoreRatePct > 0}}" class="meter-fill" style="width:{{result.scoreRatePct}}%;"></view></view>
          <view class="stats-panel">
            <view class="stat-item"><text class="stat-value stat-correct">{{result.correctCount}}</text><text class="stat-label">答对</text></view>
            <view class="stat-item"><text class="stat-value {{result.wrongCount ? 'stat-wrong' : 'stat-empty'}}">{{result.wrongCount}}</text><text class="stat-label">答错</text></view>
            <view class="stat-item"><text class="stat-value {{result.unansweredCount ? '' : 'stat-empty'}}">{{result.unansweredCount}}</text><text class="stat-label">未作答</text></view>
          </view>
        </view>
        <view class="result-card radar-card">
          <view class="section-heading"><text class="section-title">知识雷达</text><text class="section-meta">本卷正确率</text></view>
          <text class="section-description">按本卷涉及题量展示 5 个维度，仅反映本次作答</text>
          <view class="radar-stage" aria-role="img" aria-label="本卷知识正确率，详细数值见下方列表">
            <view class="radar-plot">
              <image class="radar-grid-image" src="{{icons.radarGrid}}" mode="aspectFit" aria-hidden="true" />
              <text class="radar-scale radar-scale-100" aria-hidden="true">100</text>
              <text class="radar-scale radar-scale-80" aria-hidden="true">80</text>
              <text class="radar-scale radar-scale-60" aria-hidden="true">60</text>
              <text class="radar-scale radar-scale-zero" aria-hidden="true">0</text>
              <view class="radar-data-fill" style="{{radarPolygonStyle}}"></view>
              <view wx:for="{{radarEdges}}" wx:key="index" class="radar-edge" style="{{item.style}}"></view>
              <view wx:for="{{radarItems}}" wx:key="index" class="radar-point" style="{{item.pointStyle}}"></view>
            </view>
            <view wx:for="{{radarItems}}" wx:key="index" class="radar-label radar-label-{{index}}">
              <text class="radar-label-name">{{item.axisName}}</text>
              <text class="radar-label-score">{{item.source === 'fallback' ? '—' : item.accuracyPct + '%'}}</text>
            </view>
          </view>
          <text class="radar-note" wx:if="{{result.unansweredCount}}">有 {{result.unansweredCount}} 题未作答，0% 不代表已确认的知识薄弱</text>
          <view class="knowledge-list">
            <text class="knowledge-list-title">维度明细</text>
            <view wx:for="{{radarItems}}" wx:key="index" class="knowledge-row">
              <view class="knowledge-copy"><text class="knowledge-name" user-select="true">{{item.name}}</text><text class="knowledge-meta">{{item.source === 'fallback' ? '暂无维度数据' : '答对 ' + item.correctCount + ' / ' + item.questionCount + ' 题'}}{{item.unansweredCount ? ' · 未答 ' + item.unansweredCount + ' 题' : ''}}</text></view>
              <text class="knowledge-status {{item.tagTone}}">{{item.tagLabel}}</text>
            </view>
          </view>
        </view>
        <view class="result-card top-card" wx:if="{{topItems.length}}">
          <view class="section-heading"><text class="section-title">本卷表现较好的知识点</text><text class="section-meta">前 {{topItems.length}} 项</text></view>
          <view wx:for="{{topItems}}" wx:key="name" class="top-row">
            <text class="top-name">{{item.name}}</text>
            <view class="top-progress" aria-role="img" aria-label="{{item.name}}，正确率 {{item.progressPct}}%">
              <text class="top-percent" style="left:clamp(0rpx,calc({{item.progressPct}}% - 44rpx),calc(100% - 88rpx));">{{item.progressPct}}%</text>
              <view class="top-progress-rail"><view wx:if="{{item.progressPct > 0}}" class="top-progress-fill" style="width:{{item.progressPct}}%;"></view></view>
            </view>
            <text class="top-detail">答对 <text class="top-detail-count">{{item.correctCount}}</text> / {{item.questionCount}} 题</text>
          </view>
        </view>
        <view class="result-actions">
          <button wx:if="{{wrongDetailCount}}" class="primary-action review-action" bindtap="openWeakReview" hover-class="action-pressed">复盘错题 · {{wrongDetailCount}} 题</button>
          <button class="{{wrongDetailCount ? 'secondary-action' : 'primary-action'}}" bindtap="open408Teacher" hover-class="action-pressed">AI 复盘</button>
          <button class="secondary-action" bindtap="goPaperList" hover-class="action-pressed">继续练习</button>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
<motion-sheet show="{{teacherSheetVisible}}" label="AI 深入讲解" background="#FBFAF6" safe-area="{{false}}" content-motion="fade" layer="{{260}}" bind:close="close408Teacher">
  <view class="teacher-sheet motion-sheet-panel" catchtap="noop">
    <view class="teacher-sheet-head"><text class="teacher-sheet-title">{{teacherResult ? teacherResult.title : 'AI 复盘'}}</text><button class="teacher-sheet-close" bindtap="close408Teacher" aria-label="关闭 AI 复盘"><image src="/assets/icons/mobile-controls/x.svg" mode="aspectFit" aria-hidden="true" /></button></view>
    <picker class="teacher-question-picker" range="{{reviewQuestions}}" range-key="title" value="{{reviewQuestionIndex}}" disabled="{{teacherLoading}}" bindchange="selectTeacherQuestion" aria-label="选择要复盘的题目"><view>{{reviewQuestions[reviewQuestionIndex].title || '选择题目'}}<image src="/assets/icons/wrong-detail/chevron-down.svg" mode="aspectFit" aria-hidden="true" /></view></picker>
    <fit-scroll reader-class="teacher-sheet-scroll" content="{{teacherSheetVisible ? (teacherResult || teacherErrorText || teacherLoading || teacherActionsExpanded || 'actions') : ''}}">
      <view wx:if="{{teacherLoading}}" class="teacher-sheet-loading"><view class="state-spinner" aria-hidden="true"></view><text>正在结合本题作答生成讲解</text></view>
      <view wx:elif="{{teacherErrorText}}" class="teacher-sheet-error"><text user-select="true">{{teacherErrorText}}</text><button class="teacher-retry secondary-action" bindtap="retry408Teacher">重新尝试</button></view>
      <block wx:elif="{{teacherResult}}"><template is="ai-teacher-content" data="{{teacherResult, generatedNote: '内容由 AI 深入讲解生成，仅用于本次考试复盘。'}}" /><button wx:if="{{teacherResult.fromFallback}}" class="teacher-retry secondary-action" bindtap="retry408Teacher">重新尝试</button></block>
      <view class="teacher-action-panel" wx:if="{{!teacherLoading}}"><template is="ai-teacher-actions" data="{{teacherPrimaryActions, teacherMoreActions, teacherActionsExpanded, aiAvailabilityEnabled: true, actionHandler: 'select408TeacherAction'}}" /></view>
    </fit-scroll>
  </view>
</motion-sheet>
