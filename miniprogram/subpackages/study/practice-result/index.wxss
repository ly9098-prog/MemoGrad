.guest-result-actions{display:flex;flex-direction:column;gap:16rpx;margin-top:24rpx}
.guest-result-repeat{width:100%;height:88rpx;margin:0;padding:0;border-radius:22rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;font-size:27rpx;font-weight:800;line-height:1;background:#173426;color:#F7FBF5}
.guest-result-repeat::after{border:0}
.question-preview-card .section-head{flex-wrap:wrap;row-gap:12rpx}
.question-preview-card .filter-pills{flex:1 1 auto}
.stat-time{flex:1.45}
.time-value{font-size:26rpx;line-height:34rpx;letter-spacing:-.5rpx}

/* One reader frame keeps the shared surface stable when switching to AI. */
.result-reader-sheet.review-dialog-sheet{height:calc(82vh - 28px);max-height:calc(82vh - 28px);min-height:0}

/* Match the wrong-detail diagnosis sheet; the shared motion-sheet owns paint. */
.teacher-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: calc(88vh - 28px);
  min-height: 0;
  padding: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.teacher-sheet-head {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 32rpx 32rpx;
}

.teacher-sheet-head .mini-choice-sheet-title {
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.teacher-sheet-head .mini-choice-sheet-description {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.6;
}

.teacher-sheet-scroll {
  flex: 0 1 auto;
  min-height: 0;
}

.teacher-sheet-content {
  padding: 0 32rpx 32rpx;
}

/* Explicit widths and margins keep native button gutters independent of gap. */
.teacher-action-panel .mini-choice-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0;
}

.teacher-action-panel .mini-choice-option {
  flex: 0 0 calc(50% - 12rpx);
  width: calc(50% - 12rpx);
  min-height: 136rpx;
  margin: 0 0 20rpx;
  padding: 24rpx 20rpx;
}

.teacher-action-panel .mini-choice-option-description {
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.6;
}

.teacher-action-title {
  display: block;
  margin-bottom: 16rpx;
  color: #3A6F5B;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.teacher-sheet-loading,
.teacher-sheet-error {
  padding: 8rpx 4rpx;
}

.teacher-state-title {
  display: block;
  color: #23483C;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.teacher-state-description {
  display: block;
  margin-top: 8rpx;
  color: #507568;
  font-size: 26rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.teacher-skeleton {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.teacher-skeleton view {
  height: 20rpx;
  border-radius: 8rpx;
  background: #E4EDE7;
}

.teacher-skeleton view:last-child {
  width: 64%;
}

.teacher-sheet-footer {
  display: flex;
  align-items: stretch;
  flex: 0 0 auto;
  gap: 0;
  margin-top: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #D8EEE6;
  box-sizing: border-box;
}

.teacher-sheet-footer .mini-choice-sheet-action {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  width: 0;
  min-height: 44px;
  margin: 0;
  padding: 20rpx 16rpx;
  line-height: 1.5;
}

.teacher-sheet-footer .mini-choice-sheet-action-primary {
  margin-left: 24rpx;
  box-shadow: none;
}

.teacher-sheet-footer .mini-choice-sheet-action[disabled] {
  background: #E4EDE7;
  color: #507568;
  box-shadow: none;
}

/* Wide, short windows must leave room for the reader and fixed actions. */
@media (min-width: 600px) and (max-height: 480px) {
  .teacher-sheet-head {
    padding: 0 16px 16px;
  }

  .teacher-sheet-head .mini-choice-sheet-title {
    font-size: 20px;
  }

  .teacher-sheet-head .mini-choice-sheet-description {
    margin-top: 6px;
    font-size: 12px;
  }

  .teacher-sheet-footer {
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  }

  .teacher-sheet-footer .mini-choice-sheet-action {
    padding: 12px 8px;
    font-size: 14px;
  }
}
