<view class="page">
<submit-confirm id="submitConfirm" theme="mint" />
<app-dialog id="appDialog" theme="mint"></app-dialog>
<page-container
    show="{{practiceExitGuardVisible}}"
    position="bottom"
    duration="0"
    overlay="{{false}}"
    round="{{false}}"
    close-on-slide-down="{{false}}"
    custom-style="width:1px;height:1px;min-height:0;padding:0;margin:0;background:transparent;overflow:hidden;pointer-events:none;"
    bind:afterleave="onPracticeExitGuardLeave"
  />
<view class="submit-loading-mask" wx:if="{{submitting}}" catchtap="noop">
<view class="submit-loading-card">
<loading-lottie size="large" theme="brand" enable-lottie="{{false}}" />
<text class="submit-loading-title">正在批改答案</text>
<text class="submit-loading-desc">正在生成成绩与复盘建议，请稍候</text>
<view class="submit-loading-dots"><view></view><view></view><view></view></view>
</view>
</view>
<view class="setup route-enter-task" wx:if="{{entryResolved && !started && !launchingPreset}}">
<premium-nav title="刷题" variant="mint" fixed="{{false}}" bind:back="goBack" />
<scroll-view class="setup-scroll" scroll-y enhanced show-scrollbar="{{true}}" bounces="{{false}}">
<view class="setup-error-card" wx:if="{{errorText}}">
<text class="setup-error-icon line-icon icon-exclamation" aria-hidden="true"></text>
<text class="setup-error-text">{{errorText}}</text>
<button class="setup-error-retry" bindtap="startPractice">{{guestMode ? '重新加载科目' : '重试'}}</button>
</view>
<view class="setup-content" wx:if="{{!errorText}}">
<view class="guest-notice" wx:if="{{guestNotice}}">{{guestNotice}}</view>
<view class="practice-hero">
<view class="hero-head">
<view class="hero-subject-action" hover-class="soft-pressed" bindtap="openSubjectSheet">
<text class="hero-subject">{{selectedSubjectName || '选择科目'}}</text>
<text class="hero-subject-arrow line-icon icon-chevron-right" aria-hidden="true"></text>
</view>
<view class="hero-mode"><image src="/assets/icons/practice/{{selectedMode === 'sequential' ? 'list-ordered' : (selectedMode === 'smart' ? 'target' : 'shuffle')}}.svg" mode="aspectFit" aria-hidden="true" /><text>{{selectedModeLabel}}</text></view>
</view>
<view class="hero-metrics">
<view class="hero-metric hero-metric-primary">
<view class="hero-number-line">
<text class="hero-number">{{countDisplay}}</text>
<text class="hero-number-unit">题</text>
</view>
<text class="hero-metric-label">本组题量</text>
</view>
<view class="hero-metric-divider"></view>
<view class="hero-metric">
<view class="hero-number-line hero-number-line-small">
<text class="hero-number hero-number-small">{{estimatedMinutes}}</text>
<text class="hero-number-unit">分钟</text>
</view>
<text class="hero-metric-label">预计完成时间</text>
</view>
</view>
<button
          class="hero-start"
          disabled="{{!selectedSubjectId}}"
          hover-class="{{!selectedSubjectId ? 'none' : 'hero-start-pressed'}}"
          bindtap="startPractice"
        >
<text>{{selectedSubjectId ? '开始本组练习' : '请先选择科目'}}</text>
<view class="hero-start-arrow"><text class="line-icon icon-chevron-right" aria-hidden="true"></text></view>
</button>
<view class="hero-config" hover-class="soft-pressed" bindtap="toggleSettings">
<text class="hero-config-text">练习设置</text>
<view class="hero-config-edit">
<text>{{settingsExpanded ? '收起' : '调整'}}</text>
<text class="config-chevron line-icon icon-chevron-down {{settingsExpanded ? 'up' : ''}}" aria-hidden="true"></text>
</view>
</view>
</view>
<view class="settings-panel" wx:if="{{settingsExpanded}}">
<view class="panel-heading">
<view>
<text class="panel-title">练习设置</text>
</view>
<view class="panel-collapse" hover-class="soft-pressed" bindtap="toggleSettings">
<text>收起</text><text class="panel-collapse-arrow line-icon icon-chevron-down up" aria-hidden="true"></text>
</view>
</view>
<view class="setting-block">
<view class="setting-head">
<text class="setting-title">练习模式</text>
<text class="setting-desc">选择适合当前复习阶段的出题方式</text>
</view>
<view class="mode-row">
<view class="mode-card {{selectedMode==='random' ? 'active' : ''}}" hover-class="option-pressed" bindtap="chooseMode" data-mode="random">
<image class="mode-icon-image" src="/assets/icons/practice/shuffle.svg" mode="aspectFit" aria-hidden="true"></image>
<text class="mode-title">随机挑战</text>
<text class="mode-desc">综合查漏</text>
<view class="option-check" wx:if="{{selectedMode==='random'}}"><text class="setting-check-icon line-icon icon-check" aria-hidden="true"></text></view>
</view>
<view class="mode-card {{guestMode ? 'mode-card-locked' : (selectedMode==='sequential' ? 'active' : '')}}" hover-class="{{guestMode ? '' : 'option-pressed'}}" bindtap="{{guestMode ? '' : 'chooseMode'}}" data-mode="sequential" aria-disabled="{{guestMode}}">
<image class="mode-icon-image" src="/assets/icons/practice/list-ordered.svg" mode="aspectFit" aria-hidden="true"></image>
<text class="mode-title">顺序推进</text>
<text class="mode-desc">按题库顺序续刷</text>
<image class="mode-lock" wx:if="{{guestMode}}" src="/assets/icons/lock.svg" mode="aspectFit" aria-hidden="true" />
<view class="option-check" wx:if="{{!guestMode && selectedMode==='sequential'}}"><text class="setting-check-icon line-icon icon-check" aria-hidden="true"></text></view>
</view>
<view class="mode-card {{guestMode ? 'mode-card-locked' : (selectedMode==='smart' ? 'active' : '')}}" hover-class="{{guestMode ? '' : 'option-pressed'}}" bindtap="{{guestMode ? '' : 'chooseMode'}}" data-mode="smart" aria-disabled="{{guestMode}}">
<image class="mode-icon-image" src="/assets/icons/practice/target.svg" mode="aspectFit" aria-hidden="true"></image>
<text class="mode-title">智能推荐</text>
<text class="mode-desc">薄弱优先</text>
<image class="mode-lock" wx:if="{{guestMode}}" src="/assets/icons/lock.svg" mode="aspectFit" aria-hidden="true" />
<view class="option-check" wx:if="{{!guestMode && selectedMode==='smart'}}"><text class="setting-check-icon line-icon icon-check" aria-hidden="true"></text></view>
</view>
</view>
<text class="guest-mode-note" wx:if="{{guestMode}}">顺序推进和智能推荐依赖个人练习数据，登录后可用。</text>
</view>
<view class="setting-block count-setting-block">
<view class="setting-head">
<text class="setting-title">题量选择</text>
<text class="setting-desc">根据可用时间设定本组题量</text>
</view>
<view class="count-row">
<view class="count-btn {{count===5 ? 'active' : ''}}" hover-class="option-pressed" bindtap="setCount" data-count="5">
<text class="count-main">5题</text><text class="count-time">约10分钟</text>
<view class="option-check count-check" wx:if="{{count===5}}"><text class="setting-check-icon line-icon icon-check" aria-hidden="true"></text></view>
</view>
<view class="count-btn {{count===10 ? 'active' : ''}}" hover-class="option-pressed" bindtap="setCount" data-count="10">
<text class="count-main">10题</text><text class="count-time">约20分钟</text>
<view class="option-check count-check" wx:if="{{count===10}}"><text class="setting-check-icon line-icon icon-check" aria-hidden="true"></text></view>
</view>
<view class="count-btn {{count===20 ? 'active' : ''}}" hover-class="option-pressed" bindtap="setCount" data-count="20">
<text class="count-main">20题</text><text class="count-time">约40分钟</text>
<view class="option-check count-check" wx:if="{{count===20}}"><text class="setting-check-icon line-icon icon-check" aria-hidden="true"></text></view>
</view>
<view class="count-btn {{count===30 ? 'active' : ''}}" hover-class="option-pressed" bindtap="setCount" data-count="30">
<text class="count-main">30题</text><text class="count-time">约60分钟</text>
<view class="option-check count-check" wx:if="{{count===30}}"><text class="setting-check-icon line-icon icon-check" aria-hidden="true"></text></view>
</view>
</view>
</view>
</view>
<view class="recent-section" wx:if="{{!guestMode && recentSubjects && recentSubjects.length > 0}}">
<view class="section-heading-row">
<view>
<text class="surface-title">最近使用科目</text>
</view>
<view class="surface-action" hover-class="soft-pressed" bindtap="openSubjectSheet">
<text>科目</text><text class="line-icon icon-chevron-right surface-action-arrow" aria-hidden="true"></text>
</view>
</view>
<scroll-view scroll-x enhanced enable-flex bounces="{{false}}" show-scrollbar="{{false}}" class="recent-scroll">
<view class="recent-list">
<view
              wx:for="{{recentSubjects}}"
              wx:key="subject_id"
              class="recent-card {{selectedSubjectId === item.subject_id ? 'active' : ''}}"
              aria-role="button"
              aria-label="{{item.display_name}}，{{selectedSubjectId === item.subject_id ? '当前科目' : '切换科目'}}"
              aria-pressed="{{selectedSubjectId === item.subject_id}}"
              hover-class="recent-card-pressed"
              bindtap="chooseRecentSubject"
              data-subject-id="{{item.subject_id}}"
              data-subject-name="{{item.display_name}}"
              data-has-children="{{item.has_children}}"
            >
<view class="recent-mark">
<image wx:if="{{item.icon_src}}" class="recent-subject-icon" src="{{item.icon_src}}" mode="aspectFit" aria-hidden="true" />
<text wx:else>{{item.mark}}</text>
</view>
<view class="recent-card-copy">
<text class="recent-name">{{item.display_name}}</text>
</view>

</view>
</view>
</scroll-view>
</view>
<view class="reward-strip" wx:if="{{!guestMode && selectedSubjectId}}">
<image class="reward-strip-icon" src="/assets/icons/practice/notebook-tabs.svg" mode="aspectFit" aria-hidden="true" />
<text class="reward-strip-text">完成后查看本组复盘与成长反馈</text>
</view>
</view>
</scroll-view>
<view class="subject-sheet-layer {{subjectSheetClosing ? 'closing' : ''}}" wx:if="{{subjectSheetVisible}}">
<view class="subject-sheet-backdrop" catchtap="closeSubjectSheet" catchtouchmove="noop"></view>
<view class="subject-sheet" catchtap="noop">
<view class="sheet-handle"></view>
<view class="sheet-header">
<view>
<text class="sheet-title">选择科目</text>
</view>
<view class="sheet-close" aria-role="button" aria-label="取消选科" hover-class="soft-pressed" catchtap="closeSubjectSheet"><text class="line-icon icon-close" aria-hidden="true"></text></view>
</view>
<view class="subject-discipline-hint" wx:if="{{subjectSheetPages.length > 1}}">
<text>左右滑动切换学科</text><text>{{subjectSheetCurrent + 1}} / {{subjectSheetPages.length}}</text>
</view>
<view class="subject-empty" wx:if="{{!subjectSheetPages || subjectSheetPages.length === 0}}">
<text class="subject-empty-text">暂无可练习科目</text>
<text class="subject-empty-hint">请先在后台添加并启用科目</text>
</view>
<swiper wx:else class="subject-discipline-swiper" current="{{subjectSheetCurrent}}" circular="{{subjectSheetPages.length > 1}}" autoplay="{{false}}" display-multiple-items="1" duration="240" bindchange="toggleParentExpansion">
<swiper-item class="subject-discipline-item" wx:for="{{subjectSheetPages}}" wx:for-item="discipline" wx:key="root_id">
<scroll-view class="subject-discipline-scroll" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
<view class="subject-discipline-page">
<view class="subject-discipline-heading">
<image wx:if="{{discipline.icon_src}}" class="discipline-icon" src="{{discipline.icon_src}}" mode="aspectFit" aria-hidden="true" />
<text class="subject-discipline-title">{{discipline.root_name}}</text>
</view>
<view class="subject-branch-header" wx:if="{{!discipline.is_root}}">
<view class="subject-branch-back" aria-role="button" aria-label="返回上级科目" hover-class="soft-pressed" catchtap="toggleParentExpansion" data-subject-id="{{discipline.back_id}}">
<text class="line-icon icon-chevron-right" aria-hidden="true"></text><text>上一级</text>
</view>
<text class="subject-branch-name">{{discipline.node_name}}</text>
</view>
<view class="subject-scope-option {{subjectSheetDraft.subject_id === discipline.node_id ? 'active' : ''}}" aria-role="button" aria-pressed="{{subjectSheetDraft.subject_id === discipline.node_id}}" hover-class="subject-option-pressed" catchtap="chooseParentSubject" data-subject-id="{{discipline.node_id}}">
<text>{{discipline.has_children ? (discipline.is_root ? '选择本学科全部' : '选择本科目全部') : '选择' + discipline.node_name}}</text>
<image wx:if="{{subjectSheetDraft.subject_id === discipline.node_id}}" class="subject-scope-check" src="/assets/icons/practice-subject/check.svg" mode="aspectFit" aria-hidden="true" />
</view>
<view class="subject-options-grid" wx:if="{{discipline.options.length}}">
<view wx:for="{{discipline.options}}" wx:for-item="subject" wx:key="subject_id" class="subject-option {{subjectSheetDraft.subject_id === subject.subject_id ? 'active' : ''}}" aria-role="button" aria-label="{{subject.display_name}}，{{subject.has_children ? '查看下级科目' : '选择科目'}}" aria-pressed="{{subjectSheetDraft.subject_id === subject.subject_id}}" hover-class="subject-option-pressed" catchtap="chooseChildSubject" data-subject-id="{{subject.subject_id}}">
<image wx:if="{{subject.icon_src}}" class="subject-option-icon" src="{{subject.icon_src}}" mode="aspectFit" aria-hidden="true" />
<text class="subject-option-name">{{subject.display_name}}</text>
<text wx:if="{{subject.has_children}}" class="subject-option-arrow line-icon icon-chevron-right" aria-hidden="true"></text>
<image wx:elif="{{subjectSheetDraft.subject_id === subject.subject_id}}" class="subject-option-check" src="/assets/icons/practice-subject/check.svg" mode="aspectFit" aria-hidden="true" />
</view>
</view>
</view>
</scroll-view>
</swiper-item>
</swiper>
<view class="subject-sheet-footer">
<text class="subject-sheet-selection">{{subjectSheetDraft ? subjectSheetDraft.display_name : '请选择练习科目'}}</text>
<button class="subject-sheet-confirm" disabled="{{!subjectSheetDraft}}" hover-class="subject-option-pressed" catchtap="chooseChildSubject" data-action="confirm">确定选择</button>
</view>
</view>
</view>
</view>
<view class="practice route-enter-task {{guestMode ? 'guest-practice' : ''}}" wx:if="{{started && !loading}}" style="padding-top: {{statusBarHeight}}px;">
<view class="guest-notice" wx:if="{{guestMode && guestNotice}}">{{guestNotice}}</view>
<quiz-runner
      class="practice-runner"
      mode="practice"
      title="{{guestMode ? '体验' : '练习'}}"
      subjectName="{{selectedSubjectName}}"
      questions="{{questions}}"
      currentQuestion="{{currentQuestion}}"
      answerState="{{currentAnswerState}}"
      currentIndex="{{currentIndex}}"
      totalCount="{{totalQuestions}}"
      answeredCount="{{answeredCount}}"
      progressPercent="{{progressPercent}}"
      elapsedText="{{elapsedText}}"
      readonly="{{false}}"
      submitted="{{submitted}}"
      submitting="{{submitting}}"
      showFeedback="{{false}}"
      submitText="{{guestMode ? '查看结果' : '交卷复盘'}}"
      submitDisabled="{{submitted}}"
      showBackButton="{{true}}"
      customNavigation="{{true}}"
      navigationBarHeight="{{navBarHeight}}"
      swipeThroughOptions="{{true}}"
      bind:selectoption="selectOption"
      bind:selectblankoption="selectBlankOption"
      bind:prev="goPrev"
      bind:next="goNext"
      bind:jump="goQuestion"
      bind:submit="doSubmit"
      bind:exit="requestExitPractice"
    />
  <view class="guest-text-answer" wx:if="{{guestMode && needsTextAnswer}}">
    <text class="guest-intro-desc">{{currentQuestion.question_type === 'subjective' ? '写下思路，查看结果后对照参考答案自查，不计入客观正确率。' : '输入填空答案后查看判分与解析。'}}</text>
    <textarea value="{{textAnswer}}" bindinput="onTextAnswer" maxlength="4096" placeholder="请输入答案或解题思路" aria-label="答案或解题思路" />
  </view>
</view>
<view class="loading-wrap {{!entryResolved || launchingPreset ? 'launch-loading' : ''}}" wx:if="{{!entryResolved || launchingPreset || (started && loading)}}">
<loading-lottie
      wx:if="{{entryResolved}}"
      text="{{launchingPreset ? '正在进入专项练习...' : (selectedMode==='sequential' ? '正在读取顺序进度...' : '正在生成挑战题组...')}}"
      size="large"
      enable-lottie="{{false}}"
    />
</view>
</view>
