@import '../../../styles/tokens.wxss';
@import '../../../styles/choice-grid-sheet.wxss';
page{min-height:100vh;background-color:#F3F4F1;overflow-x:hidden}
.page{min-height:100vh;background-color:#F3F4F1;padding-bottom:0;overflow-x:hidden}
.setup{height:100vh;min-height:0;padding-bottom:0;display:flex;flex-direction:column;overflow:hidden}
.setup > premium-nav{display:block;flex-shrink:0}
.setup-scroll{display:block;flex:1;height:0;min-height:0;width:100%}
.soft-pressed,.option-pressed,.recent-card-pressed{opacity:0.78;transform:scale(0.985)}
.guest-notice{margin:18rpx 24rpx 0;padding:18rpx 24rpx;border-radius:18rpx;background:#FFF4D8;color:#6B5520;font-size:24rpx;line-height:1.5}
.guest-intro-desc{font-size:24rpx;line-height:1.6;color:#4D6352}
.guest-mode-note{display:block;margin-top:14rpx;color:#65736A;font-size:22rpx;line-height:1.5}
.mode-card-locked{opacity:.58;filter:grayscale(.55)}
.mode-lock{position:absolute;right:12rpx;top:12rpx;width:30rpx;height:30rpx}
.count-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx}
.guest-text-answer{padding:20rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));background:#F3F4F1;display:flex;flex-direction:column;gap:14rpx}
.guest-practice{display:flex;flex-direction:column}
.guest-practice .practice-runner{height:0;flex:1}
.guest-practice .guest-text-answer,.guest-practice .guest-notice{flex-shrink:0}
.guest-text-answer textarea{width:100%;min-height:150rpx;padding:20rpx;box-sizing:border-box;border-radius:18rpx;background:#FFF;font-size:26rpx}
.setup-error-card{margin:24rpx;padding:32rpx;border:2rpx solid rgba(255,80,80,0.25);border-radius:24rpx;display:flex;flex-direction:column;align-items:center;gap:16rpx}
.setup-error-icon{display:block}
.setup-error-text{font-size:26rpx;text-align:center;line-height:1.5}
.setup-error-retry{margin-top:8rpx;padding:16rpx 48rpx;font-size:26rpx;line-height:1.4}
.practice-hero{position:relative;overflow:hidden}
.hero-head,.hero-metrics,.hero-start,.hero-config{position:relative;z-index:1}
.hero-subject-action{margin-top:16rpx;display:inline-flex;align-items:center;gap:12rpx;max-width:100%}
.hero-subject{font-size:52rpx;line-height:1.15;font-weight:600;letter-spacing:1rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.hero-subject-arrow{flex-shrink:0;border:1rpx solid rgba(255,255,255,0.28);font-size:34rpx;text-align:center}
.hero-metrics{margin-top:24rpx;min-height:132rpx;display:flex;align-items:center}
.hero-metric{flex:1;min-width:0}
.hero-metric-primary{min-width:0}
.hero-number-line{display:flex;align-items:flex-end;gap:8rpx;height:80rpx}
.hero-number{font-size:72rpx;line-height:1.1;font-weight:600;font-variant-numeric:tabular-nums;letter-spacing:-3rpx}
.hero-number-small{font-size:58rpx;letter-spacing:-2rpx}
.hero-number-unit{padding-bottom:8rpx;font-size:24rpx;line-height:1;font-weight:500;letter-spacing:0}
.hero-metric-label{display:block;margin-top:11rpx;font-size:18rpx;line-height:1.3;letter-spacing:1.5rpx;font-weight:700}
.hero-metric-divider{width:1rpx;height:88rpx;margin:0 30rpx 0 6rpx}
.hero-start{margin-top:28rpx;height:102rpx;padding:0 14rpx 0 34rpx;border-radius:28rpx;display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:600}
.hero-start::after{border:none}
.hero-start[disabled]{background:#3C473E;color:rgba(255,255,255,0.42);box-shadow:none}
.hero-start-arrow{font-size:48rpx;font-weight:400}
.hero-start[disabled] .hero-start-arrow{background:rgba(255,255,255,0.10);color:rgba(255,255,255,0.38)}
.hero-start-pressed{transform:scale(0.988);opacity:0.92}
.hero-config{margin-top:14rpx;justify-content:space-between;border:1rpx solid rgba(255,255,255,0.07)}
.hero-config-text{line-height:1.35;font-weight:600}
.hero-config-edit{height:48rpx}
.config-chevron{font-size:22rpx;transition:transform .2s ease}
.settings-panel{margin-top:22rpx;border:1rpx solid rgba(18,32,22,0.07)}
.settings-panel{padding:28rpx;animation:panelReveal .22s ease-out both}

@keyframes panelReveal{from{opacity:0;transform:translateY(-10rpx)}
to{opacity:1;transform:translateY(0)}
}
.panel-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.section-heading-row,.sheet-header{display:flex;justify-content:space-between;gap:20rpx}
.panel-title,.surface-title,.sheet-title{display:block;font-size:30rpx;line-height:1.25;font-weight:900}
.panel-collapse{flex-shrink:0;height:54rpx;display:flex;align-items:center;gap:7rpx;font-size:21rpx;font-weight:600}
.surface-action{flex-shrink:0;height:54rpx;display:flex;align-items:center;font-size:21rpx;font-weight:600}
.panel-collapse-arrow{font-size:22rpx;color:#151D17}
.setting-block{margin-top:30rpx}
.count-setting-block{padding-top:28rpx;border-top:1rpx solid #EDF0ED}
.setting-title{display:block;font-size:25rpx;line-height:1.3;font-weight:900}
.setting-desc{display:block;margin-top:5rpx;font-size:20rpx;line-height:1.4}
.mode-row,.count-row{margin-top:18rpx;display:flex}
.mode-card,.count-btn{position:relative;flex:1;min-width:0;border:1rpx solid transparent;transition:transform .15s ease,background .15s ease,color .15s ease}
.mode-card{min-height:150rpx;padding:20rpx 18rpx 18rpx;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}
.mode-title{display:block;margin-top:15rpx;font-size:23rpx;line-height:1.25;font-weight:900;white-space:nowrap}
.mode-desc{display:block;margin-top:6rpx;font-size:18rpx;line-height:1.2}
.option-check{position:absolute;right:10rpx;bottom:10rpx;width:32rpx;height:32rpx;border-radius:50%;font-size:20rpx;line-height:32rpx;text-align:center;font-weight:900}
.count-btn{min-height:102rpx;padding:20rpx 14rpx;display:flex;flex-direction:column;align-items:center;justify-content:center}
.count-main{font-size:28rpx;line-height:1.2;font-weight:600}
.count-time{margin-top:8rpx;font-size:18rpx;line-height:1.2}
.count-check{right:8rpx;bottom:8rpx}
.section-heading-row{padding:0 6rpx;align-items:center}
.surface-action{gap:5rpx}
.subject-sheet{box-sizing:border-box;display:flex;flex-direction:column;overflow:hidden}
.sheet-header{align-items:center;padding:0 4rpx;flex-shrink:0}
.sheet-close{width:44px;height:44px;flex:0 0 44px;border-radius:12rpx;border:0;color:#23483C;font-weight:400}
.subject-empty{flex:1;min-height:0;padding:24rpx 20rpx;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx}
.subject-empty-text{color:#23483C;font-size:max(28rpx,14px);font-weight:500}
.subject-empty-hint{font-size:max(24rpx,12px);line-height:1.5}
.subject-sheet .subject-discipline-swiper{width:100%;flex:0 1 46px;height:46px;min-height:0;align-self:stretch}
.subject-sheet.subject-sheet-rows-1 .subject-discipline-swiper{height:110px;flex-basis:110px}
.subject-sheet.subject-sheet-rows-2 .subject-discipline-swiper{height:182px;flex-basis:182px}
.subject-discipline-item{width:100%;height:100%;box-sizing:border-box}
.subject-sheet .subject-discipline-scroll{display:block;height:100%;width:100%;box-sizing:border-box}
.subject-discipline-page{width:100%;padding:0;box-sizing:border-box}
.subject-discipline-heading{display:flex;align-items:center;gap:8px;min-height:44px;margin-bottom:2px}
.subject-discipline-title{flex:1;min-width:0;color:#507568;font-size:max(28rpx,14px);line-height:1.4;font-weight:500;overflow-wrap:anywhere}
.subject-branch-back{display:flex;align-items:center;justify-content:center;width:44px;height:44px;flex:0 0 44px;color:#3A6F5B}
.subject-branch-icon{display:block;width:18px;height:18px}
.subject-scope-option{display:inline-flex;align-items:center;justify-content:center;gap:8rpx;box-sizing:border-box;min-width:44px;min-height:44px;flex-shrink:0;padding:0 8rpx;color:#3A6F5B;font-size:max(26rpx,14px);line-height:1.4;background:transparent}
.subject-scope-option.active{color:#23483C;font-weight:600}
.subject-scope-check{width:16px;height:16px;flex-shrink:0}
.subject-scope-pressed{opacity:.7}
.subject-options-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.subject-option{min-height:64px;padding:10px 14px;border:2rpx solid #D8EEE6;border-radius:12px;background:#FFFFFF;box-sizing:border-box}
.subject-option.active{background:#EAF9F4;border-color:#55C89B}
.subject-option-name{width:100%;font-size:max(28rpx,14px);font-weight:600;line-height:1.35;text-align:left;overflow-wrap:anywhere}
.subject-option-pressed{background:#EAF9F4;border-color:#7ED8B5}
.subject-discipline-dots{display:flex;align-items:center;justify-content:center;gap:8px;min-height:8px;margin-top:12px;margin-bottom:12px;flex-shrink:0}
.subject-discipline-dot{width:8px;height:8px;border-radius:50%;background:#C6D8CF}
.subject-discipline-dot.active{background:#3A6F5B}
.subject-sheet-footer{display:grid;grid-template-columns:minmax(0,1fr);justify-content:stretch;flex-shrink:0;width:100%;margin-top:12px;padding-top:0px}
.subject-sheet-confirm{display:flex;align-items:center;justify-content:center;width:auto;min-width:144px;max-width:100%;min-height:44px;box-sizing:border-box;margin:0;padding:12rpx 24rpx;border:0;border-radius:20rpx;background:#3A6F5B;color:#FFFFFF;font-size:max(28rpx,14px);line-height:1.4;font-weight:500}
.subject-sheet-confirm::after{border:0}
.subject-sheet-confirm[disabled]{background:#EDF3EF;color:#61796C}
.subject-sheet-confirm.subject-option-pressed{background:#315D4D}
.submit-loading-mask{position:fixed;inset:0;z-index:180;display:flex;align-items:center;justify-content:center;padding:32rpx;backdrop-filter:blur(16rpx);-webkit-backdrop-filter:blur(16rpx);box-sizing:border-box}
.submit-loading-card{position:relative;width:430rpx;padding:42rpx 36rpx 38rpx;border:1rpx solid rgba(255,255,255,.82);border-radius:38rpx;display:flex;flex-direction:column;align-items:center;overflow:hidden;box-sizing:border-box}
.submit-loading-card::before{content:'';position:absolute;top:0;left:0;right:0;height:8rpx}
.submit-loading-title{margin-top:8rpx;font-size:31rpx;line-height:1.35;font-weight:600;text-align:center}
.submit-loading-desc{margin-top:9rpx;font-size:22rpx;line-height:1.55;text-align:center}
.submit-loading-dots{margin-top:22rpx;display:flex;align-items:center;gap:9rpx}
.submit-loading-dots > view{width:8rpx;height:8rpx;border-radius:50%;animation:submitDot 1s ease-in-out infinite}
.submit-loading-dots > view:nth-child(2){animation-delay:.14s}
.submit-loading-dots > view:nth-child(3){animation-delay:.28s}

@keyframes submitDot{0%,100%{opacity:.28;transform:translateY(0)}
50%{opacity:1;transform:translateY(-7rpx)}
}
.loading-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:180rpx 0;min-height:60vh}
.loading-wrap.launch-loading{min-height:100vh;box-sizing:border-box;padding:0 0 8vh}

@media (prefers-reduced-motion:reduce){.page{opacity:1 !important}
.mode-card,.count-btn{animation:none !important;transition:none !important;transform:none !important}
}
.setup-content{padding:22rpx 24rpx calc(46rpx + env(safe-area-inset-bottom))}
.settings-panel{border-radius:34rpx}
.sheet-close{display:flex;align-items:center;justify-content:center}
.practice{height:100vh;min-height:0;overflow:hidden;box-sizing:border-box}
.practice-runner{display:block;width:100%;height:100%;min-height:0}

@media (prefers-reduced-motion:reduce){.loading-wrap.launch-loading{animation:none}
}
/* Mint setup surface: a light, focused workspace before the question flow begins. */ page,.page{background:#FAFCFB;color:#23483C}
.setup{background:#FAFCFB}
.setup-content{padding-top:18rpx}
.practice-hero{border-radius:24rpx;padding:24rpx;background:#F3F9F6;color:#23483C;border:1rpx solid #D8EEE6;box-shadow:none}
.hero-subject{color:#23483C}
.hero-subject-arrow{border-color:#BEE8D7;color:#2F8066;background:rgba(255,255,255,.72)}
.hero-number{color:#3A6F5B}
.hero-number-unit{color:#507568}
.hero-metric-label{color:#507568}
.hero-metric-divider{background:#CBEDE0}
.hero-start{background:#3A6F5B;color:#FFFFFF;border:1rpx solid #3A6F5B;box-shadow:none;font-weight:600}
.hero-start-arrow{background:#7ED8B5;color:#23483C}
.hero-start-pressed{background:#2F8066}
.hero-config{border-color:#CBEDE0;background:rgba(255,255,255,.72)}
.hero-config-text,.hero-config-edit{color:#4E7566}
.config-chevron{color:#55B990}
.settings-panel{border-color:#DFE8E2;background:#FFFFFF;box-shadow:none}
.panel-title,.surface-title,.sheet-title{color:#23483C}
.panel-collapse,.surface-action{color:#3D8068}
.setting-title{color:#2D5D4C}
.mode-row,.count-row{gap:12rpx}
.mode-card,.count-btn{border-color:#DFE8E2;border-radius:20rpx;background:#FFFFFF}
.mode-card.active,.count-btn.active{border-color:#3A6F5B;background:#EEF7F1;box-shadow:none}
.count-main{color:#3A6F5B}
.mode-title{color:#2D5D4C}
.recent-section{margin-top:28rpx}
.setup-error-card{background:#FFF6F3;border-color:#F0C3B9}
.setup-error-icon{color:#C36C5C}
.setup-error-text{color:#A85648}
.setup-error-retry{color:#FFFFFF;background:#B66758;border-radius:999rpx}
.submit-loading-mask{background:rgba(35,72,60,.3)}
.submit-loading-card{border-color:#D8EEE6;background:rgba(251,255,253,.98);box-shadow:0 24rpx 64rpx rgba(43,117,91,.18)}
.submit-loading-card::before{background:linear-gradient(90deg,#3A6F5B,#7ED8B5)}
.submit-loading-title{color:#23483C}
.submit-loading-desc{color:#78958A}
.submit-loading-dots > view{background:#3A6F5B}
.submit-loading-dots > view:nth-child(2){background:#7ED8B5}
.submit-loading-dots > view:nth-child(3){background:#55C89B}
.loading-wrap.launch-loading{background:radial-gradient(circle at 78% 18%,rgba(126,216,181,.18),transparent 34%),#F3FBF8}
.practice{background:#F3FBF8}

@media (prefers-reduced-motion:reduce){.practice-hero,.mode-card,.count-btn,.hero-start,.subject-sheet{transition:none !important}
}
/* Mint setup controls: optical centring is relative to the actual drawing box. */ .hero-subject-arrow,.hero-start-arrow,.config-chevron,.panel-collapse-arrow,.surface-action-arrow{display:inline-flex;align-items:center;justify-content:center;line-height:1;box-sizing:border-box}
.hero-subject-arrow{width:38rpx;height:38rpx;flex:0 0 38rpx;padding:0;border-radius:11rpx}
.hero-start{width:100%;margin-left:0;margin-right:0;line-height:1.4}
.hero-start-arrow{width:58rpx;height:58rpx;flex:0 0 58rpx;border-radius:50%}
.hero-chevron-image{display:block;width:16px;height:16px}
.config-chevron,.panel-collapse-arrow{width:16px;height:16px;flex:0 0 16px}
.config-chevron.up,.panel-collapse-arrow.up{transform:rotate(180deg)}
.surface-action-arrow{width:16px;height:16px;flex:0 0 16px}
.mode-card.active .mode-title,.count-btn.active .count-main{color:#23483C}
.mode-card.active .mode-desc,.count-btn.active .count-time{color:#507568}
.mode-desc,.count-time,.setting-desc{color:#507568}
.option-check,.count-check{display:flex;align-items:center;justify-content:center;background:#55C89B;color:#23483C}
.setting-check-icon{display:block;width:22rpx;height:22rpx}
/* Reference plan 2: the setup summary is a single calm control row. */ .hero-config{min-height:82rpx;padding:0 18rpx 0 14rpx;border-radius:999rpx;display:flex;align-items:center;gap:14rpx;box-sizing:border-box;box-shadow:none}
.hero-config-text{min-width:0;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:24rpx}
.hero-config-edit{display:inline-flex;align-items:center;gap:6rpx;padding:14rpx 18rpx;border-radius:999rpx;background:transparent;font-size:24rpx;font-weight:500;white-space:nowrap}
.mode-icon-image{width:42rpx;height:42rpx;display:block;flex:0 0 42rpx}
/* The Drawer surface sizes to its content; native swiper keeps a row-sized viewport. */
.subject-sheet-layer .subject-sheet{position:relative;width:100%;height:auto;max-height:80vh;min-height:0;padding:0 16px 12px;border:0;background:transparent;box-shadow:none}
.subject-sheet .sheet-header{min-height:44px;padding:0}
.subject-sheet .sheet-close{width:44px;height:44px;background:transparent}
.subject-sheet .sheet-close-icon{display:block;width:18px;height:18px}
.subject-sheet .sheet-title{font-size:max(36rpx,18px);font-weight:600}
/* (1,4) motion-sheet owns the sole background, bounds and gesture transform. */
.subject-sheet-layer{position:static;pointer-events:none}
.hero-subject-action.motion-press{border-radius:999rpx}
.reward-strip{display:flex;align-items:center;gap:12rpx;margin-top:16rpx;padding:16rpx 4rpx}
.reward-strip-icon{width:28rpx;height:28rpx;flex-shrink:0}
.reward-strip-text{min-width:0;color:#507568;font-size:24rpx;line-height:1.6;white-space:normal}
.recent-section .surface-title{color:#23483C;font-size:30rpx;line-height:1.3}
.recent-scroll{margin-top:14rpx;width:100%;white-space:nowrap;overflow:hidden}
.recent-list{display:inline-flex;gap:14rpx;padding:2rpx 2rpx 16rpx}
.recent-card{position:relative;box-sizing:border-box;width:280rpx;height:88rpx;padding:12rpx 16rpx;display:inline-flex;align-items:center;gap:12rpx;overflow:hidden;border:1rpx solid #DCEEE6;border-radius:999rpx;background:#FAFFFD;box-shadow:none;transition:transform 150ms cubic-bezier(.16,1,.3,1),opacity 150ms ease}
.recent-card.active{border-color:#3A6F5B;background:#3A6F5B}
.recent-mark{width:48rpx;height:48rpx;border-radius:50%;background:#E3F5EE;color:#245D4D;font-size:23rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;line-height:1;font-weight:700}
.recent-card.active .recent-mark{background:rgba(126,216,181,.22);color:#FFF}
.recent-subject-icon{width:28rpx;height:28rpx}
.recent-card.active .recent-subject-icon{filter:brightness(0) invert(1)}
.recent-card-copy{flex:1;min-width:0}
.recent-name{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#23483C;font-size:24rpx;line-height:1.4;font-weight:600}
.recent-card.active .recent-name{color:#FFF}
.recent-card.recent-card-pressed{opacity:.9;transform:scale(.98)}

@media (prefers-reduced-motion:reduce){.recent-card,.recent-card.recent-card-pressed{transition:none;transform:none}
}
/* Mint controls keep readable labels and separate selection marks from copy. */
.practice-hero{border-radius:24rpx;box-shadow:none}
.hero-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.hero-mode{display:flex;align-items:center;gap:8rpx;flex-shrink:0;color:#507568;font-size:22rpx}
.hero-mode image{width:28rpx;height:28rpx}
.hero-subject-action{min-width:0;flex:1;max-width:none;min-height:88rpx;gap:12rpx;margin-top:0}
.hero-subject{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:32rpx;line-height:1.45}
.hero-metrics{margin-top:8rpx;min-height:112rpx;padding:0 0 8rpx}
.hero-number-line{height:64rpx}
.hero-number{font-size:60rpx;letter-spacing:0}
.hero-number-small{font-size:48rpx;letter-spacing:0}
.hero-metric-divider{height:64rpx;margin:0 24rpx}
.hero-start{height:88rpx;margin-top:24rpx;border-radius:20rpx;padding:0 16rpx 0 24rpx;justify-content:space-between}
.hero-start-arrow{width:48rpx;height:48rpx;flex-basis:48rpx}
.hero-config{min-height:88rpx;margin-top:8rpx;padding:0;border:0;border-radius:0;background:transparent}
.hero-config-edit{padding:0;min-height:88rpx}
.hero-metric-label{font-size:24rpx;font-weight:400;letter-spacing:0;line-height:1.5}
.hero-config-edit,.panel-collapse,.surface-action{min-height:88rpx;box-sizing:border-box}
.mode-title,.setting-title,.panel-title,.surface-title,.sheet-title{font-weight:600}
.mode-desc,.count-time,.setting-desc{font-size:22rpx;line-height:1.5}
.mode-card{min-height:152rpx;padding:20rpx 12rpx 16rpx;box-sizing:border-box;justify-content:flex-start}

.mode-icon-image{width:32rpx;height:32rpx;flex-basis:32rpx}
.mode-desc{min-height:0;font-size:21rpx;line-height:1.4}
.mode-title{margin-top:12rpx;font-size:24rpx}
.option-check{top:12rpx;right:12rpx;bottom:auto}
.count-btn{min-height:112rpx;padding:24rpx 8rpx 16rpx;box-sizing:border-box}
.count-check{top:8rpx;right:8rpx;width:26rpx;height:26rpx;bottom:auto}
.count-check .setting-check-icon{width:18rpx;height:18rpx}
.subject-empty-hint,.submit-loading-desc{color:#507568}
.setup-error-icon{width:36rpx;height:36rpx;flex:0 0 36rpx}
.setup-error-retry{min-height:88rpx;display:flex;align-items:center;justify-content:center;line-height:1.4}
