page {
  min-height: 100vh;
  background: #FAFCFB;
  color: #23483C;
}

::-webkit-scrollbar {
  width: 6px;
  height: 6px;
  background: transparent;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  border-radius: 999rpx;
  background: #D8EEE6;
}

::-webkit-scrollbar-thumb:hover {
  background: #A8D5C2;
}

.plan-page {
  min-height: 100vh;
  overflow-x: hidden;
  background: #FAFCFB;
}

.plan-shell {
  box-sizing: border-box;
  width: 100%;
  padding: 12rpx 24rpx calc(168rpx + env(safe-area-inset-bottom));
}

.plan-intro {
  padding: 24rpx 4rpx 34rpx;
}

.plan-intro-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.plan-intro-icon,
.state-icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #D8EEE6;
  border-radius: 18rpx;
  background: #F3F9F6;
}

.plan-intro-icon image,
.state-icon image {
  display: block;
  width: 32rpx;
  height: 32rpx;
}

.plan-intro-title {
  display: block;
  min-width: 0;
  color: #23483C;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 600;
}

.plan-intro-desc {
  display: block;
  margin-top: 18rpx;
  color: #507568;
  font-size: 24rpx;
  line-height: 1.65;
}

.state-card,
.settings-card,
.strategy-card,
.explain-card {
  box-sizing: border-box;
  border: 1rpx solid #DFE8E2;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.state-card {
  display: flex;
  min-height: 180rpx;
  margin: 20rpx 24rpx 0;
  padding: 36rpx 28rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #507568;
  font-size: 23rpx;
  line-height: 1.55;
  text-align: center;
}

.plan-shell > .state-card {
  margin-right: 0;
  margin-left: 0;
}

.plan-loading-card {
  min-height: 240rpx;
}

.state-icon-image {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.state-message {
  max-width: 560rpx;
}

.state-retry {
  min-width: 176rpx;
  min-height: 88rpx;
  margin: 4rpx 0 0;
  padding: 0 26rpx;
  border: 0;
  border-radius: 18rpx;
  background: #3A6F5B;
  color: #FFFFFF;
  font-size: 23rpx;
  line-height: 88rpx;
}

.state-retry::after {
  border: 0;
}

.error-card {
  color: #9A5044;
}

.plan-overview-card {
  box-sizing: border-box;
  padding: 28rpx;
  overflow: hidden;
  border: 1rpx solid #D8EEE6;
  border-radius: 24rpx;
  background: #F3F9F6;
  color: #23483C;
}

.overview-topline,
.overview-progress-row,
.overview-progress-foot,
.overview-metrics,
.settings-head,
.strategy-head,
.strategy-subject,
.strategy-controls,
.section-head,
.allocation-topline,
.allocation-metrics,
.explain-head {
  display: flex;
  align-items: center;
}

.overview-topline {
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.overview-label {
  color: #3A6F5B;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 600;
}

.overview-target {
  display: flex;
  min-width: 0;
  flex: 0 1 auto;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  text-align: right;
}

.overview-target text:first-child {
  color: #78958A;
  font-size: 17rpx;
  line-height: 1.3;
}

.overview-target text:last-child {
  color: #3A6F5B;
  font-size: 20rpx;
  line-height: 1.4;
  font-weight: 500;
}

.overview-title {
  display: block;
  max-width: 570rpx;
  margin-top: 24rpx;
  color: #23483C;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 600;
}

.overview-desc {
  display: block;
  margin-top: 10rpx;
  color: #507568;
  font-size: 22rpx;
  line-height: 1.55;
}

.overview-progress-row {
  justify-content: space-between;
  margin-top: 30rpx;
  color: #2D5D4C;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 500;
}

.overview-progress-track {
  height: 10rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #D8EEE6;
}

.overview-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #3A6F5B;
  transition: width 240ms cubic-bezier(.16, 1, .3, 1);
}

.overview-progress-foot {
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 12rpx;
  color: #657E73;
  font-size: 18rpx;
  line-height: 1.55;
}

.overview-progress-foot > text:first-child {
  min-width: 0;
  flex: 1;
}

.overview-percent {
  flex: 0 0 auto;
  color: #3A6F5B;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.overview-metrics {
  margin-top: 24rpx;
  padding-top: 22rpx;
  align-items: stretch;
  border-top: 1rpx solid #D8EEE6;
}

.overview-metric {
  min-width: 0;
  flex: 1;
}

.overview-metric-value,
.overview-metric-label {
  display: block;
}

.overview-metric-value {
  color: #2D5D4C;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.overview-metric-unit {
  margin-left: 4rpx;
  color: #507568;
  font-size: 18rpx;
  font-weight: 400;
}

.overview-metric-label {
  margin-top: 8rpx;
  color: #78958A;
  font-size: 18rpx;
  line-height: 1.4;
}

.overview-divider {
  width: 1rpx;
  margin: 2rpx 22rpx;
  flex: 0 0 1rpx;
  background: #D8EEE6;
}

.settings-card {
  margin-top: 20rpx;
  padding: 26rpx 24rpx 8rpx;
  overflow: visible;
}

.settings-head {
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 2rpx 12rpx;
}

.settings-title,
.strategy-title,
.section-title {
  display: block;
  color: #23483C;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 600;
}

.settings-status {
  flex: 0 0 auto;
  color: #78958A;
  font-size: 20rpx;
  line-height: 1.4;
}

.settings-list {
  width: 100%;
}

.setting-picker {
  display: block;
  width: 100%;
}

.setting-row {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 116rpx;
  padding: 18rpx 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #EDF2EF;
  transition: opacity 150ms ease, background-color 150ms ease;
}

.setting-row-last {
  border-bottom: 0;
}

.setting-row-pressed {
  border-radius: 16rpx;
  background: #F3F9F6;
  opacity: .82;
}

.setting-icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #F3F9F6;
}

.setting-icon image {
  display: block;
  width: 30rpx;
  height: 30rpx;
}

.setting-copy {
  min-width: 0;
  flex: 1;
}

.setting-label,
.setting-desc,
.setting-value {
  display: block;
}

.setting-label {
  color: #23483C;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 500;
}

.setting-desc {
  margin-top: 4rpx;
  color: #78958A;
  font-size: 19rpx;
  line-height: 1.45;
}

.setting-value {
  max-width: 190rpx;
  flex: 0 0 auto;
  color: #3A6F5B;
  font-size: 21rpx;
  line-height: 1.45;
  font-weight: 500;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.setting-value.is-placeholder {
  color: #9AAEA5;
}

.setting-chevron {
  display: block;
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
}

.plan-switch {
  flex: 0 0 auto;
  transform: scale(.84);
  transform-origin: right center;
}

.pause-link {
  min-height: 88rpx;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid #EDF2EF;
  color: #657E73;
  font-size: 21rpx;
  line-height: 1.4;
}

.pause-link-pressed {
  color: #9A5044;
  opacity: .76;
}

.strategy-card {
  margin-top: 20rpx;
  padding: 26rpx 24rpx 18rpx;
}

.strategy-head {
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.strategy-total {
  flex: 0 0 auto;
  color: #3A6F5B;
  font-size: 20rpx;
  line-height: 1.5;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.strategy-total.is-invalid {
  color: #A35D4E;
}

.strategy-note {
  display: block;
  margin-top: 10rpx;
  color: #78958A;
  font-size: 20rpx;
  line-height: 1.55;
}

.strategy-list {
  margin-top: 10rpx;
}

.strategy-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EDF2EF;
}

.strategy-row:last-child {
  padding-bottom: 4rpx;
  border-bottom: 0;
}

.strategy-subject {
  justify-content: space-between;
  gap: 16rpx;
}

.strategy-name {
  color: #2D5D4C;
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 500;
}

.strategy-weight {
  color: #3A6F5B;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.strategy-controls {
  display: grid;
  grid-template-columns: 200rpx minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 12rpx;
}

.strategy-stage-picker {
  width: 200rpx;
  flex: 0 0 200rpx;
}

.strategy-stage {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  border: 1rpx solid #DFE8E2;
  border-radius: 16rpx;
  background: #FAFCFB;
  color: #507568;
  font-size: 19rpx;
  line-height: 1.35;
}

.strategy-stage text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.strategy-stage image {
  display: block;
  width: 26rpx;
  height: 26rpx;
  flex: 0 0 26rpx;
}

.strategy-slider {
  width: 100%;
  height: 88rpx;
  margin: 0;
}

.strategy-warning {
  display: block;
  margin-top: 6rpx;
  color: #A35D4E;
  font-size: 18rpx;
  line-height: 1.5;
  text-align: right;
}

.allocation-section {
  margin-top: 28rpx;
}

.section-head {
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 4rpx 14rpx;
}

.section-note {
  max-width: 270rpx;
  color: #78958A;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: right;
}

.allocation-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.allocation-card {
  box-sizing: border-box;
  min-height: 120rpx;
  padding: 22rpx 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  border: 1rpx solid #DFE8E2;
  border-radius: 24rpx;
  background: #FFFFFF;
  transition: background-color 150ms ease, border-color 150ms ease;
}

.allocation-card.is-actionable {
  border-color: #D0E9DF;
}

.allocation-code {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #F3F9F6;
  color: #3A6F5B;
  font-size: 21rpx;
  line-height: 1;
  font-weight: 600;
}

.allocation-main {
  min-width: 0;
  flex: 1;
}

.allocation-topline {
  justify-content: space-between;
  gap: 14rpx;
}

.allocation-label {
  flex: 0 0 auto;
  color: #507568;
  font-size: 20rpx;
  line-height: 1.4;
  font-weight: 500;
}

.allocation-status {
  min-width: 0;
  color: #78958A;
  font-size: 18rpx;
  line-height: 1.4;
  text-align: right;
}

.status-done {
  color: #3A7D63;
}

.allocation-title {
  display: block;
  margin-top: 6rpx;
  color: #23483C;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 500;
}

.allocation-reason {
  display: block;
  margin-top: 7rpx;
  color: #657E73;
  font-size: 20rpx;
  line-height: 1.55;
}

.allocation-metrics {
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 8rpx 20rpx;
  margin-top: 12rpx;
  color: #78958A;
  font-size: 18rpx;
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
}

.allocation-arrow {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-top: 6rpx;
  flex: 0 0 32rpx;
}

.allocation-pressed {
  border-color: #C6E3D7;
  background: #F3F9F6;
}

.explain-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.explain-head {
  justify-content: flex-start;
  gap: 12rpx;
}

.explain-icon {
  display: block;
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
}

.explain-title {
  color: #2D5D4C;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 500;
}

.explain-text {
  display: block;
  margin-top: 12rpx;
  color: #657E73;
  font-size: 20rpx;
  line-height: 1.72;
}

.fab-drag-layer {
  position: fixed;
  z-index: 70;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}

.fab-drag-view {
  position: relative;
  display: flex;
  width: 120rpx;
  height: 120rpx;
  align-items: center;
  justify-content: center;
  overflow: visible;
  pointer-events: auto;
}

.save-fab {
  box-sizing: border-box;
  width: 104rpx;
  min-width: 104rpx;
  height: 104rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: #3A6F5B;
  box-shadow: 0 12rpx 30rpx rgba(23, 61, 48, .18);
  transition: opacity 200ms ease, transform 220ms cubic-bezier(.16, 1, .3, 1), background-color 150ms ease, box-shadow 150ms ease;
}

.save-fab-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
}

.save-fab-loading {
  color: #FFFFFF;
  font-size: 36rpx;
  line-height: 1;
}

.save-fab-pressed {
  background: #2F8066;
  transform: scale(.94);
}

.save-fab.is-saving {
  opacity: .72;
}

.fab-drag-view.fab-idle .save-fab {
  opacity: .28;
  transform: scale(.8);
  box-shadow: none;
}

.guest-plan-empty {
  margin: 20rpx 24rpx 0;
  padding: 48rpx 28rpx;
}

.guest-plan-title {
  display: block;
  color: #23483C;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 600;
}

.guest-plan-desc {
  display: block;
  margin-top: 12rpx;
  color: #507568;
  font-size: 21rpx;
  line-height: 1.6;
}

@media (max-width: 350px) {
  .plan-shell {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }

  .plan-intro-title {
    font-size: 38rpx;
  }

  .settings-card,
  .strategy-card,
  .explain-card {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }

  .setting-row {
    gap: 12rpx;
  }

  .setting-icon {
    width: 58rpx;
    height: 58rpx;
    flex-basis: 58rpx;
  }

  .setting-label {
    font-size: 24rpx;
  }

  .setting-value {
    max-width: 155rpx;
    font-size: 19rpx;
  }

  .strategy-stage-picker {
    width: 174rpx;
    flex-basis: 174rpx;
  }

  .strategy-controls {
    gap: 12rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .overview-progress-fill,
  .setting-row,
  .allocation-card,
  .save-fab {
    transition: none !important;
  }
}
