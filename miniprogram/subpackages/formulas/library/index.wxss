@import '../../../styles/tokens.wxss';
@import '../utils/katex/katex.wxss';
@import '../utils/katex/katex-fonts-1.wxss';
@import '../utils/katex/katex-fonts-2.wxss';
@import '../utils/katex/katex-fonts-3.wxss';

page {
  min-height: 100vh;
  background: #F3FBF8;
  color: #23483C;
}

.fl-page {
  min-height: 100vh;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  background: #F3FBF8;
}
button { box-sizing: border-box; }
button::after { border: 0; }

.fl-content { padding: 10rpx 32rpx 0; }
.fl-results { min-height: calc(100vh - 300px); overflow-anchor: none; }
.fl-pressed { opacity: .74; transform: scale(.985); }

.fl-sticky-tools {
  position: sticky;
  z-index: 72;
  width: calc(100% + 64rpx);
  margin-left: -32rpx;
  padding: 8rpx 32rpx 10rpx;
  box-sizing: border-box;
  background: #F3FBF8;
}
.fl-filter-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.fl-subject-select {
  min-width: 0;
  min-height: 44px;
  flex: 1;
  padding: 0 2rpx;
  display: flex;
  align-items: center;
  gap: 8px;
}
.fl-subject-select-name { min-width: 0; color: #23483C; font-size: 14px; line-height: 1.4; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fl-control-chevron { width: 22rpx; height: 22rpx; color: #507568; flex-shrink: 0; }

.fl-library-switch {
  min-width: 0;
  min-height: 44px;
  padding: 0;
  display: flex;
  gap: 12px;
  box-sizing: border-box;
}
.fl-library-tab {
  position: relative;
  min-width: 44px;
  min-height: 44px;
  color: #507568;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 400;
}
.fl-library-tab.active { color: #23483C; font-weight: 500; }
.fl-library-tab.active::after { content: ''; position: absolute; bottom: 2px; left: 0; right: 0; height: 2px; border-radius: 2px; background: #3A6F5B; }
.fl-library-tab-name { white-space: nowrap; }

.fl-search-box {
  min-width: 0;
  min-height: 44px;
  padding: 0 0 0 18rpx;
  border: 1rpx solid #D8EEE6;
  border-radius: 22rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  gap: 15rpx;
}
.fl-search-input { flex: 1; min-width: 0; min-height: 44px; color: #23483C; font-size: max(26rpx, 14px); font-weight: 400; }
.fl-search-placeholder { color: #507568; font-weight: 400; }
.fl-search-clear { min-width: 44px; min-height: 44px; color: #507568; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.fl-search-clear .fl-ui-icon { width: 24rpx; height: 24rpx; transform: scale(.75); }
.fl-reading-tools { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 12px; }
.fl-mode-switch { width: 140px; display: flex; border-radius: 10px; background: #E5F0E9; }
.fl-mode-tab { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 44px; margin: 0; padding: 0 12px; border: 0; border-radius: 10px; background: transparent; color: #4F6C5C; font-size: 14px; line-height: 1.5; font-weight: 400; }
.fl-mode-tab.is-active { background: #D8EEE3; color: #23483C; font-weight: 500; }
.fl-filter-button { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; min-width: 72px; padding: 0 4px 0 12px; margin: 0; border: 0; border-radius: 8px; background: transparent; color: #315D49; font-size: 14px; line-height: 1.5; font-weight: 400; }
.fl-filter-dot { width: 5px; height: 5px; border-radius: 50%; background: #3A6F5B; }
.fl-filter-button:focus-visible, .fl-mode-tab:focus-visible, .fl-random-action:focus-visible { outline: 2px solid #3A6F5B; outline-offset: 2px; }

.fl-active-tags { margin-top: 8px; display: flex; align-items: center; flex-wrap: wrap; gap: 4px 12px; }
.fl-active-tag { min-height: 44px; max-width: 100%; padding: 0 2px; color: #3A6F5B; display: flex; align-items: center; gap: 6px; font-size: 13px; line-height: 1.5; overflow-wrap: anywhere; }
.fl-active-tag-close { font-size: 18px; line-height: 1; color: #507568; }

.fl-list-head { margin: 16px 2rpx 14rpx; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.fl-list-caption { min-width: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; }
.fl-list-title { color: #23483C; font-size: 16px; font-weight: 500; }
.fl-list-meta { color: #507568; font-size: 12px; font-weight: 400; font-variant-numeric: tabular-nums; }
.fl-random-action { min-height: 44px; flex-shrink: 0; padding: 0 12px; margin: 0; border: 0; border-radius: 10px; background: #D8EEE3; color: #23483C; font-size: 13px; line-height: 44px; font-weight: 500; }
.fl-list { display:flex; flex-direction:column; gap:16rpx; }
.fl-list-entry { position:relative; opacity:1; transform-origin:50% 100%; }
.fl-list-entry::before,
.fl-list-entry::after {
  content:'';
  position:absolute;
  z-index:0;
  border:1rpx solid #D8EEE6;
  border-radius:30rpx;
  pointer-events:none;
  box-sizing:border-box;
  transform-origin:50% 100%;
}
.fl-list-entry::before {
  left:10rpx;
  right:10rpx;
  top:12rpx;
  bottom:-10rpx;
  background:#E4F2EC;
  opacity:.52;
}
.fl-list-entry::after {
  z-index:1;
  left:20rpx;
  right:20rpx;
  top:6rpx;
  bottom:-5rpx;
  background:#F4FBF7;
  opacity:.78;
}
.fl-graph-list .fl-list-entry::before,
.fl-graph-list .fl-list-entry::after { border-radius:32rpx; }
.fl-list-entry-pending { opacity:.45; }
.fl-list-entry-pending::before,
.fl-list-entry-pending::after { opacity:0; }
.fl-list-entry-rise { animation:fl-list-entry-rise 540ms cubic-bezier(.16, 1, .3, 1) both; will-change:transform, opacity; }
.fl-list-entry-fade { animation:fl-list-entry-fade 540ms cubic-bezier(.16, 1, .3, 1) both; will-change:opacity; }
.fl-list-entry-rise::before,
.fl-list-entry-fade::before {
  animation:fl-list-entry-stack-back 540ms cubic-bezier(.16, 1, .3, 1) both;
  animation-delay:inherit;
  will-change:transform, opacity;
}
.fl-list-entry-rise::after,
.fl-list-entry-fade::after {
  animation:fl-list-entry-stack-front 540ms cubic-bezier(.16, 1, .3, 1) both;
  animation-delay:inherit;
  will-change:transform, opacity;
}
@keyframes fl-list-entry-rise {
  0%, 12% { opacity: .08; transform: translate3d(0, 30px, 0) scale(.95); }
  62% { opacity: .96; transform: translate3d(0, 3px, 0) scale(.997); }
  to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}
@keyframes fl-list-entry-fade {
  0%, 12% { opacity: .22; }
  62% { opacity: .92; }
  to { opacity: 1; }
}
@keyframes fl-list-entry-stack-back {
  from { opacity: 0; transform: translate3d(0, 16px, 0) scaleX(.93); }
  38% { opacity: .34; transform: translate3d(0, 6px, 0) scaleX(.982); }
  to { opacity: .52; transform: translate3d(0, 0, 0) scaleX(1); }
}
@keyframes fl-list-entry-stack-front {
  0%, 18% { opacity: 0; transform: translate3d(0, 12px, 0) scaleX(.965); }
  58% { opacity: .58; transform: translate3d(0, 3px, 0) scaleX(.995); }
  to { opacity: .78; transform: translate3d(0, 0, 0) scaleX(1); }
}
.fl-card { position:relative; z-index:2; padding:25rpx 24rpx 21rpx; border:1rpx solid #D8EEE6; border-radius:30rpx; background:#FFFFFF; box-shadow:0 10rpx 28rpx rgba(43,117,91,.045); transition:transform .15s ease, opacity .15s ease; }
.fl-card-pressed { opacity:.78; transform:scale(.989); }
.fl-card-head { display:flex; align-items:flex-start; gap:18rpx; }
.fl-card-title-wrap { flex:1; min-width:0; }
.fl-card-title { display:block; padding-top:3rpx; color:#23483C; font-size:29rpx; line-height:1.35; font-weight:900; }
.fl-card-title-rich { width:100%; min-width:0; overflow-wrap:anywhere; word-break:break-word; }
.fl-card-title-rich .katex { display:inline-block; width:auto; max-width:100%; overflow-x:auto; overflow-y:hidden; color:inherit; font-size:1em; line-height:1.08; vertical-align:-0.08em; white-space:nowrap; }
.fl-card-title-rich .katex-html,
.fl-card-title-rich .base { display:inline-block; width:auto; white-space:nowrap; }
.fl-card-tags { margin-top:10rpx; display:flex; flex-wrap:wrap; gap:8rpx; }
.fl-card-tag { padding:5rpx 12rpx; border-radius:999rpx; background:#F6FCF9; color:#507568; font-size:18rpx; line-height:1.2; font-weight:800; }
.fl-card-tag.tag-function-graph { background: #E0EDDD; color: #3A6F5B; }
.fl-card-thumb { margin-top:14rpx; border:1rpx solid #D8EEE6; border-radius:18rpx; overflow:hidden; background:#F6FCF9; }
.fl-card-thumb-img { width:100%; height:180rpx; display:block; }
.fl-card-tag.tag-high_frequency { background:#FFF3DF; color:#A96518; }
.fl-card-tag.tag-error_prone { background:#FDEBE8; color:#B24F43; }
.fl-card-tag.tag-must_memorize { background:#F0EBF6; color:#735C8A; }
.fl-favorite-btn { width:88rpx; height:88rpx; margin:-12rpx -12rpx 0 0; border:0; border-radius:20rpx; background:transparent; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.fl-favorite-btn .ui-lock { margin:0; width:30rpx; height:30rpx; }
.fl-favorite-btn.active { border-color:#7ED8B5; background:#EAF9F4; }
.fl-card-formula { margin-top:19rpx; padding:18rpx 19rpx; border:1rpx solid #D8EEE6; border-radius:20rpx; background:#F6FCF9; display:flex; flex-direction:column; gap:9rpx; overflow:hidden; }
.fl-formula-line { min-width:0; display:flex; align-items:baseline; gap:10rpx; }
.fl-formula-label { flex-shrink:0; color:#507568; font-size:18rpx; font-weight:750; }
.fl-card-latex { min-width:0; color:#23483C; font-size:23rpx; line-height:1.55; font-family:Menlo,Consolas,monospace; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.fl-card-foot { margin-top:17rpx; display:flex; align-items:center; justify-content:space-between; gap:14rpx; }
.fl-card-hint { color:#507568; font-size:19rpx; line-height:1.4; }
.fl-card-arrow { width:24rpx; height:24rpx; color:#507568; flex-shrink:0; }

.fl-graph-list { gap:22rpx; }
.fl-card-graph { padding:24rpx 22rpx 22rpx; border-radius:32rpx; }
.fl-card-graph .fl-card-title { font-size:28rpx; }
.fl-graph-preview { margin-top:19rpx; min-height:360rpx; border:1rpx solid #D8EEE6; border-radius:24rpx; overflow:hidden; background:
  linear-gradient(rgba(33,72,45,.035) 1rpx, transparent 1rpx),
  linear-gradient(90deg, rgba(33,72,45,.035) 1rpx, transparent 1rpx),
  #F6FCF9; background-size:40rpx 40rpx; display:flex; align-items:center; justify-content:center; }
.fl-graph-preview-img { width:100%; height:360rpx; display:block; background:rgba(255,255,255,.74); }
.fl-graph-placeholder { width:100%; min-height:360rpx; padding:48rpx 28rpx; box-sizing:border-box; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; }
.fl-graph-placeholder-title { margin-top:20rpx; color:#3A6F5B; font-size:25rpx; font-weight:900; }
.fl-graph-placeholder-desc { margin-top:7rpx; color:#507568; font-size:19rpx; }
.fl-card-graph .fl-card-foot { margin-top:19rpx; }

.fl-loading, .fl-empty { min-height:430rpx; padding:70rpx 28rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; }
.fl-loading-ring { width:52rpx; height:52rpx; border:5rpx solid #D8EEE6; border-top-color:#55C89B; border-radius:50%; animation:flSpin .8s linear infinite; }
@keyframes flSpin { to { transform:rotate(360deg); } }
.fl-state-icon { width:82rpx; height:82rpx; border-radius:26rpx; background:#EAF9F4; color:#3A6F5B; display:flex; align-items:center; justify-content:center; }
.fl-state-icon.fl-state-error { background:#FCECE8; color:#C55A4E; }
.fl-state-icon .fl-ui-icon { width:34rpx; height:34rpx; }
.fl-state-title { margin-top:20rpx; color:#23483C; font-size:27rpx; font-weight:900; }
.fl-state-desc { margin-top:7rpx; color:#507568; font-size:21rpx; }
.fl-reload-btn { margin-top:24rpx; min-width:190rpx; height:70rpx; padding:0 28rpx; border-radius:22rpx; background:#7ED8B5; color:#23483C; font-size:24rpx; line-height:70rpx; font-weight:900; }
.fl-loading-more { padding:28rpx 0 8rpx; color:#507568; font-size:20rpx; display:flex; align-items:center; justify-content:center; gap:10rpx; }
.fl-loading-dot { width:12rpx; height:12rpx; border-radius:50%; background:#55C89B; animation:flPulse .9s ease-in-out infinite alternate; }
@keyframes flPulse { from { opacity:.35; transform:scale(.78); } to { opacity:1; transform:scale(1); } }

.fl-bottom-sheet,
.fl-tag-sheet {
  width: 100%;
  max-height: 72vh;
  padding: 13rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #F3FBF8;
  box-sizing: border-box;
}
.motion-sheet-panel { position: relative; inset: auto; transform: none; animation: none; border-top-left-radius: 0; border-top-right-radius: 0; }
.fl-sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.fl-sheet-title { display: block; color: #23483C; font-size: 32rpx; font-weight: 900; }
.fl-sheet-subtitle { display: block; margin-top: 6rpx; color: #507568; font-size: 21rpx; }
.fl-sheet-close { min-width: 44px; min-height: 44px; border-radius: 50%; color: #507568; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.fl-sheet-close .fl-ui-icon { width: 26rpx; height: 26rpx; transform: scale(.8); }

.fl-subject-options { margin-top: 25rpx; display: flex; flex-direction: column; gap: 12rpx; }
.fl-subject-option { min-height: 84rpx; padding: 0 20rpx; border: 1rpx solid #D8EEE6; border-radius: 24rpx; background: #FFFFFF; color: #507568; display: flex; align-items: center; gap: 16rpx; }
.fl-subject-option.active { border-color: #7ED8B5; background: #EAF9F4; color: #3A6F5B; }
.fl-subject-option-mark { width: 36rpx; height: 36rpx; border-radius: 12rpx; background: #F6FCF9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.fl-subject-option-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #507568; }
.fl-subject-option.active .fl-subject-option-mark { background: #7ED8B5; }
.fl-subject-option.active .fl-subject-option-dot { background: #23483C; }
.fl-subject-option-name { flex: 1; font-size: 25rpx; font-weight: 900; }
.fl-subject-option .fl-ui-icon { width: 26rpx; height: 26rpx; color: #3A6F5B; }

.fl-more-sheet { height: 72vh; display: flex; flex-direction: column; }
.fl-more-sheet .fl-sheet-head { align-items: center; flex-shrink: 0; }
.fl-more-sheet .fl-sheet-title { font-size: 18px; font-weight: 500; }
.fl-filter-body { height: 0; flex: 1; min-height: 0; margin-top: 8px; }
.fl-filter-section { padding: 12px 0 18px; }
.fl-filter-heading { display: block; margin-bottom: 10px; color: #23483C; font-size: 14px; line-height: 1.5; font-weight: 500; }
.fl-chapter-row, .fl-study-type-row { display: flex; flex-wrap: wrap; gap: 8px; }
.fl-chapter-chip { display: flex; align-items: center; flex-wrap: wrap; min-height: 44px; max-width: 100%; padding: 8px 12px; box-sizing: border-box; border: 1rpx solid #D8EEE6; border-radius: 8px; background: #FFFFFF; color: #4F6C5C; font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; }
.fl-study-type-chip { display: flex; align-items: center; justify-content: center; min-height: 44px; max-width: 100%; padding: 8px 12px; box-sizing: border-box; border: 1rpx solid #D8EEE6; border-radius: 8px; background: #FFFFFF; color: #4F6C5C; font-size: 14px; line-height: 1.5; }
.fl-chapter-chip.active, .fl-study-type-chip.active { border-color: #D8EEE3; background: #D8EEE3; color: #23483C; }
.fl-chapter-count { margin-left: 4px; color: #4F6C5C; font-size: 12px; }
.fl-filter-options { border-top: 1rpx solid #D8EEE6; padding-bottom: 8px; }
.fl-filter-option { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 8px 0; margin: 0; border: 0; border-radius: 0; box-sizing: border-box; background: transparent; color: #23483C; font-size: 14px; line-height: 1.5; text-align: left; }
.fl-filter-option[disabled] { background: transparent; color: #507568; }
.fl-filter-option .fl-ui-icon { width: 16px; height: 16px; color: #3A6F5B; flex-shrink: 0; }
.fl-filter-option-end { display: flex; align-items: center; gap: 8px; }
.fl-filter-value { color: #507568; font-size: 13px; }
.fl-filter-footer { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; flex-shrink: 0; padding-top: 12px; border-top: 1rpx solid #D8EEE6; }
.fl-filter-reset { min-height: 44px; width: 100%; padding: 0 12px; margin: 0; border: 0; border-radius: 10px; background: transparent; color: #3A6F5B; font-size: 14px; line-height: 44px; }
.fl-filter-reset[disabled] { background: transparent; color: #507568; opacity: .6; }
.fl-filter-done { min-height: 44px; width: 100%; padding: 0 12px; margin: 0; border: 0; border-radius: 10px; background: #D8EEE3; color: #23483C; font-size: 14px; line-height: 44px; font-weight: 500; }

.fl-tag-grid { max-height: 42vh; margin-top: 25rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; overflow-y: auto; }
.fl-tag-item { min-height: 74rpx; padding: 0 20rpx; border: 1rpx solid #D8EEE6; border-radius: 21rpx; background: #FFFFFF; color: #507568; font-size: 23rpx; font-weight: 800; display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.fl-tag-item.active { border-color: #7ED8B5; background: #EAF9F4; color: #3A6F5B; }
.fl-tag-item .fl-ui-icon { width: 24rpx; height: 24rpx; color: #3A6F5B; }
.fl-sheet-done { margin-top: 24rpx; height: 84rpx; border-radius: 25rpx; background: #7ED8B5; color: #23483C; font-size: 27rpx; line-height: 84rpx; text-align: center; font-weight: 900; }

@media (max-width:360px) {
  .fl-content { padding-left:24rpx; padding-right:24rpx; }
  .fl-sticky-tools { width:calc(100% + 48rpx); margin-left:-24rpx; padding-left:24rpx; padding-right:24rpx; }
  .fl-graph-preview, .fl-graph-placeholder { min-height:320rpx; }
  .fl-graph-preview-img { height:320rpx; }
}

@media (prefers-reduced-motion:reduce) {
  .fl-list-entry { opacity: 1 !important; transform: none !important; animation: none !important; }
  .fl-list-entry::before,
  .fl-list-entry::after { animation: none !important; transform: none !important; will-change: auto !important; }
  .fl-subject-select, .fl-library-tab, .fl-card, .fl-bottom-sheet, .fl-tag-sheet, .fl-loading-ring, .fl-loading-dot { transition:none!important; animation:none!important; }
}

/* ==================== Phase 2.3 cleaner list cards ==================== */
.fl-card { padding-bottom: 23rpx; }
.fl-card-foot {
  margin-top: 20rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid #F6FCF9;
}

.fl-card-tag.tag-study-type { background:#EAF9F4; color:#3A6F5B; }

/* Native images from the official Lucide source; geometry lives in the SVGs. */
.fl-ui-icon{display:block;width:20px;height:20px;flex:0 0 20px;}
.fl-search-icon,.fl-bookmark-icon{display:block;width:20px;height:20px;flex:0 0 20px;border:0;}
.fl-graph-placeholder-icon{display:block;width:40px;height:40px;opacity:.7;}
.fl-active-tag-close{display:block;width:14px;height:14px;flex:0 0 14px;}
