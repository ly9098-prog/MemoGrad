<app-dialog id="appDialog" theme="mint"></app-dialog>
<view class="fl-page">
  <premium-nav title="速记卡" variant="mint" bind:back="goBack" />

  <view class="fl-content {{contentReady ? 'route-enter-page' : ''}}">
    <view class="fl-sticky-tools" style="top: {{navHeight}}px;">
      <view class="fl-filter-row">
        <view class="fl-subject-select" hover-class="fl-pressed" bindtap="toggleSubjectPicker" role="button" aria-label="选择学科，当前{{activeSubjectName}}" aria-expanded="{{showSubjectPicker}}">
          <text class="fl-subject-select-name">{{activeSubjectName}}</text>
          <image class="fl-ui-icon fl-control-chevron" src="/assets/icons/mobile-controls/chevron-down.svg" mode="aspectFit" aria-hidden="true" />
        </view>

        <view class="fl-library-switch">
          <view
            class="fl-library-tab {{tab.active ? 'active' : ''}}"
            wx:for="{{libraryTabs}}"
            wx:for-item="tab"
            wx:key="key"
            data-type="{{tab.key}}"
            hover-class="fl-pressed"
            bindtap="onLibraryTypeChange"
          >
            <text class="fl-library-tab-name">{{tab.name}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="fl-search-box">
      <image class="fl-search-icon" src="/assets/icons/mobile-controls/search.svg" mode="aspectFit" aria-hidden="true" />
      <input
        class="fl-search-input"
        placeholder="{{activeLibraryType === 'function_graph' ? '搜索函数图像' : '搜索名称或关键词'}}"
        placeholder-class="fl-search-placeholder"
        aria-label="{{activeLibraryType === 'function_graph' ? '搜索函数图像名称或关键词' : '搜索速记卡名称或关键词'}}"
        value="{{searchValue}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearchConfirm"
      />
      <view class="fl-search-clear" wx:if="{{searchValue}}" hover-class="fl-pressed" bindtap="onSearchClear" role="button" aria-label="清除搜索">
        <image class="fl-ui-icon" src="/assets/icons/mobile-controls/x.svg" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>

    <view class="fl-reading-tools">
      <view class="fl-mode-switch" aria-role="group" aria-label="阅读模式">
        <button class="fl-mode-tab {{recitationMode ? '' : 'is-active'}}" data-mode="browse" bindtap="setReaderMode" hover-class="fl-pressed" aria-pressed="{{!recitationMode}}">浏览</button>
        <button class="fl-mode-tab {{recitationMode ? 'is-active' : ''}}" data-mode="recite" bindtap="setReaderMode" hover-class="fl-pressed" aria-pressed="{{recitationMode}}">背诵</button>
      </view>
      <button class="fl-filter-button" hover-class="fl-pressed" bindtap="toggleMoreSheet" aria-label="筛选卡片{{activeChapterId || activeTags.length || onlyFavorites || activeStudyCardType ? '，已应用筛选' : ''}}" aria-expanded="{{showMoreSheet}}">
        <text>筛选</text>
        <view class="fl-filter-dot" wx:if="{{activeChapterId || activeTags.length || onlyFavorites || activeStudyCardType}}"></view>
        <image class="fl-ui-icon fl-control-chevron" src="/assets/icons/mobile-controls/chevron-down.svg" mode="aspectFit" aria-hidden="true" />
      </button>
    </view>

    <view class="fl-active-tags" wx:if="{{activeChapterId || activeStudyCardType || onlyFavorites || _shownActiveTags.length}}">
      <view class="fl-active-tag" wx:for="{{chapters}}" wx:for-item="chapter" wx:key="id" wx:if="{{chapter.active}}" data-id="0" bindtap="onChapterSelect" role="button" aria-label="移除章节筛选{{chapter.name}}">
        <text>{{chapter.name}}</text><image class="fl-active-tag-close" src="/assets/icons/mobile-controls/x.svg" mode="aspectFit" aria-hidden="true" />
      </view>
      <view class="fl-active-tag" wx:for="{{studyTypeTabs}}" wx:for-item="type" wx:key="key" wx:if="{{type.active && type.key}}" data-type="" bindtap="onStudyCardTypeChange" role="button" aria-label="移除内容类型筛选{{type.name}}">
        <text>{{type.name}}</text><image class="fl-active-tag-close" src="/assets/icons/mobile-controls/x.svg" mode="aspectFit" aria-hidden="true" />
      </view>
      <view class="fl-active-tag" wx:if="{{onlyFavorites}}" bindtap="toggleFavoritesOnly" role="button" aria-label="移除收藏筛选">
        <text>收藏</text><image class="fl-active-tag-close" src="/assets/icons/mobile-controls/x.svg" mode="aspectFit" aria-hidden="true" />
      </view>
      <view
        class="fl-active-tag"
        wx:for="{{_shownActiveTags}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTagSelect"
        role="button"
        aria-label="移除标签筛选{{item.name}}"
      >
        <text>{{item.name}}</text>
        <image class="fl-active-tag-close" src="/assets/icons/mobile-controls/x.svg" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>

    <view id="formula-library-results" class="fl-results" style="{{resultsMinHeight ? 'min-height:' + resultsMinHeight + 'px;' : ''}}" aria-busy="{{initialLoading}}">
    <view class="fl-list-head" wx:if="{{!initialLoading && !loadError}}">
      <view class="fl-list-caption">
        <text class="fl-list-title">{{activeLibraryType === 'function_graph' ? '函数图像' : '速记卡'}}</text>
        <text class="fl-list-meta">{{formulas.length}} / {{total || formulas.length || 0}}</text>
      </view>
      <button class="fl-random-action" hover-class="fl-pressed" bindtap="goToRandom">{{recitationMode ? '随机背诵' : '随机浏览'}}</button>
    </view>

    <view class="fl-loading" wx:if="{{initialLoading}}">
      <view class="fl-loading-ring"></view>
      <text class="fl-state-title">{{activeLibraryType === 'function_graph' ? '正在整理函数图像' : '正在整理速记卡'}}</text>
      <text class="fl-state-desc">请稍候</text>
    </view>

    <view class="fl-empty" wx:if="{{!initialLoading && loadError}}">
      <view class="fl-state-icon fl-state-error"><image class="fl-ui-icon" src="/assets/icons/mobile-controls/circle-exclamation-point.svg" mode="aspectFit" aria-hidden="true" /></view>
      <text class="fl-state-title">{{activeLibraryType === 'function_graph' ? '函数图像加载失败' : '速记卡加载失败'}}</text>
      <text class="fl-state-desc">{{loadErrorMessage || '请检查网络后重试'}}</text>
      <view class="fl-reload-btn" hover-class="fl-pressed" bindtap="reload">重新加载</view>
    </view>

    <view class="fl-list {{activeLibraryType === 'function_graph' ? 'fl-graph-list' : ''}}" wx:if="{{!initialLoading && !loadError && formulas.length > 0}}">
      <!-- (5) Native rich-text stays on opacity-only ancestors. -->
      <view wx:for="{{formulas}}" wx:key="id" class="motion-list-item {{item.titleNodes && item.titleNodes.length ? 'motion-list-fade' : ''}}" style="animation-delay:{{(index < 5 ? index : 5) * 42}}ms;">
      <view
        id="formula-card-{{item.id}}"
        class="fl-card {{activeLibraryType === 'function_graph' ? 'fl-card-graph' : ''}}"
        data-id="{{item.id}}"
        bindtap="goToReader"
        hover-class="{{item.titleNodes && item.titleNodes.length ? 'motion-content-pressed' : 'fl-card-pressed'}}"
      >
        <view class="fl-card-head">
          <view class="fl-card-title-wrap">
            <rich-text
              class="fl-card-title fl-card-title-rich"
              wx:if="{{item.titleNodes && item.titleNodes.length}}"
              nodes="{{item.titleNodes}}"
              user-select="{{true}}"
            />
            <text class="fl-card-title" wx:else>{{item.title}}</text>
            <view class="fl-card-tags" wx:if="{{item.tags && item.tags.length || item.isFunctionGraph || (activeSubject === 'exam408' && item.studyCardTypeLabel)}}">
              <text class="fl-card-tag tag-study-type" wx:if="{{activeSubject === 'exam408'}}">{{item.studyCardTypeLabel}}</text>
              <text
                class="fl-card-tag tag-function-graph"
                wx:if="{{item.isFunctionGraph}}"
              >函数图像</text>
              <text
                class="fl-card-tag {{'tag-' + t.code}}"
                wx:for="{{item.tags}}"
                wx:for-item="t"
                wx:key="id"
              >{{t.name}}</text>
            </view>
          </view>
          <view wx:if="{{!guestMode}}"
            class="fl-favorite-btn {{item.isFavorited || item.is_favorited ? 'active' : ''}}"
            data-id="{{item.id}}"
            catchtap="toggleFormulaFavorite"
            hover-class="fl-pressed"
            aria-role="button"
            aria-label="{{item.isFavorited || item.is_favorited ? '取消收藏' : '收藏公式'}}"
          >
            <image class="fl-bookmark-icon" src="/assets/icons/mobile-controls/bookmark.svg" mode="aspectFit" aria-hidden="true" />
          </view>
          <view wx:else class="fl-favorite-btn is-locked" aria-disabled="true" aria-label="登录后可收藏公式">
            <image class="ui-lock" src="/assets/icons/lock.svg" mode="aspectFit" aria-hidden="true" />
          </view>
        </view>

        <view class="fl-graph-preview" wx:if="{{activeLibraryType === 'function_graph'}}">
          <image
            class="fl-graph-preview-img"
            wx:if="{{item.graphPreviewUrl && !item.graphLoadError}}"
            src="{{item.graphPreviewUrl}}"
            mode="aspectFit"
            lazy-load
            data-id="{{item.id}}"
            binderror="onGraphImageError"
          />
          <view class="fl-graph-placeholder" wx:else>
            <image class="fl-graph-placeholder-icon" src="/assets/icons/mobile-controls/chart-no-axes-combined.svg" mode="aspectFit" aria-hidden="true" />
            <text class="fl-graph-placeholder-title">图像暂未上传</text>
            <text class="fl-graph-placeholder-desc">该条目已标记为函数图像</text>
          </view>
        </view>

        <view class="fl-card-thumb" wx:if="{{activeLibraryType !== 'function_graph' && item.isFunctionGraph && item.graphThumbnailUrl && !item.graphLoadError}}">
          <image
            class="fl-card-thumb-img"
            src="{{item.graphThumbnailUrl}}"
            mode="aspectFit"
            lazy-load
            data-id="{{item.id}}"
            binderror="onGraphImageError"
          />
        </view>

        <view class="fl-card-foot">
          <text class="fl-card-hint">{{activeLibraryType === 'function_graph' ? '查看大图、适用条件与完整解析' : '查看核心记忆、易混点与考试陷阱'}}</text>
          <image class="fl-ui-icon fl-card-arrow" src="/assets/icons/mobile-controls/chevron-right.svg" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
      </view>

      <view class="fl-loading-more" wx:if="{{loadingMore}}">
        <view class="fl-loading-dot"></view>
        <text>正在加载更多</text>
      </view>
    </view>

    <view class="fl-empty" wx:if="{{!initialLoading && !loadError && formulas.length === 0}}">
      <view class="fl-state-icon"><image class="fl-ui-icon" src="/assets/icons/mobile-controls/{{activeLibraryType === 'function_graph' ? 'chart-no-axes-combined' : 'book-open'}}.svg" mode="aspectFit" aria-hidden="true" /></view>
      <text class="fl-state-title">{{searchValue ? (activeLibraryType === 'function_graph' ? '没有匹配的函数图像' : '没有匹配的速记卡') : (activeLibraryType === 'function_graph' ? '暂无函数图像' : '暂无速记卡数据')}}</text>
      <text class="fl-state-desc">{{searchValue ? '换一个关键词或清除筛选试试' : (activeLibraryType === 'function_graph' ? '当前筛选下尚未录入函数图像' : '当前科目尚未录入对应速记卡')}}</text>
    </view>
    </view>
  </view>

  <view class="fl-picker-overlay" wx:if="{{showSubjectPicker}}" bindtap="toggleSubjectPicker" catchtouchmove="noop">
    <view class="fl-bottom-sheet fl-subject-sheet" catchtap="noop">
      <view class="fl-sheet-handle"></view>
      <view class="fl-sheet-head">
        <view>
          <text class="fl-sheet-title">选择学科</text>
          <text class="fl-sheet-subtitle">切换后将重新加载章节与内容</text>
        </view>
        <view class="fl-sheet-close" bindtap="toggleSubjectPicker" hover-class="fl-pressed">
          <image class="fl-ui-icon" src="/assets/icons/mobile-controls/x.svg" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
      <view class="fl-subject-options">
        <view
          class="fl-subject-option {{s.active ? 'active' : ''}}"
          wx:for="{{subjects}}"
          wx:for-item="s"
          wx:key="code"
          data-code="{{s.code}}"
          hover-class="fl-pressed"
          bindtap="onSubjectChange"
        >
          <view class="fl-subject-option-mark"><view class="fl-subject-option-dot"></view></view>
          <text class="fl-subject-option-name">{{s.name}}</text>
          <image class="fl-ui-icon" src="/assets/icons/mobile-controls/check.svg" mode="aspectFit" aria-hidden="true" wx:if="{{s.active}}" />
        </view>
      </view>
    </view>
  </view>

  <view class="fl-picker-overlay" wx:if="{{showMoreSheet}}" bindtap="toggleMoreSheet" catchtouchmove="noop">
    <view class="fl-bottom-sheet fl-more-sheet" catchtap="noop">
      <view class="fl-sheet-handle"></view>
      <view class="fl-sheet-head">
        <text class="fl-sheet-title">筛选</text>
        <view class="fl-sheet-close" bindtap="toggleMoreSheet" hover-class="fl-pressed" role="button" aria-label="关闭筛选">
          <image class="fl-ui-icon" src="/assets/icons/mobile-controls/x.svg" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
      <scroll-view class="fl-filter-body" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="fl-filter-section" wx:if="{{activeSubject === 'exam408' && activeLibraryType !== 'function_graph'}}">
          <text class="fl-filter-heading">内容类型</text>
          <view class="fl-study-type-row">
            <view
              class="fl-study-type-chip {{item.active ? 'active' : ''}}"
              wx:for="{{studyTypeTabs}}"
              wx:key="key"
              data-type="{{item.key}}"
              hover-class="fl-pressed"
              bindtap="onStudyCardTypeChange"
              role="button"
              aria-pressed="{{item.active}}"
            >{{item.name}}</view>
          </view>
        </view>
        <view class="fl-filter-section">
          <text class="fl-filter-heading">章节</text>
          <view class="fl-chapter-row">
            <view class="fl-chapter-chip {{!activeChapterId ? 'active' : ''}}" hover-class="fl-pressed" bindtap="onChapterSelect" data-id="0" role="button" aria-pressed="{{!activeChapterId}}">全部章节</view>
            <view
              class="fl-chapter-chip {{c.active ? 'active' : ''}}"
              wx:for="{{chapters}}"
              wx:for-item="c"
              wx:key="id"
              data-id="{{c.id}}"
              hover-class="fl-pressed"
              bindtap="onChapterSelect"
              role="button"
              aria-pressed="{{c.active}}"
            >{{c.name}}<text wx:if="{{c.available_count > 0}}" class="fl-chapter-count"> {{c.available_count}}</text></view>
          </view>
        </view>
        <view class="fl-filter-section fl-filter-options">
          <button class="fl-filter-option {{onlyFavorites ? 'is-active' : ''}}" hover-class="fl-pressed" bindtap="toggleFavoritesOnly" disabled="{{guestMode}}" aria-pressed="{{onlyFavorites}}" aria-label="{{guestMode ? '登录后可筛选收藏' : '只看收藏'}}">
            <text>只看收藏</text>
            <image wx:if="{{guestMode}}" class="ui-lock" src="/assets/icons/lock.svg" mode="aspectFit" aria-hidden="true" />
            <image wx:elif="{{onlyFavorites}}" class="fl-ui-icon" src="/assets/icons/mobile-controls/check.svg" mode="aspectFit" aria-hidden="true" />
          </button>
          <view class="fl-filter-option" hover-class="fl-pressed" bindtap="openTagPickerFromMore" role="button">
            <text>标签</text>
            <view class="fl-filter-option-end">
              <text class="fl-filter-value">{{activeTags.length ? '已选 ' + activeTags.length + ' 个' : '全部'}}</text>
              <image class="fl-ui-icon" src="/assets/icons/mobile-controls/chevron-right.svg" mode="aspectFit" aria-hidden="true" />
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="fl-filter-footer">
        <button class="fl-filter-reset" hover-class="fl-pressed" bindtap="resetFilters" disabled="{{!searchValue && !activeChapterId && !activeTags.length && !onlyFavorites && !activeStudyCardType}}">重置筛选</button>
        <button class="fl-filter-done" hover-class="fl-pressed" bindtap="toggleMoreSheet">完成</button>
      </view>
    </view>
  </view>

  <view class="fl-picker-overlay" wx:if="{{showTagPicker}}" bindtap="toggleTagPicker" catchtouchmove="noop">
    <view class="fl-tag-sheet" catchtap="noop">
      <view class="fl-sheet-handle"></view>
      <view class="fl-sheet-head">
        <view>
          <text class="fl-sheet-title">筛选{{activeLibraryType === 'function_graph' ? '图像' : '公式'}}标签</text>
          <text class="fl-sheet-subtitle">可同时选择多个标签</text>
        </view>
        <view class="fl-sheet-close" bindtap="toggleTagPicker" hover-class="fl-pressed">
          <image class="fl-ui-icon" src="/assets/icons/mobile-controls/x.svg" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
      <view class="fl-tag-grid">
        <view
          class="fl-tag-item {{t._active ? 'active' : ''}}"
          wx:for="{{tags}}"
          wx:for-item="t"
          wx:key="id"
          data-id="{{t.id}}"
          hover-class="fl-pressed"
          bindtap="onTagSelect"
        >
          <text>{{t.name}}</text>
          <image class="fl-ui-icon" src="/assets/icons/mobile-controls/check.svg" mode="aspectFit" aria-hidden="true" wx:if="{{t._active}}" />
        </view>
      </view>
      <view class="fl-sheet-done" hover-class="fl-pressed" bindtap="toggleTagPicker">完成筛选</view>
    </view>
  </view>
</view>
