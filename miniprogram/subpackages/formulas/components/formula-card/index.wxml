<template name="card-heading">
  <view class="fc-header">
    <rich-text class="fc-title fc-title-rich" nodes="{{content.titleNodes}}" user-select="{{true}}" />
    <view class="fc-tags">
      <text class="fc-tag fc-tag-study">{{card.studyCardTypeLabel || '速记'}}</text>
      <text class="fc-tag {{'fc-tag-' + tag.code}}" wx:for="{{card.tags}}" wx:for-item="tag" wx:key="id">{{tag.name}}</text>
    </view>
  </view>
</template>

<template name="card-content">
  <view class="fc-formula-section" wx:if="{{formulaBlocks.length}}">
    <text class="fc-section-title">核心公式</text>
    <view class="fc-formula-block fc-formula-block-{{blockIndex}}" wx:for="{{formulaBlocks}}" wx:for-item="block" wx:for-index="blockIndex" wx:key="_key">
      <view class="fc-block-head">
        <rich-text class="fc-block-label fc-block-label-rich" wx:if="{{block.labelNodes.length}}" nodes="{{block.labelNodes}}" user-select="{{true}}" />
        <view class="fc-expand-button" data-index="{{blockIndex}}" catchtap="openFormulaReading" hover-class="fc-control-pressed" role="button" aria-label="放大查看公式"><text>放大查看</text></view>
      </view>
      <view class="fc-formula-list">
        <view class="fc-formula-row" wx:for="{{block.readingRows}}" wx:for-item="row" wx:key="_key">
          <scroll-view class="fc-formula-line-scroll" wx:for="{{row.lineItems}}" wx:for-item="line" wx:for-index="lineIndex" wx:key="_key"
            scroll-x data-scrollable="{{row.canScrollX}}" enhanced show-scrollbar="{{false}}" bounces="{{false}}"
            bindtouchstart="onFormulaTouchStart" bindtouchend="onFormulaTouchEnd" bindtouchcancel="onFormulaTouchEnd">
            <view class="fc-reading-line {{row.isScrollable ? 'is-long' : ''}} {{lineIndex > 0 ? 'is-continuation' : ''}}">
              <rich-text class="fc-formula-rich" nodes="{{line.mathNodes}}" user-select="{{true}}" />
            </view>
          </scroll-view>
        </view>
      </view>
      <text class="fc-row-scroll-hint" wx:if="{{block.hasWideRows}}">超宽公式可左右滑动</text>
      <rich-text class="fc-block-note" wx:if="{{block.noteNodes.length}}" nodes="{{block.noteNodes}}" user-select="{{true}}" />
    </view>
  </view>

  <view class="fc-graph-section" wx:if="{{card.card_type === 'function_graph' || card.is_function_graph || card.isFunctionGraph}}">
    <view class="fc-section-heading"><text class="fc-section-title">函数图像</text><text class="fc-preview-hint" wx:if="{{(displayGraphUrl || graphImageUrl) && !graphLoadError}}">点击查看大图</text></view>
    <view class="fc-graph-viewport" style="padding-bottom:{{graphViewportRatio}}%;">
      <image class="fc-graph-image" wx:if="{{(displayGraphUrl || graphImageUrl) && !graphLoadError}}" src="{{displayGraphUrl || graphImageUrl}}" data-card-id="{{card.id}}" data-src="{{displayGraphUrl || graphImageUrl}}" mode="aspectFit" lazy-load bindtap="previewGraph" bindload="onGraphLoad" binderror="onGraphError" />
      <view class="fc-graph-fallback" wx:else><text class="fc-graph-fallback-title">函数图像暂时无法加载</text><text class="fc-graph-fallback-desc">仍可继续查看公式与函数性质</text></view>
      <image class="fc-graph-preload" wx:if="{{graphImageUrl && displayGraphUrl !== graphImageUrl && !graphLoadError}}" src="{{graphImageUrl}}" data-card-id="{{card.id}}" data-src="{{graphImageUrl}}" bindload="onFullGraphLoad" binderror="onFullGraphError" />
    </view>
  </view>

  <view class="fc-reading-section" wx:if="{{content.summaryNodes.length}}">
    <text class="fc-section-title">{{card.study_card_type === 'formula' ? '记忆提示' : '核心记忆'}}</text>
    <rich-text class="fc-rich-text" nodes="{{content.summaryNodes}}" user-select="{{true}}" />
  </view>
  <view class="fc-reading-section" wx:if="{{content.conditionsNodes.length}}">
    <text class="fc-section-title">{{card.study_card_type === 'protocol_rule' ? '规则边界' : '适用条件'}}</text>
    <rich-text class="fc-rich-text" nodes="{{content.conditionsNodes}}" user-select="{{true}}" />
  </view>
  <view class="fc-reading-section" wx:if="{{content.symbolNotesNodes.length}}">
    <text class="fc-section-title">符号说明</text>
    <rich-text class="fc-rich-text" nodes="{{content.symbolNotesNodes}}" user-select="{{true}}" />
  </view>
  <view class="fc-reading-section" wx:if="{{content.secondaryNodes.length}}">
    <text class="fc-section-title">{{card.template_type === 'contrast' ? '对比要点' : '常见结论'}}</text>
    <rich-text class="fc-rich-text" nodes="{{content.secondaryNodes}}" user-select="{{true}}" />
  </view>
  <view class="fc-reading-section fc-error-section" wx:if="{{content.errorTipsNodes.length}}">
    <text class="fc-section-title">{{card.template_type === 'trap' || card.study_card_type === 'trap' ? '考试陷阱' : '易错提醒'}}</text>
    <rich-text class="fc-rich-text" nodes="{{content.errorTipsNodes}}" user-select="{{true}}" />
  </view>
  <view class="fc-reading-section" wx:if="{{content.examples.length}}">
    <text class="fc-section-title">典型例题 · {{content.examples.length}} 道</text>
    <view class="fc-example" wx:for="{{content.examples}}" wx:for-item="ex" wx:key="_key">
      <text class="fc-example-label">例 {{index + 1}}</text>
      <rich-text class="fc-rich-text" nodes="{{ex.questionNodes}}" user-select="{{true}}" />
      <view class="fc-example-notes" wx:if="{{ex.solutionNodes.length || ex.answerNodes.length || ex.errorTipNodes.length}}">
        <view class="fc-example-detail" wx:if="{{ex.solutionNodes.length}}"><text class="fc-example-detail-label">解法</text><rich-text class="fc-rich-text" nodes="{{ex.solutionNodes}}" user-select="{{true}}" /></view>
        <view class="fc-example-detail" wx:if="{{ex.answerNodes.length}}"><text class="fc-example-detail-label">答案</text><rich-text class="fc-rich-text" nodes="{{ex.answerNodes}}" user-select="{{true}}" /></view>
        <view class="fc-example-detail" wx:if="{{ex.errorTipNodes.length}}"><text class="fc-example-detail-label">易错</text><rich-text class="fc-rich-text" nodes="{{ex.errorTipNodes}}" user-select="{{true}}" /></view>
      </view>
    </view>
  </view>
  <text class="fc-content-empty" wx:if="{{!formulaBlocks.length && !content.summaryNodes.length && !content.conditionsNodes.length && !content.symbolNotesNodes.length && !content.secondaryNodes.length && !content.errorTipsNodes.length && !content.examples.length && card.card_type !== 'function_graph' && !card.is_function_graph && !card.isFunctionGraph}}">这张速记卡暂无正文，可切换其他卡片</text>
</template>

<view class="formula-card-wrap template-{{card.template_type || 'standard'}} study-{{card.study_card_type || 'formula'}}">
  <view class="fc-flip-shell {{recitationMode ? 'is-recite' : ''}}">
    <view class="fc-flip-stage {{recitationMode ? 'is-recite' : 'is-browse'}} {{recitationMode && isFlipped ? 'is-flipped' : ''}}"
      style="{{recitationMode
        ? 'transform:rotateY(' + flipAngle + 'deg);' + (readingHeight > 0 ? 'height:' + readingHeight + 'px;' : '')
        : ''}}"
      bindtouchstart="onCardTouchStart" bindtouchmove="onCardTouchMove" bindtouchend="onCardTouchEnd" bindtouchcancel="onCardTouchCancel">
      <view wx:if="{{recitationMode}}" class="fc-flip-face fc-flip-front" aria-hidden="{{isFlipped}}">
        <scroll-view class="fc-flip-front-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{recitationScrollTop}}">
          <view class="fc-recall-question {{card.title.length > 48 ? 'is-long-question' : ''}}">
            <template is="card-heading" data="{{card: card, content: content}}" />
          </view>
        </scroll-view>
        <text class="fc-recall-prompt">回想要点与适用条件</text>
        <button class="fc-flip-action" bindtap="toggleCardFlip" hover-class="fc-control-pressed" aria-label="显示答案" aria-expanded="{{isFlipped}}" disabled="{{isFlipped}}">显示答案</button>
      </view>
      <view class="fc-flip-face {{recitationMode ? 'fc-flip-back' : 'fc-browse-face'}}" aria-hidden="{{recitationMode && !isFlipped}}">
        <block wx:if="{{recitationMode}}">
          <view class="fc-answer-heading"><text class="fc-face-label">答案</text><text class="fc-scroll-note">卡内上下滑动</text></view>
          <scroll-view class="fc-flip-back-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{recitationScrollTop}}" catchtap="containFormulaReading">
            <template is="card-heading" data="{{card: card, content: content}}" />
            <template is="card-content" data="{{card: card, content: content, formulaBlocks: formulaBlocks, graphImageUrl: graphImageUrl, displayGraphUrl: displayGraphUrl, graphViewportRatio: graphViewportRatio, graphLoadError: graphLoadError}}" />
          </scroll-view>
          <button class="fc-flip-action fc-flip-return" bindtap="toggleCardFlip" hover-class="fc-control-pressed" aria-label="返回题面" disabled="{{!isFlipped}}">返回题面</button>
        </block>
        <block wx:else>
          <template is="card-heading" data="{{card: card, content: content}}" />
          <template is="card-content" data="{{card: card, content: content, formulaBlocks: formulaBlocks, graphImageUrl: graphImageUrl, displayGraphUrl: displayGraphUrl, graphViewportRatio: graphViewportRatio, graphLoadError: graphLoadError}}" />
        </block>
      </view>
    </view>
  </view>
</view>

<!-- Native page-container consumes Back while expanded; the reader's scroll
     position remains unchanged because its card is never replaced. -->
<page-container
  show="{{!!expandedBlock}}" position="bottom" round="{{false}}"
  duration="{{0}}" overlay="{{false}}"
  close-on-slide-down="{{false}}" bind:afterleave="onReadingAfterLeave"
  custom-style="position:fixed;inset:0;width:100%;height:100%;background:transparent;"
>
  <motion-sheet show="{{expandedVisible}}" label="公式阅读" background="#FBFFFD" safe-area="{{false}}" content-motion="fade" bind:close="closeFormulaReading" bind:closed="onReadingClosed">
  <view class="fc-expanded-reading motion-sheet-panel" style="height:{{expandedHeight}}px;" catchtap="containFormulaReading" catchtouchmove="containFormulaReading">
    <view class="fc-expanded-header" style="height:{{expandedHeaderHeight}}px;">
      <view class="fc-expanded-heading">
        <rich-text class="fc-expanded-title" wx:if="{{expandedBlock.labelNodes.length}}" nodes="{{expandedBlock.labelNodes}}" />
        <text class="fc-expanded-title" wx:else>公式阅读</text>
        <text class="fc-expanded-subtitle" wx:if="{{expandedBlock.hasWideRows}}">保留完整公式，超宽部分可左右滑动</text>
      </view>
      <view class="fc-reading-close" bindtap="closeFormulaReading" hover-class="fc-control-pressed" role="button" aria-label="关闭公式阅读"><image class="fc-close-icon" src="/assets/icons/mobile-controls/x.svg" mode="aspectFit" aria-hidden="true" /></view>
    </view>
    <scroll-view class="fc-expanded-scroll" style="height:{{expandedScrollHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="fc-expanded-content">
        <view class="fc-formula-row" wx:for="{{expandedBlock.readingRows}}" wx:for-item="row" wx:key="_key">
          <scroll-view class="fc-formula-line-scroll"
            wx:for="{{row.lineItems}}" wx:for-item="line" wx:for-index="lineIndex" wx:key="_key"
            scroll-x enhanced show-scrollbar="{{false}}" bounces="{{false}}"
          >
            <view class="fc-reading-line {{row.isScrollable ? 'is-long' : ''}} {{lineIndex > 0 ? 'is-continuation' : ''}}">
              <rich-text class="fc-formula-rich" nodes="{{line.mathNodes}}" user-select="{{true}}" />
            </view>
          </scroll-view>
        </view>
        <rich-text class="fc-block-note" wx:if="{{expandedBlock.noteNodes.length}}" nodes="{{expandedBlock.noteNodes}}" user-select="{{true}}" />
      </view>
    </scroll-view>
  </view>
  </motion-sheet>
</page-container>
