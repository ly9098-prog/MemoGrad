@import "../../utils/katex/katex.wxss";
@import "../../utils/katex/katex-fonts-1.wxss";
@import "../../utils/katex/katex-fonts-2.wxss";
@import "../../utils/katex/katex-fonts-3.wxss";

/* One content surface. Only recitation promotes it to a 3D layer. */
.formula-card-wrap {
  padding: 0;
  min-width: 0;
  color: #23483C;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.8;
}
.fc-flip-shell.is-recite {
  perspective: 500px;
  -webkit-perspective: 500px;
  perspective-origin: 50% 50%;
}
.fc-flip-stage { position: relative; }
.fc-flip-stage.is-recite {
  height: 760rpx;
  min-height: 320px;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: transform 520ms cubic-bezier(.4, 0, .2, 1);
  will-change: transform;
}
.fc-flip-stage.is-flipped { transform: rotateY(180deg); }
.fc-flip-face {
  box-sizing: border-box;
  min-width: 0;
  padding: 32rpx;
  border: 1rpx solid #D8EEE6;
  border-radius: 28rpx;
  background: #FFFFFF;
}
.is-recite .fc-flip-face {
  height: 100%;
  display: flex;
  flex-direction: column;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
.fc-flip-front { position: relative; background: #F5F9F6; transform: rotateY(0deg); }
.fc-flip-back { position: absolute; inset: 0; transform: rotateY(180deg); }
.fc-flip-stage:not(.is-flipped) .fc-flip-back,
.fc-flip-stage.is-flipped .fc-flip-front { pointer-events: none; }
.fc-flip-front-scroll, .fc-flip-back-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }
.fc-flip-front-scroll { margin-bottom: 24rpx; }
.fc-recall-question { min-height: 100%; display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; padding: 16rpx 0; }
.fc-answer-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-bottom: 24rpx; }
.fc-face-label, .fc-scroll-note { color: #507568; font-size: 24rpx; line-height: 1.5; }
.fc-scroll-note { flex-shrink: 0; }
.fc-recall-prompt { display: block; flex-shrink: 0; margin-bottom: 16rpx; color: #507568; font-size: max(26rpx, 13px); line-height: 1.8; text-align: center; }
.fc-flip-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  align-self: center;
  width: auto;
  min-width: 144px;
  max-width: 100%;
  min-height: 44px;
  margin: 0;
  padding: 12rpx 32rpx;
  border: 0;
  border-radius: 16rpx;
  background: #3A6F5B;
  color: #FFFFFF;
  font-size: max(28rpx, 14px);
  font-weight: 500;
  line-height: 1.5;
}
.fc-flip-action::after { border: 0; }
.fc-flip-return { margin-top: 20rpx; background: #EAF9F4; color: #315D49; }
.fc-control-pressed { opacity: .72; }
.fc-flip-action:focus-visible, .fc-expand-button:focus-visible { outline: 2px solid #3A6F5B; outline-offset: 2px; }

.fc-header { padding-bottom: 24rpx; border-bottom: 1rpx solid #D8EEE6; }
.fc-title { display: block; color: #23483C; font-size: 36rpx; line-height: 1.55; font-weight: 500; }
.fc-title-rich, .fc-block-label-rich {
  min-width: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
}
.fc-title-rich .katex, .fc-block-label-rich .katex {
  display: inline-block;
  width: auto;
  max-width: 100%;
  font-size: 1em;
  line-height: 1.18;
  vertical-align: middle;
  white-space: nowrap;
}
.fc-flip-front .fc-header { padding: 0; border: 0; }
.fc-flip-front .fc-title { font-size: 38rpx; text-align: center; }
.fc-flip-front .fc-tags { justify-content: center; }
.fc-recall-question.is-long-question .fc-title { text-align: left; }
.fc-recall-question.is-long-question .fc-tags { justify-content: flex-start; }
.fc-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 20rpx; }
.fc-tag { box-sizing: border-box; min-width: 0; max-width: 100%; padding: 4rpx 12rpx; border-radius: 8rpx; font-size: 24rpx; line-height: 1.5; font-weight: 400; word-break: break-all; }
.fc-tag-study, .fc-tag-basic { background: #EAF9F4; color: #3A6F5B; }
.fc-tag-high_frequency { background: #FFF0D8; color: #7A521E; }
.fc-tag-error_prone { background: #F8E4DF; color: #923F36; }
.fc-tag-must_memorize { background: #EAE7EF; color: #6E5C82; }

/* Formula groups and prose share the card, separated by type and spacing. */
.fc-formula-section { padding-top: 28rpx; }
.fc-section-title { display: block; color: #23483C; font-size: 28rpx; line-height: 1.5; font-weight: 600; }
.fc-section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.fc-formula-block { padding: 24rpx 0; }
.fc-formula-block + .fc-formula-block { border-top: 1rpx solid #D8EEE6; }
.fc-block-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; min-height: 44rpx; margin-bottom: 12rpx; }
.fc-block-label { display: block; min-width: 0; flex: 1; color: #3A6F5B; font-size: 26rpx; font-weight: 500; line-height: 1.65; }
.fc-expand-button { display: flex; align-items: center; flex-shrink: 0; min-height: 44px; margin: -20rpx -12rpx -20rpx 0; padding: 0 12rpx; color: #3A6F5B; font-size: 22rpx; font-weight: 500; line-height: 1.4; }
.fc-block-note { display: block; margin: 8rpx 0 0; color: #507568; font-size: 26rpx; line-height: 1.8; }
.fc-formula-rich { display: inline-block; width: auto; max-width: none; color: #23483C; white-space: nowrap; vertical-align: middle; line-height: 1.2; }
.fc-formula-rich .katex { display: inline-block; width: auto; max-width: none; white-space: nowrap; }
.fc-formula-rich .katex-html, .fc-formula-rich .base { white-space: nowrap; }
.fc-reading-section, .fc-graph-section { margin-top: 28rpx; padding-top: 28rpx; border-top: 1rpx solid #D8EEE6; min-width: 0; max-width: 100%; box-sizing: border-box; }
.fc-reading-section, .fc-example-detail { overflow: hidden; }
.fc-reading-section > .fc-section-title { margin-bottom: 16rpx; }
.fc-error-section > .fc-section-title { color: #923F36; }
.fc-rich-text { display: block; min-width: 0; width: 100%; max-width: 100%; box-sizing: border-box; color: #23483C; font-size: 30rpx; line-height: 1.8; white-space: normal; word-break: normal; overflow-wrap: anywhere; }
.fc-rich-text .katex { display: inline-block; width: auto; max-width: none; font-size: 1.12em; line-height: 1.22; vertical-align: middle; white-space: nowrap; }
.fc-rich-text .katex-html, .fc-rich-text .base { white-space: nowrap; }
.fc-example { min-width: 0; max-width: 100%; padding: 20rpx 0; box-sizing: border-box; }
.fc-example + .fc-example { border-top: 1rpx solid #D8EEE6; }
.fc-example-label, .fc-example-detail-label { display: block; margin-bottom: 8rpx; color: #507568; font-size: 24rpx; font-weight: 500; line-height: 1.5; }
.fc-example-detail { margin-top: 20rpx; min-width: 0; max-width: 100%; }
.fc-content-empty { display: block; padding: 32rpx 0; color: #507568; font-size: 28rpx; line-height: 1.8; }

.fc-preview-hint { color: #507568; font-size: 22rpx; }
.fc-graph-viewport { position: relative; width: 100%; overflow: hidden; box-sizing: border-box; }
.fc-graph-image { position: absolute; left: 0; top: 0; display: block; width: 100%; height: 100%; background: #FFFFFF; }
.fc-graph-preload { position: absolute; left: -9999rpx; top: 0; width: 10rpx; height: 10rpx; }
.fc-graph-fallback { padding: 28rpx 0; }
.fc-graph-fallback-title { display: block; color: #507568; font-size: 28rpx; }
.fc-graph-fallback-desc { display: block; margin-top: 8rpx; color: #507568; font-size: 24rpx; }

.fc-rich-text .fc-structured-list {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.fc-rich-text .fc-structured-row {
  display: block;
  position: relative;
  margin-top: 12rpx;
  padding: 0;
  box-sizing: border-box;
}

.fc-rich-text .fc-structured-row.is-first { margin-top: 0; }

.fc-rich-text .fc-structured-list.is-bulleted .fc-structured-row {
  padding-left: 26rpx;
}

.fc-rich-text .fc-structured-marker {
  position: absolute;
  left: 2rpx;
  top: 0;
  color: #507568;
  font-weight: 600;
}

.fc-rich-text .fc-structured-primary { color: inherit; }
.fc-rich-text .fc-structured-note { color: #507568; }

.fc-reading-close {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  margin: -14rpx -12rpx -14rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3A6F5B;
}
.fc-close-icon { position: relative; width: 36rpx; height: 36rpx; }
.fc-close-icon::before,
.fc-close-icon::after {
  content: '';
  position: absolute;
  top: 17rpx;
  left: 0;
  width: 36rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: rotate(45deg);
}
.fc-close-icon::after { transform: rotate(-45deg); }
.fc-formula-list,
.fc-formula-row { min-width: 0; width: 100%; box-sizing: border-box; }
.fc-formula-row + .fc-formula-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #E5F2ED;
}
.fc-formula-line-scroll { width: 100%; white-space: nowrap; }
.fc-reading-line {
  display: inline-block;
  min-width: 100%;
  box-sizing: border-box;
  padding: 18rpx 6rpx 22rpx;
  text-align: center;
  white-space: nowrap;
  vertical-align: top;
}
.fc-reading-line.is-long { text-align: left; }
.fc-reading-line.is-continuation { padding-top: 6rpx; padding-left: 22rpx; }
.fc-reading-line .fc-formula-rich { font-size: 32rpx; font-weight: 400; color: #23483C; }
.fc-row-scroll-hint { display: block; color: #507568; font-size: 20rpx; line-height: 1.5; padding: 0 6rpx 4rpx; }
.fc-expanded-reading { height: 100%; display: flex; flex-direction: column; color: #23483C; }
.fc-expanded-header {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #D8EEE6;
  background: #FBFFFD;
}
.fc-expanded-heading { flex: 1; min-width: 0; }
.fc-expanded-title { display: block; font-size: 28rpx; line-height: 1.4; font-weight: 600; }
.fc-expanded-subtitle { display: block; margin-top: 8rpx; color: #507568; font-size: 22rpx; line-height: 1.5; }
.fc-expanded-scroll { flex: none; min-height: 0; }
.fc-expanded-content { padding: 16rpx 18rpx calc(24rpx + env(safe-area-inset-bottom)); }
.fc-expanded-content .fc-reading-line .fc-formula-rich { font-size: 36rpx; }


@media (max-width: 360px) {
  .formula-card-wrap, .fc-rich-text { font-size: 34rpx; }
  .fc-title, .fc-flip-front .fc-title { font-size: 40rpx; }
  .fc-tag, .fc-face-label, .fc-scroll-note, .fc-flip-action { font-size: 28rpx; }
  .fc-reading-line .fc-formula-rich { font-size: 34rpx; }
  .fc-expanded-content .fc-reading-line .fc-formula-rich { font-size: 38rpx; }
}
@media (prefers-reduced-motion: reduce) {
  .fc-flip-stage.is-recite, .fc-flip-face {
    transition: none !important;
    will-change: auto !important;
  }
}
