@import '../../../styles/tokens.wxss';

page {
  height: 100%;
  background: #FAFCFB;
  color: #23483C;
  overflow: hidden;
}

button { box-sizing: border-box; }
button::after { border: none; }

.fr-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #FAFCFB;
}

.fr-card-scroll {
  min-height: 0;
  flex: 1;
  height: 0;
}

.fr-card-wrap {
  min-height: 100%;
  padding: 22rpx 24rpx 0;
  box-sizing: border-box;
}
.fr-card-wrap.is-recite { padding-bottom: calc(12px + env(safe-area-inset-bottom)); }

.fr-reader-meta {
  padding: 4rpx 2rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.fr-reading-context { display: flex; align-items: baseline; gap: 12px; min-width: 0; }
.fr-mode-label { color: #3A6F5B; font-size: 14px; font-weight: 500; }
.fr-reader-actions { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.fr-random-context { flex-shrink: 0; color: #507568; font-size: 12px; }

.fr-card-favorite {
  position: relative;
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  border-radius: 10px;
  background: transparent;
  color: #507568;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .14s ease, color .14s ease;
}
.fr-card-favorite.active { color: #3A6F5B; background: #EAF9F4; }
.fr-card-favorite.disabled { opacity: .52; pointer-events: none; }
.fr-card-favorite:focus-visible, .fr-nav-hit:focus-visible { outline: 2px solid #3A6F5B; outline-offset: 2px; }

.fr-bottom-space { height: calc(80px + env(safe-area-inset-bottom)); }

.fr-nav-capsule {
  position: fixed;
  left: 56rpx;
  bottom: calc(12px + 32rpx + env(safe-area-inset-bottom));
  z-index: 60;
  width: auto;
  min-width: 132px;
  max-width: calc(100vw - 112rpx - 128px - 8px);
  min-height: 44px;
  padding: 0;
  display: flex;
  gap: 0;
  align-items: center;
  box-sizing: border-box;
  color: #3A6F5B;
  border-radius: 22px;
  background: #E3F2EA;
  box-shadow: 0 4px 14px rgba(35,72,60,.12);
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition: opacity .16s ease, visibility 0s linear;
}
.fr-nav-capsule.is-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity .16s ease, visibility 0s linear .16s;
}
.fr-nav-hit {
  position: relative;
  flex: 0 0 44px;
  min-width: 44px;
  min-height: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity .14s ease, background .14s ease;
}
.fr-nav-hit.disabled { opacity: .28; pointer-events: none; }
.fr-nav-pressed { background: #D8EEE6; }
.fr-nav-status {
  position: relative;
  flex: 1 1 auto;
  box-sizing: border-box;
  min-width: 44px;
  padding: 0 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #507568;
  font-size: 12px;
  line-height: 1.5;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  text-align: center;
  overflow-wrap: anywhere;
}
.fr-nav-status text { min-width: 0; }
.fr-nav-loader {
  width: 16px;
  height: 16px;
  animation: frNavSpin .68s linear infinite;
}
@keyframes frNavSpin { to { transform: rotate(360deg); } }

.fr-bookmark-icon {
  width: 20px;
  height: 20px;
}

.fr-arrow {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

.fr-control-pressed { transform: scale(.97); opacity: .72; }

.fr-loading,
.fr-error {
  min-height: 0;
  flex: 1;
  padding: 62rpx 34rpx calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  overflow-y: auto;
}

.fr-loading-mark {
  width: 48px;
  height: 48px;
  margin-bottom: 28rpx;
}

.fr-state-title { color: #23483C; font-size: 34rpx; line-height: 1.35; font-weight: 600; }
.fr-state-desc { margin-top: 10rpx; color: #507568; font-size: 23rpx; line-height: 1.55; }

.fr-skeleton-card {
  width: 100%;
  max-width: 680rpx;
  margin-top: 36rpx;
  padding: 28rpx;
  border: 1rpx solid #D8EEE6;
  border-radius: 34rpx;
  background: #F3FBF8;
  box-shadow: 0 14rpx 34rpx rgba(43,117,91,.05);
}

.fr-skeleton-title,
.fr-skeleton-formula,
.fr-skeleton-line {
  border-radius: 999rpx;
  background: linear-gradient(90deg,#D8EEE6,#F6FCF9,#D8EEE6);
  animation: frPulse 1.2s ease-in-out infinite;
}
.fr-skeleton-title { width: 44%; height: 27rpx; }
.fr-skeleton-formula { width: 100%; height: 130rpx; margin-top: 24rpx; border-radius: 24rpx; }
.fr-skeleton-line { height: 20rpx; margin-top: 18rpx; }
.fr-skeleton-line.long { width: 92%; }
.fr-skeleton-line.medium { width: 68%; }

.fr-error { justify-content: center; }
.fr-error-mark {
  width: 44px;
  height: 44px;
  margin-bottom: 28rpx;
}

.fr-retry,
.fr-back-link {
  width: 100%;
  max-width: 520rpx;
  min-height: 84rpx;
  border-radius: 25rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.fr-retry { margin-top: 32rpx; background: #7ED8B5; color: #23483C; }
.fr-back-link { margin-top: 12rpx; background: #EAF9F4; color: #507568; }

@keyframes frPulse { 0%,100% { opacity: .52; } 50% { opacity: 1; } }

/* Keep native rich-text out of translated layers during card navigation. */
.fr-transition-stage {
  opacity: 1;
  transform: none !important;
  will-change: opacity;
  transition: opacity .16s ease;
}
.fr-slide-out-left,
.fr-slide-out-right,
.fr-slide-in-left,
.fr-slide-in-right { opacity: 0; }

@media (max-width: 360px) {
  .fr-nav-capsule { max-width: calc(100vw - 112rpx - 112px - 8px); }
}

@media (prefers-reduced-motion: reduce) {
  .fr-transition-stage,
  .fr-card-favorite,
  .fr-nav-capsule,
  .fr-nav-hit,
  .fr-nav-loader,
  .fr-skeleton-title,
  .fr-skeleton-formula,
  .fr-skeleton-line { transition: none !important; animation: none !important; will-change: auto; }
}
