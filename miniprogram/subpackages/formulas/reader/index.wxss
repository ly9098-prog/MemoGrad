@import '../../../styles/tokens.wxss';

page {
  height: 100%;
  background: #FAFCFB;
  color: #23483C;
  overflow: hidden;
}

button { box-sizing: border-box; }
button::after { border: none; }

.fr-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #FAFCFB;
}

.fr-card-scroll {
  min-height: 0;
  flex: 1;
  height: 100%;
}

.fr-card-wrap {
  min-height: 100%;
  padding: 22rpx 24rpx 0;
  box-sizing: border-box;
}

.fr-reader-meta {
  padding: 4rpx 2rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.fr-mode-switch { display: flex; flex-shrink: 0; gap: 4rpx; padding: 4rpx; border-radius: 20rpx; background: #EAF1EC; }
.fr-mode-tab { display: flex; align-items: center; justify-content: center; min-height: 44px; min-width: 52px; margin: 0; padding: 12rpx 16rpx; border: 0; border-radius: 16rpx; background: transparent; color: #4F6C5C; font-size: 14px; font-weight: 500; line-height: 1.5; }
.fr-mode-tab.is-active { background: #FFFFFF; color: #23483C; }
.fr-mode-tab[disabled] { opacity: .55; }
.fr-mode-pressed { opacity: .72; }
.fr-mode-tab:focus-visible { outline: 2px solid #3A6F5B; outline-offset: -2px; }
.fr-reader-actions { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.fr-random-context { flex-shrink: 0; color: #507568; font-size: 12px; }

.fr-index-pill {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: #23483C;
  font-size: 13px;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.fr-index-unit { color: #507568; font-size: 12px; font-weight: 400; }

.fr-card-favorite {
  position: relative;
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  border-radius: 10px;
  background: transparent;
  color: #507568;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .14s ease, color .14s ease;
}
.fr-card-favorite.active { color: #3A6F5B; background: #EAF9F4; }
.fr-card-favorite.disabled { opacity: .52; pointer-events: none; }
.fr-card-favorite:focus-visible, .fr-nav-hit:focus-visible { outline: 2px solid #3A6F5B; outline-offset: 2px; }

.fr-swipe-note {
  margin: 20rpx 10rpx 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #507568;
  font-size: max(24rpx, 12px);
  line-height: 1.6;
  text-align: center;
}
.fr-swipe-copy { display: flex; flex-direction: column; align-items: center; gap: 3rpx; flex-shrink: 0; }
.fr-swipe-sub { color: #507568; font-size: max(22rpx, 12px); }
.fr-swipe-line { flex: 1; height: 1rpx; background: #D8EEE6; }
.fr-bottom-space { height: calc(76px + env(safe-area-inset-bottom)); }

.fr-nav-capsule {
  position: fixed;
  left: 50%;
  bottom: calc(8px + env(safe-area-inset-bottom));
  z-index: 60;
  width: 176px;
  min-height: 52px;
  padding: 4px;
  border-radius: 28px;
  transform: translateX(-50%);
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr) 44px;
  gap: 8px;
  align-items: center;
  box-sizing: border-box;
  color: #3A6F5B;
  background: #EAF9F4;
}
.fr-nav-hit {
  min-width: 44px;
  min-height: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity .14s ease, background .14s ease;
}
.fr-nav-hit.disabled { opacity: .28; pointer-events: none; }
.fr-nav-pressed { background: #D8EEE6; }
.fr-nav-status {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #507568;
  font-size: 12px;
  line-height: 1.5;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}
.fr-nav-loader {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #D8EEE6;
  border-top-color: #3A6F5B;
  animation: frNavSpin .68s linear infinite;
}
@keyframes frNavSpin { to { transform: rotate(360deg); } }

.fr-bookmark-icon {
  position: relative;
  width: 24rpx;
  height: 30rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 5rpx 5rpx 0 0;
  box-sizing: border-box;
}

.fr-bookmark-icon::after {
  content: '';
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  bottom: -7rpx;
  height: 14rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg) skew(8deg,8deg);
  background: inherit;
}

.fr-arrow {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

.fr-arrow::before {
  content: '';
  position: absolute;
  top: 5rpx;
  width: 11rpx;
  height: 11rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  border-radius: 2rpx;
}

.fr-arrow-left::before { left: 7rpx; transform: rotate(-135deg); }
.fr-arrow-right::before { right: 7rpx; transform: rotate(45deg); }

.fr-control-pressed { transform: scale(.97); opacity: .72; }

.fr-loading,
.fr-error {
  min-height: 0;
  flex: 1;
  padding: 62rpx 34rpx calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  overflow-y: auto;
}

.fr-loading-mark {
  width: 228rpx;
  height: 130rpx;
  position: relative;
  margin-bottom: 28rpx;
}

.fr-loading-line {
  position: absolute;
  height: 5rpx;
  border-radius: 999rpx;
  transform-origin: left center;
  background: #3A6F5B;
}
.line-one { width: 68rpx; left: 18rpx; top: 91rpx; transform: rotate(-25deg); }
.line-two { width: 72rpx; left: 80rpx; top: 62rpx; transform: rotate(18deg); }
.line-three { width: 76rpx; left: 145rpx; top: 84rpx; transform: rotate(-31deg); background: #7ED8B5; }

.fr-loading-line::after {
  content: '';
  position: absolute;
  right: -9rpx;
  top: -7rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #F3FBF8;
  border: 5rpx solid currentColor;
  box-sizing: border-box;
}

.fr-state-title { color: #23483C; font-size: 34rpx; line-height: 1.35; font-weight: 600; }
.fr-state-desc { margin-top: 10rpx; color: #507568; font-size: 23rpx; line-height: 1.55; }

.fr-skeleton-card {
  width: 100%;
  max-width: 680rpx;
  margin-top: 36rpx;
  padding: 28rpx;
  border: 1rpx solid #D8EEE6;
  border-radius: 34rpx;
  background: #F3FBF8;
  box-shadow: 0 14rpx 34rpx rgba(43,117,91,.05);
}

.fr-skeleton-title,
.fr-skeleton-formula,
.fr-skeleton-line {
  border-radius: 999rpx;
  background: linear-gradient(90deg,#D8EEE6,#F6FCF9,#D8EEE6);
  animation: frPulse 1.2s ease-in-out infinite;
}
.fr-skeleton-title { width: 44%; height: 27rpx; }
.fr-skeleton-formula { width: 100%; height: 130rpx; margin-top: 24rpx; border-radius: 24rpx; }
.fr-skeleton-line { height: 20rpx; margin-top: 18rpx; }
.fr-skeleton-line.long { width: 92%; }
.fr-skeleton-line.medium { width: 68%; }

.fr-error { justify-content: center; }
.fr-error-mark {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 28rpx;
  border-radius: 32rpx;
  background: #F0DED8;
  color: #B55B48;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 600;
}

.fr-retry,
.fr-back-link {
  width: 100%;
  max-width: 520rpx;
  min-height: 84rpx;
  border-radius: 25rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.fr-retry { margin-top: 32rpx; background: #7ED8B5; color: #23483C; }
.fr-back-link { margin-top: 12rpx; background: #EAF9F4; color: #507568; }

@keyframes frPulse { 0%,100% { opacity: .52; } 50% { opacity: 1; } }

/* Keep native rich-text out of translated layers during card navigation. */
.fr-transition-stage {
  opacity: 1;
  transform: none !important;
  will-change: opacity;
  transition: opacity .16s ease;
}
.fr-slide-out-left,
.fr-slide-out-right,
.fr-slide-in-left,
.fr-slide-in-right { opacity: 0; }

@media (prefers-reduced-motion: reduce) {
  .fr-transition-stage,
  .fr-card-favorite,
  .fr-nav-hit,
  .fr-nav-loader,
  .fr-skeleton-title,
  .fr-skeleton-formula,
  .fr-skeleton-line { transition: none !important; animation: none !important; will-change: auto; }
}
