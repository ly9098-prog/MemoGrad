<app-dialog id="appDialog" theme="mint"></app-dialog>
<shared-card-transition id="readerSharedTransition" transition-key="{{sharedCardKey}}" />
<view class="fr-page">
  <premium-nav title="速记" variant="mint" bind:back="goBack" />

  <view class="fr-loading" wx:if="{{loading}}">
    <image class="fr-loading-mark" src="/assets/icons/mobile-controls/book-open.svg" mode="aspectFit" aria-hidden="true" />
    <text class="fr-state-title">正在整理速记内容</text>
    <text class="fr-state-desc">核心记忆、边界与易错点正在加载</text>
    <view class="fr-skeleton-card">
      <view class="fr-skeleton-title"></view>
      <view class="fr-skeleton-formula"></view>
      <view class="fr-skeleton-line long"></view>
      <view class="fr-skeleton-line medium"></view>
    </view>
  </view>

  <view class="fr-error" wx:elif="{{loadError}}">
    <image class="fr-error-mark" src="/assets/icons/mobile-controls/circle-exclamation-point.svg" mode="aspectFit" aria-hidden="true" />
    <text class="fr-state-title">暂时无法打开这张速记卡</text>
    <text class="fr-state-desc">{{errorText || '请检查网络后重新加载'}}</text>
    <button class="fr-retry" hover-class="fr-control-pressed" bindtap="retryLoad">重新加载</button>
    <button class="fr-back-link" hover-class="fr-control-pressed" bindtap="goBack">返回速记卡库</button>
  </view>

  <!-- 非加载、非错误但没有有效卡片 -->
  <view class="fr-error" wx:elif="{{!currentCard}}">
    <image class="fr-error-mark" src="/assets/icons/mobile-controls/book-open.svg" mode="aspectFit" aria-hidden="true" />
    <text class="fr-state-title">速记内容暂不可用</text>
    <text class="fr-state-desc">该速记卡可能存在格式问题或已被移除</text>
    <button class="fr-retry" hover-class="fr-control-pressed" bindtap="retryLoad">重新加载</button>
    <button class="fr-back-link" hover-class="fr-control-pressed" bindtap="goBack">返回速记卡库</button>
  </view>

  <scroll-view
    wx:else
    class="fr-card-scroll"
    scroll-y="{{!recitationMode || recitationNeedsScroll}}"
    enhanced
    show-scrollbar="{{false}}"
    scroll-top="{{readerScrollTop}}"
    bindscroll="onReaderScroll"
    bindtouchstart="onReaderTouchStart"
    bindtouchmove="onReaderTouchMove"
    bindtouchend="onReaderTouchEnd"
    bindtouchcancel="onReaderTouchCancel"
  >
    <view class="fr-card-wrap {{recitationMode ? 'is-recite' : ''}}">
      <view class="fr-transition-stage {{transitionClass}}">
        <view class="fr-reader-meta">
          <view class="fr-reading-context">
            <text class="fr-mode-label">{{recitationMode ? '背诵' : '浏览'}}</text>
            <text class="fr-random-context" wx:if="{{isRandom}}">随机顺序</text>
          </view>
          <view class="fr-reader-actions">
            <view wx:if="{{!guestMode}}"
              class="fr-card-favorite {{currentCard.isFavorited ? 'active' : ''}} {{favoriteBusy ? 'disabled' : ''}}"
              data-id="{{currentCard.id}}"
              hover-class="fr-control-pressed"
              bindtap="toggleFavorite"
              role="button"
              aria-label="{{currentCard.isFavorited ? '取消收藏' : '收藏公式'}}"
              aria-pressed="{{currentCard.isFavorited}}"
              aria-disabled="{{favoriteBusy}}"
            >
              <image class="fr-bookmark-icon" src="/assets/icons/mobile-controls/{{currentCard.isFavorited ? 'bookmark-check' : 'bookmark'}}.svg" mode="aspectFit" aria-hidden="true" />
            </view>
            <view wx:else class="fr-card-favorite is-locked" aria-disabled="true">
              <image class="fr-bookmark-icon" src="/assets/icons/mobile-controls/lock.svg" mode="aspectFit" aria-hidden="true" />
            </view>
          </view>
        </view>

        <formula-card
          id="readerFormulaCard"
          card="{{currentCard}}"
          recitationMode="{{recitationMode}}"
          readingHeight="{{recitationHeight}}"
          graphImageUrl="{{currentCard.graphImageUrl}}"
          graphThumbnailUrl="{{currentCard.graphThumbnailUrl}}"
          bind:readingchange="onFormulaReadingChange"
          bind:formulastart="onFormulaGestureStart"
          bind:formulaend="onFormulaGestureEnd"
        />
      </view>
    </view>
  </scroll-view>
</view>
